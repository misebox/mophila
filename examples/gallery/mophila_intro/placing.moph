# placing.moph — 時間 3: Composition に in と out を指定して置く。入れ子、繰り返し、音と字幕も同じ軸

import { W, H, ink, dim, accent, blue, green, line, review, dwell, longer } from .theme
import { text, heading, card, loop_func, scene, add, say, close } from .slides

export func run(now) {
  log("placing", now)
  let sc = scene()
  add(sc, [heading("時刻を指定して、置く")], now)
  add(sc, card([
    "# 人を出る時刻をずらして置く。渡り切ったらまた置く",
    "for (p, start) in people {",
    "  comp.place(\"walk-a\", p, in = start, out = start + 18s)",
    "  comp.place(\"walk-b\", p, in = start + 18s, out = ...)",
    "}",
    "# 音楽と読み上げも同じ Composition",
    "comp.place(\"bgm\", bgm.copy(volume = 0.6, loop = true),",
    "           in = 0s, out = 30s)",
    "comp.place(\"line\", Narration(text = \"…\"),",
    "           in = 12s, out = 17s)",
  ], 0.7, 1.8, 7.6, 0.28), now + 0.4s)
  # 右: 時間軸に並んだ帯。再生位置の線が渡る
  let x0 = 9.6
  let lane_w = 5.6
  let lanes = [("人 1", blue, 0.0, 2.2), ("人 2", blue, 1.0, 2.2), ("人 3", blue, 2.6, 2.2), ("音", green, 0, 5.6), ("字幕", accent, 1.3, 1.6)]
  let objs = []
  for (i, l) in lanes.enumerate() {
    let (name, color, from, len) = l
    let y = 2.3 + i * 0.95
    objs.push(text(name, x0 - 0.4, y, 0.3, dim, :right))
    objs.push(Rect(position = Vector(x0 + from, y - 0.25), anchor = Vector(0, 0), w = len, h = 0.5, radius = 0.1, fill = color))
    if i == 4 {
      objs.push(Rect(position = Vector(x0 + 3.6, y - 0.25), anchor = Vector(0, 0), w = 1.4, h = 0.5, radius = 0.1, fill = color))
    }
  }
  let t1 = now + 0.5s
  add(sc, objs, t1)
  let t = say(sc, "動きは、Composition に in と out を指定して置きます。", t1)
  t = say(sc, "置いた時刻から、その動きが始まります。同じものを何度でも置けます。", t)
  t = say(sc, "音楽と字幕も、同じ Composition に置きます。", t)
  t = say(sc, "この動画の音楽と字幕も、そう書いてあります。", t)
  let end = t + review
  # 再生位置の線。6 秒で右へ渡り、また左から
  let sweep = func (t) {
    let x = ease(t, 0s, 6s, x0, x0 + lane_w)
    Line(from = Vector(x, 1.9), to = Vector(x, 6.4), stroke = ink, strokeWidth = 0.05)
  }
  loop_func(sweep, t1, 6s, end)
  close(sc, end)
}
