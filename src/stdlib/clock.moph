# clock.moph — 時計と日付の絵
#
# 時刻は 0 時からの Duration で受け取る。日付を持つ型は無いので、日付は文字と数で渡す。
# どれも静的な Group を返す。針を動かすのは、呼ぶ側の func (t) が時刻を渡す。
#
#   func face(t) { analog(10h8m + t, 3, 3).copy(position = Vector(1, 1)) }
#   comp.place("clock", face, in = 0s, out = 4s)

import math
import { gray, alpha, contrast } from color
import shape
import text
import { text_at } from diagram

## 針の時計
## @category 時計
## @param time 0 時からの長さ
## @param w 幅
## @param h 高さ
## @param face 文字盤の色 (既定 白)
## @param hand 針の色 (既定 ほぼ黒)
## @param second 秒針の色 (既定 赤)
## @returns Group。左上が (0, 0) で w x h
## @example
## comp.place("clock", analog(10h8m, 3, 3).copy(position = Vector(1, 1)), in = 0s, out = comp.duration)
export func analog(time: Duration, w: Number, h: Number, face: Color = #ffffff, hand: Color = #1a1d23, second: Color = #e04040) -> Group {
  let cx = w / 2
  let cy = h / 2
  let r = math.min(w, h) / 2
  let items = [Circle(position = Vector(cx, cy), radius = r, fill = face, stroke = alpha(hand, 0.25), strokeWidth = r * 0.03)]
  for i in 0..12 {
    let outer = shape.polar(cx, cy, r * 0.92, i * math.tau / 12)
    let inner = shape.polar(cx, cy, r * (if i % 3 == 0 { 0.78 } else { 0.85 }), i * math.tau / 12)
    items.push(Line(from = inner, to = outer, stroke = alpha(hand, 0.7), strokeWidth = r * (if i % 3 == 0 { 0.05 } else { 0.025 })))
  }
  let secs = time / 1s
  let hours = (secs / 3600) % 12
  let minutes = (secs / 60) % 60
  items.push(Line(from = Vector(cx, cy), to = shape.polar(cx, cy, r * 0.5, hours * math.tau / 12), stroke = hand, strokeWidth = r * 0.07, strokeCap = :round))
  items.push(Line(from = Vector(cx, cy), to = shape.polar(cx, cy, r * 0.72, minutes * math.tau / 60), stroke = hand, strokeWidth = r * 0.05, strokeCap = :round))
  items.push(Line(from = shape.polar(cx, cy, r * 0.18, (secs % 60) * math.tau / 60 + math.pi), to = shape.polar(cx, cy, r * 0.8, (secs % 60) * math.tau / 60), stroke = second, strokeWidth = r * 0.02, strokeCap = :round))
  items.push(Circle(position = Vector(cx, cy), radius = r * 0.05, fill = hand))
  Group(...items)
}

## 数字の時計
## @category 時計
## @param time 0 時からの長さ
## @param w 幅
## @param h 高さ
## @param format text.duration の書き方 (既定 "hh:mm")
## @param back 背の色 (既定 ほぼ黒)
## @param ink 数字の色 (既定 薄い緑)
## @returns Group。左上が (0, 0) で w x h
## @example
## comp.place("digital", digital(10h8m, 3, 1.2).copy(position = Vector(1, 1)), in = 0s, out = comp.duration)
export func digital(time: Duration, w: Number, h: Number, format: String = "hh:mm", back: Color = #14161a, ink: Color = #9fe0a0) -> Group {
  Group(
    Rect(anchor = Vector(0, 0), w = w, h = h, radius = h * 0.12, fill = back),
    TextArea(position = Vector(w / 2, h / 2), text = text.clock_text(time, format), fontSize = h * 0.5, fill = ink, align = :center)
  )
}

## 残り時間。輪が減っていく
## @category 時計
## @param remaining 残り
## @param total 全体
## @param w 幅
## @param h 高さ
## @param format text.duration の書き方 (既定 "mm:ss")
## @param color 残りの色 (既定 赤)
## @param track 減った分の色 (既定 薄い灰)
## @returns Group。左上が (0, 0) で w x h
## @example
## comp.place("countdown", countdown(25s, 60s, 2, 2).copy(position = Vector(1, 1)), in = 0s, out = comp.duration)
export func countdown(remaining: Duration, total: Duration, w: Number, h: Number, format: String = "mm:ss", color: Color = #e04040, track: Color = #e6e2da) -> Group {
  let cx = w / 2
  let cy = h / 2
  let r_out = math.min(w, h) / 2
  let r_in = r_out * 0.86
  let k = if total / 1s == 0 { 0 } else { math.clamp(remaining / total, 0, 1) }
  let items = [Polygon(points = shape.ring_segment(cx, cy, r_in, r_out, 0, math.tau, 48), fill = track)]
  if k > 0 {
    items.push(Polygon(points = shape.ring_segment(cx, cy, r_in, r_out, 0, math.tau * k, 48), fill = color))
  }
  items.push(TextArea(position = Vector(cx, cy), text = text.clock_text(remaining, format), fontSize = r_out * 0.42, fill = #1a1d23, align = :center))
  Group(...items)
}

## 経過時間。秒針代わりの点が回る
## @category 時計
## @param elapsed 経過
## @param w 幅
## @param h 高さ
## @param format text.duration の書き方 (既定 "mm:ss.S")
## @param color 点と文字の色 (既定 ほぼ黒)
## @param track 輪の色 (既定 薄い灰)
## @returns Group。左上が (0, 0) で w x h
## @example
## comp.place("stopwatch", stopwatch(83.4s, 2, 2).copy(position = Vector(1, 1)), in = 0s, out = comp.duration)
export func stopwatch(elapsed: Duration, w: Number, h: Number, format: String = "mm:ss.S", color: Color = #1a1d23, track: Color = #e6e2da) -> Group {
  let cx = w / 2
  let cy = h / 2
  let r = math.min(w, h) / 2
  Group(
    Circle(position = Vector(cx, cy), radius = r * 0.94, stroke = track, strokeWidth = r * 0.08),
    Circle(position = shape.polar(cx, cy, r * 0.94, (elapsed / 1s % 60) * math.tau / 60), radius = r * 0.08, fill = color),
    TextArea(position = Vector(cx, cy), text = text.clock_text(elapsed, format), fontSize = r * 0.4, fill = color, align = :center)
  )
}

## カレンダーの 1 枚
## @category 日付
## @param month 上に出す月の文字
## @param day 日
## @param weekday 下に出す曜日の文字 (空なら出さない)
## @param w 幅
## @param h 高さ
## @param accent 上の帯の色 (既定 赤)
## @param face 紙の色 (既定 白)
## @returns Group。左上が (0, 0) で w x h
## @example
## comp.place("calendar", calendar_page("9月", 16, "火", 2.4, 2.6).copy(position = Vector(1, 1)), in = 0s, out = comp.duration)
export func calendar_page(month: String, day: Number, weekday: String, w: Number, h: Number, accent: Color = #e04040, face: Color = #ffffff) -> Group {
  let head = h * 0.26
  let has_week = weekday != ""
  let day_y = if has_week { h * 0.58 } else { h * 0.64 }
  let items = [
    Rect(anchor = Vector(0, 0), w = w, h = h, radius = w * 0.06, fill = face),
    Rect(anchor = Vector(0, 0), w = w, h = head, radius = w * 0.06, fill = accent),
    Rect(position = Vector(0, head * 0.6), anchor = Vector(0, 0), w = w, h = head * 0.4, fill = accent),
    TextArea(position = Vector(w / 2, head / 2), text = month, fontSize = head * 0.55, fill = contrast(accent), align = :center),
    TextArea(position = Vector(w / 2, day_y), text = "{}".format(math.floor(day)), fontSize = h * 0.42, fill = gray(35), align = :center),
  ]
  if has_week {
    items.push(text_at(TextArea(text = weekday, fontSize = h * 0.12, fill = gray(120), align = :center), w / 2, h * 0.86, 0.5, 1))
  }
  Group(...items)
}

## 再生バー。印の付いた所が章の切れ目
## @category 帯
## @param markers 印を付ける位置 (0..1)
## @param position 今の位置 (0..1)
## @param w 幅
## @param h 高さ
## @param color 進んだ分の色 (既定 赤)
## @param track 残りの色 (既定 薄い灰)
## @returns Group。左上が (0, 0) で w x h
## @example
## comp.place("timeline", timeline_bar([0.25, 0.6], 0.4, 8, 0.4).copy(position = Vector(1, 1)), in = 0s, out = comp.duration)
export func timeline_bar(markers: List<Number>, position: Number, w: Number, h: Number, color: Color = #e04040, track: Color = #e6e2da) -> Group {
  let k = math.clamp(position, 0, 1)
  let bar = h * 0.34
  let cy = h / 2
  let items = [Rect(position = Vector(0, cy - bar / 2), anchor = Vector(0, 0), w = w, h = bar, radius = bar / 2, fill = track)]
  if k > 0 {
    items.push(Rect(position = Vector(0, cy - bar / 2), anchor = Vector(0, 0), w = w * k, h = bar, radius = bar / 2, fill = color))
  }
  for m in markers {
    items.push(Rect(position = Vector(w * math.clamp(m, 0, 1), cy), w = bar * 0.28, h = bar * 1.6, fill = gray(120)))
  }
  items.push(Circle(position = Vector(w * k, cy), radius = h * 0.32, fill = color))
  Group(...items)
}
