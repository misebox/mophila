# tools.moph — LLM を使って書く 2: 文法も書き方も、機械が読める形で置いてある

import { W, H, v, track, ink, dim, accent, blue, green, panel, line, review, dwell, longer } from .theme
import { place, text, heading, card, scene, add, say, close } from .slides

func pillar(title, lines, cx, color, at, sc) {
  let objs = [place(Rect(position = Pos(cx - 2.3, 2.0, anchor = :topLeft), w = 4.6, h = 4.6, radius = 0.2, fill = panel, stroke = color, strokeWidth = 0.05, opacity = 0)),
              text(title, cx, 2.7, 0.5, color, :center)]
  for (i, s) in lines.enumerate() {
    objs.push(place(TextArea(text = s, position = Pos(cx - 2.0, 3.4 + i * 0.62, anchor = :topLeft), w = 4.0, fontSize = 0.3, fill = ink, align = :left, opacity = 0)))
  }
  add(sc, objs, at)
}

export func run(now) {
  log("tools", now)
  let sc = scene()
  add(sc, [heading("言語のことは、機械が知っている")], now)
  let t = say(sc, "文法も書き方も、機械が読める形で置いてあります。", now + 0.5s)
  let t1 = t
  pillar("文法 (GBNF)", ["言語の文法を、そのまま", "LLM に渡せる形で置いてある", "", "docs/mophila.gbnf"], 3.3, accent, t1, sc)
  t = say(sc, "文法は GBNF で書いてあり、そのまま LLM に渡せます。", t1)
  let t2 = t
  pillar("LSP", ["書きながら、間違いが", "その場で分かる", "補完、定義へ移動、名前の変更", "VS Code / Neovim"], 8.0, blue, t2, sc)
  t = say(sc, "LSP があるので、書きながら間違いが分かります。", t2)
  let t3 = t
  pillar("skill", ["この言語の書き方を", "まとめてある", "型、時間、確認のしかた", "docs/skills/mophila/"], 12.7, green, t3, sc)
  t = say(sc, "skill には、この言語の書き方がまとめてあります。", t3)
  t = say(sc, "Claude Code のようなエディタで、そのまま使えます。", t)
  close(sc, t + review)
}
