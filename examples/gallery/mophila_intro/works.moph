# works.moph — 作れるもの。サンプルの動画を 1 つずつ全画面で出す

import { W, H, dim, pause } from .theme
import { demo, scene, say, close, text, show } from .slides
import ..crowd
import ..mandelbrot
import ..fractal
import ..walker
import ..orbit
import ..bars
import ..clock
import ..bounce

export func run(now) {
  log("works", now)
  let sc = scene()
  let t = say(sc, "これらは、すべてこの言語のスクリプトです。", now + 0.5s)
  # Mandelbrot は 40 秒目 (うずまきの所) から見せる。中の Layer を 40 秒前に置くと、その分進んだ所から始まる
  let deep = Composition(box = Vector(16, 9), duration = 7s)
  deep.place("mandelbrot", mandelbrot.output, in = -40s, out = 7s)
  # 1 つずつ、少し重ねながら
  let items = [(crowd.output, 0s, 7s), (deep, 6s, 7s), (fractal.output, 12s, 7s), (walker.output, 18s, 6s)]
  let at = now
  for (sub, from, len) in items {
    demo(sub, 0, 0, 16, at + from, at + from + len)
  }
  t = say(sc, "図形の動画も、フラクタルも、歩く人も。", at + 8s)
  t = say(sc, "どれも短いファイルです。", at + 19s)
  # 最後に 2x2
  let grid = [(orbit.output, 0.55, 0.2), (bars.output, 8.25, 0.2), (clock.output, 0.55, 4.4), (bounce.output, 8.25, 4.4)]
  let g0 = at + 24s
  let end = g0 + 12s
  for (sub, x, y) in grid {
    demo(sub, x, y, 7.2, g0, end)
  }
  t = say(sc, "軌道、グラフ、時計、跳ねるボールも同じです。", g0 + 0.5s)
  close(sc, end)
}
