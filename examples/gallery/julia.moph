# julia.moph — Julia 集合。定数 c を円周上でゆっくり動かすと、形が移り変わる

import math
import { escape_time, julia, smooth_bands } from fractal

let total = 40s

let stops = [#061a3f, #1c4f9c, #5c9be6, #cfe6ff, #ffffff, #cfe6ff, #5c9be6, #1c4f9c, #061a3f]

let set = escape_time(
  # c = 0.7885 e^(iθ)。θ は π から始めて 40 秒で 1 周 (最初はつながった形)
  formula = julia(func (t) { Vector(0.7885 * math.cos(math.pi + t / 40 * math.tau), 0.7885 * math.sin(math.pi + t / 40 * math.tau)) }),
  coloring = smooth_bands(stops, 48, inside = #061a3f),
  center = Vector(0, 0),
  span = 3.6,
  max_steps = func (depth) { 300 },
  samples = 4,
)

let comp = Composition(box = Vector(16, 9), duration = total)
comp.place("set", Rect(position = Vector(0, 0), anchor = Vector(0, 0), w = 16, h = 9, fill = set), in = 0s, out = total)

output comp
