# bell.moph — ベル

import { arc } from shape

# 裾から立ち上がって、頭は半円で回る
let body = [Vector(0.08, 0.8), Vector(0.19, 0.68)]
for p in arc(0.5, 0.46, 0.31, -90, 90, 14) {
  body.push(p)
}
body.push(Vector(0.81, 0.68))
body.push(Vector(0.92, 0.8))

## ベル。知らせや、気付いてほしいことに
## @category もの
## @type {List<List<Vector>>} 0..1 の箱に収めた輪郭の並び
export let BELL = [body, arc(0.5, 0.9, 0.1, 0, 360, 14)]
