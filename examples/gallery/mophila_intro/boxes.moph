# boxes.moph — 組み合わせ 1: 座標は箱の中の値。大きさは出力のときに決まる

import math
import { W, H, ink, dim, accent, blue, review, dwell } from .theme
import { text, heading, card, outline, demo, scene, add, say, close } from .slides

# 同じ絵の箱を作る。Composition は不変なので、何度でも置ける
func picture(life) {
  let b = Composition(box = Vector(4, 3), duration = life)
  b.place("bg", Rect(position = Vector(0, 0), anchor = Vector(0, 0), w = 4, h = 3, fill = #1b2130), in = 0s, out = life)
  b.place("sway", func (t) {
    let s = 0.3 * math.sin(math.tau * t / 3s)
    Group(
      Circle(position = Vector(1.4, 1.5 + s), radius = 0.8, fill = accent),
      Rect(position = Vector(3.0, 1.5 - s), w = 1.0, h = 1.6, radius = 0.2, fill = blue),
    )
  }, in = 0s, out = life)
  b
}

export func run(now) {
  log("boxes", now)
  let sc = scene()
  add(sc, [heading("座標は、箱の中の値")], now)
  add(sc, card([
    "let comp = Composition(box = Vector(4, 3),",
    "                       duration = 6s)",
    "comp.place(\"dot\", Circle(",
    "  position = Vector(1.4, 1.5), radius = 0.8,",
    "), in = 0s, out = 6s)",
    "comp.place(\"bar\", Rect(",
    "  position = Vector(3.0, 1.5), w = 1, h = 1.6,",
    "), in = 0s, out = 6s)",
    "output comp",
    "",
    "$ mophila render a.moph --size fhd",
    "$ mophila render a.moph --size vga",
  ], 0.7, 1.8, 7.6, 0.28), now + 0.4s)
  let t1 = now + 0.5s
  let fx = 8.9
  let fy = 2.6
  let fw = 4.0
  let fh = fw * 9 / 16
  add(sc, [outline(fx, fy, fw, fh), text("--size fhd (16:9)", fx + fw / 2, fy + fh + 0.35, 0.27, dim, :center)], t1)
  let t = say(sc, "座標は、箱の中の値で書きます。この箱は横 4、縦 3 です。", t1)
  t = say(sc, "ピクセルの数は、どこにも書きません。", t)
  let t2 = t
  let gx = fx + fw + 0.4
  let gw = 2.6
  let gh = gw * 3 / 4
  add(sc, [outline(gx, fy, gw, gh), text("--size vga (4:3)", gx + gw / 2, fy + gh + 0.35, 0.27, dim, :center)], t2)
  t = say(sc, "16:9 で書き出すと余白が付き、4:3 ならぴったり収まります。", t2)
  t = say(sc, "大きさは、出力するときにコマンドが決めます。", t)
  let end = t + 1s
  demo(picture(end - t1), fx + (fw - fh * 4 / 3) / 2, fy, fh * 4 / 3, t1, end)
  demo(picture(end - t2), gx, fy, gw, t2, end)
  close(sc, end)
}
