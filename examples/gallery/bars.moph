# bars.moph — 棒グラフが順に伸び、値のラベルが後から現れる

import color

let len = 7s
let comp = Composition(box = Vector(16, 9), duration = len)
comp.place("bg", Rect(position = Vector(0, 0), anchor = Vector(0, 0), w = 16, h = 9, fill = #f7f7f2), in = 0s, out = len)

func title(t) {
  TextArea(text = "Monthly visitors", position = Vector(1, 0.6), anchor = Vector(0, 0), fontSize = 0.7, fill = #202020, opacity = linear(t, 0s, 0.6s, 0, 1))
}
comp.place("title", title, in = 0s, out = len)

# 目盛りの線。棒の高さが読めるように、薄く 4 本
let ticks = []
for i in 1..5 {
  let y = 7.5 - 5 * i / 5
  ticks.push(Line(from = Vector(1.5, y), to = Vector(15, y), stroke = #e0ded6, strokeWidth = 0.02))
}
comp.place("ticks", Group(...ticks), in = 0s, out = len)

# 軸
func axes(t) {
  Group(
    Line(from = Vector(1.5, 7.5), to = Vector(15, 7.5), stroke = #808080, strokeWidth = 0.03),
    Line(from = Vector(1.5, 2), to = Vector(1.5, 7.5), stroke = #808080, strokeWidth = 0.03),
    opacity = linear(t, 0s, 0.5s, 0, 1),
  )
}
comp.place("axes", axes, in = 0.4s, out = len)

let data = [
  { "label": "Jan", "value": 32, "color": #4080e0 },
  { "label": "Feb", "value": 48, "color": #4080e0 },
  { "label": "Mar", "value": 41, "color": #4080e0 },
  { "label": "Apr", "value": 65, "color": #40a060 },
  { "label": "May", "value": 80, "color": #40a060 },
  { "label": "Jun", "value": 74, "color": #e0a020 },
]
let max = 100
let chart_h = 5
let bar_w = 1.4
let gap = 0.8
let grow_time = 1.5s

# 棒は下端を固定 (anchor を下端に置く) して h だけ伸ばす。
# 最大の棒は伸び切ってから色を変えて強調する。値のラベルは伸び切ってから現れる
func column(x, d, start) {
  let h = chart_h * d["value"] / max
  let highlight = d["value"] == 80
  let recolor_at = 6.2s - start
  func (t) {
    let grown = ease_out(t, 0s, grow_time, 0.01, h)
    let fill = if highlight { color.mix(d["color"], #e04040, ease(t, recolor_at, recolor_at + 0.8s, 0, 1)) } else { d["color"] }
    let value = TextArea(text = "{v}".format(d["value"]), fontSize = 0.4, fill = #202020, align = :center, opacity = linear(t, grow_time, grow_time + 0.4s, 0, 1))
    Group(
      Rect(position = Vector(x + bar_w / 2, 7.5), anchor = Vector(bar_w / 2, grown), w = bar_w, h = grown, fill = fill),
      value.copy(position = Vector(x + bar_w / 2, 7.5 - h - 0.15), anchor = Vector(value.size().x / 2, value.size().y)),
    )
  }
}

# 月の名前は最初から見えている
let names = []
for (i, d) in data.enumerate() {
  let x = 2.2 + i * (bar_w + gap)
  let name = TextArea(text = d["label"], fontSize = 0.4, fill = #404040, align = :center)
  names.push(name.copy(position = Vector(x + bar_w / 2, 7.7), anchor = Vector(name.size().x / 2, 0)))
}
comp.place("names", Group(...names), in = 0s, out = len)

for (i, d) in data.enumerate() {
  let start = 1s + i * 0.6s
  comp.place("bar-{i}".format(i), column(2.2 + i * (bar_w + gap), d, start), in = start, out = len)
}

output comp
