# palette.moph — 配色の型。どの色がどの役目か

## 1 つの配色。どの色をどこに使うかを決めた組。
## 画面の色をここから取ると、部品をどう組み合わせても全体が揃う
## @category 型
## @param back 背景
## @param ink 本文の文字
## @param sub 弱い文字。説明や補足
## @param line 罫線と輪郭
## @param accent 目を引かせたい所
## @param track 目盛りや進捗の下地
## @param series グラフの系列色。5 色
## @example
## import palette
## let p = palette.NIGHT
## comp.place("bg", Rect(w = 16, h = 9, fill = p.back, position = Vector(0, 0), anchor = Vector(0, 0)), in = 0s, out = comp.duration)
## comp.place("title", TextArea(text = "売上", fontSize = 0.8, fill = p.ink, position = Vector(1, 1)), in = 0s, out = comp.duration)
##
## # 1 色だけ変える
## let mine = palette.NIGHT.copy(accent = #4aa863)
export record Palette {
  back: Color
  ink: Color
  sub: Color
  line: Color
  accent: Color
  track: Color
  series: List<Color>
}
