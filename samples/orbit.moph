# orbit.moph — 太陽系。惑星が異なる半径・周期で公転し、月が地球を回る

import math

let v = View(box = (16, 9))
v.place(Rect(position = Pos(0, 0, anchor = :topLeft), w = 16, h = 9, fill = #101020))

let cx = 8
let cy = 4.5

# 太陽。脈動は 3 つのキーフレーム
let sun = Circle(position = Pos(cx, cy), radius = 0.9, fill = #f0c040)
v.place(sun)
let pulse = context sun as s {
  motion (t) {
    0:   s.radius = 0.9
    0.5: s.radius = 1.05 :ease
    1:   s.radius = 0.9  :ease
  }
}
pulse.duration = 4s

# 円軌道。0..1 の区間で式を毎フレーム評価するので、t が 0→1 で 1 周する。period で速さを決める
func orbit(body, r, period) {
  let tl = context body as b {
    motion (t) {
      0..1: b.position = Pos(cx + r * math.cos(math.TAU * t), cy + r * math.sin(math.TAU * t))
    }
  }
  tl.duration = period
  tl
}

let planets = [
  { "r": 1.6, "size": 0.16, "period": 3s,  "color": #c0c0c0 },
  { "r": 2.5, "size": 0.26, "period": 5s,  "color": #e0a060 },
  { "r": 3.4, "size": 0.28, "period": 8s,  "color": #4080e0 },
  { "r": 4.2, "size": 0.20, "period": 12s, "color": #e05040 },
]

# 軌道の線 (fill なし、stroke だけの Circle)
for p in planets {
  v.place(Circle(position = Pos(cx, cy), radius = p["r"], stroke = #303050, strokeWidth = 0.02))
}

let total = 15s
let track = Timeline(duration = total)
for i in 0..4 {
  track.place(pulse, at = i * 4s)
}

for p in planets {
  let body = Circle(position = Pos(cx + p["r"], cy), radius = p["size"], fill = p["color"])
  v.place(body)
  # 公転を total の間繰り返す
  let tl = orbit(body, p["r"], p["period"])
  let n = total / p["period"]
  for i in 0..math.ceil(n) {
    track.place(tl, at = i * p["period"])
  }
}

# 地球 (r = 3.4, 8 秒で 1 周) の月。地球の位置に、6 倍速の小さな円運動を足す
let moon = Circle(position = Pos(cx + 3.4 + 0.5, cy), radius = 0.08, fill = #d0d0d0)
v.place(moon)
let moon_tl = context moon as m {
  motion (t) {
    0..1: m.position = Pos(cx + 3.4 * math.cos(math.TAU * t) + 0.5 * math.cos(math.TAU * t * 6), cy + 3.4 * math.sin(math.TAU * t) + 0.5 * math.sin(math.TAU * t * 6))
  }
}
moon_tl.duration = 8s
track.place(moon_tl, at = 0s)
track.place(moon_tl, at = 8s)
track.place(moon_tl, at = 16s)

let title = TextArea(text = "orbit", position = Pos(0.4, 0.3, anchor = :topLeft), fontSize = 0.6, fill = #e0e0f0)
v.place(title)
track.place(context title as o {
  motion (t) {
    0s:   o.opacity = 0
    1.5s: o.opacity = 1 :fade
  }
}, at = 0s)

v.addTrack(track)
output v
