# orbit.moph — 太陽系。惑星が異なる半径・周期で公転し、月が地球を回る

import math

let total = 15s
let cx = 8
let cy = 4.5

let comp = Composition(box = Vector(16, 9), duration = total)
comp.place("bg", Rect(position = Vector(0, 0), anchor = Vector(0, 0), w = 16, h = 9, fill = #101020), in = 0s, out = total)

let planets = [
  { "r": 1.6, "size": 0.16, "period": 3s,  "color": #c0c0c0 },
  { "r": 2.5, "size": 0.26, "period": 5s,  "color": #e0a060 },
  { "r": 3.4, "size": 0.28, "period": 8s,  "color": #4080e0 },
  { "r": 4.2, "size": 0.20, "period": 12s, "color": #e05040 },
]

# 軌道の線 (fill なし、stroke だけの Circle)
let rings = []
for p in planets {
  rings.push(Circle(position = Vector(cx, cy), radius = p["r"], stroke = #303050, strokeWidth = 0.02))
}
comp.place("rings", Group(...rings), in = 0s, out = total)

# 太陽。脈動は 4 秒ごとにくり返す 3 つのキーフレーム
let pulse = progress [:radius] {
  0:   0.9
  0.5: 1.05 :ease
  1:   0.9  :ease
}

func sun(t) {
  Circle(position = Vector(cx, cy), radius = pulse((t / 4s) % 1)[0], fill = #f0c040)
}
comp.place("sun", sun, in = 0s, out = total)

# 円軌道。period で 1 周する速さを決める
func orbit_at(t, r, period) {
  let a = math.tau * (t / period)
  Vector(cx + r * math.cos(a), cy + r * math.sin(a))
}

func planet(r, size, period, color) {
  func (t) { Circle(position = orbit_at(t, r, period), radius = size, fill = color) }
}

for (i, p) in planets.enumerate() {
  comp.place("planet-{i}".format(i), planet(p["r"], p["size"], p["period"], p["color"]), in = 0s, out = total)
}

# 地球 (r = 3.4, 8 秒で 1 周) の月。地球の位置に、6 倍速の小さな円運動を足す
func moon(t) {
  let a = math.tau * (t / 8s)
  Circle(position = Vector(cx + 3.4 * math.cos(a) + 0.5 * math.cos(a * 6), cy + 3.4 * math.sin(a) + 0.5 * math.sin(a * 6)), radius = 0.08, fill = #d0d0d0)
}
comp.place("moon", moon, in = 0s, out = total)

func title(t) {
  TextArea(text = "orbit", position = Vector(0.4, 0.3), anchor = Vector(0, 0), fontSize = 0.6, fill = #e0e0f0, opacity = ease(t, 0s, 1.5s, 0, 1))
}
comp.place("title", title, in = 0s, out = total)

output comp
