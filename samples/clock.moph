# clock.moph — アナログ時計。16 秒で秒針が 2 周し、分針と時針もわずかに進む

import math

let v = new View { box: (16, 9) }
v.place(new Rect { position: apos!(:topLeft, 0, 0), w: 16, h: 9, fill: #e8e4d8 })

# 文字盤
v.place(new Circle { position: apos!(:center, 8, 4.5), radius: 4, fill: #fffdf5, stroke: #303030, strokeWidth: 0.08 })

# 目盛り。12 個の太い線と 48 個の細い線
for i in 0..60 {
  let a = 6.2832 * i / 60
  let outer = 3.8
  let inner = if i % 5 == 0 { 3.3 } else { 3.6 }
  let w = if i % 5 == 0 { 0.08 } else { 0.03 }
  v.place(new Line {
    from: (8 + inner * math.sin(a), 4.5 - inner * math.cos(a)),
    to:   (8 + outer * math.sin(a), 4.5 - outer * math.cos(a)),
    stroke: #303030, strokeWidth: w,
  })
}

# 数字
for (i, n) in ["12", "3", "6", "9"].enumerate() {
  let a = 6.2832 * i / 4
  v.place(new TextArea { text: n, position: apos!(:center, 8 + 2.8 * math.sin(a), 4.5 - 2.8 * math.cos(a)), fontSize: 0.55, fill: #303030, align: :center })
}

# 針。秒針は 8 秒で 1 周、分針は 480 秒、時針は 28800 秒で 1 周する (実時間の 7.5 倍速)
let hour   = new Line { from: (8, 4.5), to: (8, 2.5), stroke: #303030, strokeWidth: 0.16 }
let minute = new Line { from: (8, 4.5), to: (8, 1.2), stroke: #303030, strokeWidth: 0.1 }
let second = new Line { from: (8, 4.5), to: (8, 1.0), stroke: #d03030, strokeWidth: 0.04 }
v.place(hour)
v.place(minute)
v.place(second)
v.place(new Circle { position: apos!(:center, 8, 4.5), radius: 0.15, fill: #d03030 })

# 針は 0..1 の区間で式を毎フレーム評価する。t が 0→1 の 16 秒間に、秒針は 2 周、分針は 2/60 周、時針は 2/720 周
func turn(hand, length, turns) {
  context hand as h {
    motion (t) {
      0..1: h.to = (8 + length * math.sin(math.TAU * t * turns), 4.5 - length * math.cos(math.TAU * t * turns))
    }
  }
}
let total = 16s
let track = new Timeline { duration: total }
for (hand, length, turns) in [(second, 3.5, 2), (minute, 3.3, 2/60), (hour, 2.0, 2/720)] {
  let tl = turn(hand, length, turns)
  tl.duration = total
  track.place(tl, at: 0s)
}
v.addTrack(track)

output v
