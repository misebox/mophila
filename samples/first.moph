# first.moph — 最初の 1 本。丸が右へ動き、四角が横に広がり、文字が現れる。4 秒

let v = new View { box: (16, 9) }
v.place(new Rect { position: apos!(:topLeft, 0, 0), w: 16, h: 9, fill: #f4f1ea })

let ball = new Circle { position: apos!(:center, 3, 2.5), radius: 1, fill: #e0604a }
let bar = new Rect { position: apos!(:bottomLeft, 2, 8), w: 0.5, h: 2, fill: #3a6fb0 }
let label = new TextArea { text: "mophila", position: apos!(:center, 8, 5), fontSize: 1.2, fill: #222222, opacity: 0 }
v.place(ball)
v.place(bar)
v.place(label)

# 丸は 3 秒かけて右へ。ease で加速して減速する
let move = context ball as b {
  motion (t) {
    0s: b.position.x = 3
    3s: b.position.x = 13 :ease
  }
}

# 四角は 2 秒で横に広がる
let widen = context bar as r {
  motion (t) {
    0s: r.w = 0.5
    2s: r.w = 12 :ease_out
  }
}

# 文字は 1 秒で現れる
let appear = context label as l {
  motion (t) {
    0s: l.opacity = 0
    1s: l.opacity = 1
  }
}

let track = new Timeline {}
track.place(move, at: 0s)
track.place(widen, at: 0.5s)
track.place(appear, at: 3s)
v.addTrack(track)
output v
