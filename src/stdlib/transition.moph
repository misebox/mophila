# transition.moph — 現れる、消える、滑り込む、回る。
# どの関数も Timeline を返すだけで、そのままでは何も起きない。track.place(tl, at = 時刻) で置いた時刻から動く

## target の不透明度を from から to へ変える Timeline を返す。
## 0 → 1 と 1 → 0 は fade_in / fade_out があるので、途中の値を使うときに呼ぶ
## @category 現れる・消える
## @param target 動かす図形か View
## @param from 始まりの不透明度 0..1
## @param to 終わりの不透明度 0..1
## @param duration 変わりきるまでの長さ
## @returns 不透明度が from から to へ変わる Timeline
## @example
## # 2s から 0.4s かけて、はっきり見える状態から薄くする
## track.place(fade_to(card, 1, 0.2, 0.4s), at = 2s)
export func fade_to(target: Placeable, from: Number, to: Number, duration: Duration = 0.5s) -> Timeline {
  let tl = context target as s {
    motion (t) {
      0: s.opacity = from
      1: s.opacity = to
    }
  }
  tl.duration = duration
  tl
}

## target が透明な状態から現れる Timeline を返す (不透明度 0 → 1)。
## 置いた時刻に現れてほしいものに使う
## @category 現れる・消える
## @param target 動かす図形か View
## @param duration 現れきるまでの長さ
## @returns 不透明度が 0 から 1 へ変わる Timeline
## @example
## track.place(fade_in(card), at = 1s)
export func fade_in(target: Placeable, duration: Duration = 0.5s) -> Timeline { fade_to(target, 0, 1, duration) }

## target が消える Timeline を返す (不透明度 1 → 0)。
## 消え終わってほしい時刻から duration だけ手前に置く
## @category 現れる・消える
## @param target 動かす図形か View
## @param duration 消えきるまでの長さ
## @returns 不透明度が 1 から 0 へ変わる Timeline
## @example
## # 4s に消え終わる
## track.place(fade_out(card, 0.4s), at = 3.6s)
export func fade_out(target: Placeable, duration: Duration = 0.5s) -> Timeline { fade_to(target, 1, 0, duration) }

## target が (dx, dy) だけずれた所に現れ、今いる場所へ滑り込む Timeline を返す。
## 終わりに向かって減速する
## @category 滑る
## @param target position を持つ図形か View
## @param dx どれだけ右からずれて始まるか (箱の座標。負なら左)
## @param dy どれだけ下からずれて始まるか (負なら上)
## @param duration 着くまでの長さ
## @returns ずれた所から今いる場所へ動き、同時に現れる Timeline
## @example
## # 右に 4 ずれた所から、今いる場所へ滑り込む
## track.place(slide_in(card, 4, 0), at = 1s)
export func slide_in(target: Placeable, dx: Number, dy: Number, duration: Duration = 0.5s) -> Timeline {
  let x = target.position.x
  let y = target.position.y
  let tl = context target as s {
    motion (t) {
      0: s.position.x = x + dx, s.position.y = y + dy, s.opacity = 0
      1: s.position.x = x, s.position.y = y, s.opacity = 1 :ease_out
    }
  }
  tl.duration = duration
  tl
}

## target が今いる場所から (dx, dy) の方へ、消えながら去る Timeline を返す。
## 進むほど加速する
## @category 滑る
## @param target position を持つ図形か View
## @param dx どれだけ右へ去るか (箱の座標。負なら左)
## @param dy どれだけ下へ去るか (負なら上)
## @param duration 消えきるまでの長さ
## @returns 今いる場所から (dx, dy) へ動き、同時に消える Timeline
## @example
## # 上へ 3 去りながら消える
## track.place(slide_out(card, 0, -3, 0.4s), at = 5s)
export func slide_out(target: Placeable, dx: Number, dy: Number, duration: Duration = 0.5s) -> Timeline {
  let x = target.position.x
  let y = target.position.y
  let tl = context target as s {
    motion (t) {
      0: s.position.x = x, s.position.y = y, s.opacity = 1
      1: s.position.x = x + dx, s.position.y = y + dy, s.opacity = 0 :ease_in
    }
  }
  tl.duration = duration
  tl
}

## target が今いる場所から (dx, dy) だけ動く Timeline を返す。
## 動き出しと止まり際がなめらかになる
## @category 滑る
## @param target position を持つ図形か View
## @param dx 右への移動量 (箱の座標。負なら左)
## @param dy 下への移動量 (負なら上)
## @param duration 動ききるまでの長さ
## @returns 今いる場所から (dx, dy) だけ動く Timeline
## @example
## # 下へ 2 動く
## track.place(move_by(card, 0, 2), at = 2s)
export func move_by(target: Placeable, dx: Number, dy: Number, duration: Duration = 0.5s) -> Timeline {
  let x = target.position.x
  let y = target.position.y
  let tl = context target as s {
    motion (t) {
      0: s.position.x = x, s.position.y = y
      1: s.position.x = x + dx, s.position.y = y + dy :ease
    }
  }
  tl.duration = duration
  tl
}

## target が時計回りに turns 周まわる Timeline を返す。速さは一定
## @category 回す
## @param target rotation を持つ図形
## @param turns 回る数。1 で 1 周、0.5 で半周、負なら反時計回り
## @param duration 回りきるまでの長さ
## @returns rotation が 0 から 360 * turns へ変わる Timeline
## @example
## # 2 秒で 1 周
## track.place(spin(badge, 1, 2s), at = 0s)
export func spin(target: Placeable, turns: Number, duration: Duration = 1s) -> Timeline {
  let tl = context target as s {
    motion (t) {
      0: s.rotation = 0
      1: s.rotation = 360 * turns
    }
  }
  tl.duration = duration
  tl
}

## at に現れて end に消え終わるまでを、track に直接置く。
## 場面の出し入れをまとめて書くためのもので、戻り値は無い
## @category まとめて
## @param track 置き先の Timeline
## @param targets 出し入れする図形か View
## @param at 最初のひとつが現れ始める時刻
## @param end 全部が消え終わる時刻
## @param duration 1 つの現れ方と消え方の長さ
## @param stagger 次のひとつが現れるまでの遅れ
## @returns 無し。track に直接置く
## @example
## # 3 枚を 0.2s ずつずらして出し、6s に消し終える
## show(track, [a, b, c], at = 1s, end = 6s, stagger = 0.2s)
export func show(track: Timeline, targets: List<Placeable>, at: Duration, end: Duration, duration: Duration = 0.5s, stagger: Duration = 0s) -> Nothing {
  for (i, target) in targets.enumerate() {
    track.place(fade_in(target, duration), at = at + stagger * i)
    track.place(fade_out(target, duration), at = end - duration)
  }
}
