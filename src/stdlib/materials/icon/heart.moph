# heart.moph — ハート

import { arc } from shape

# 中央のくぼみから、左の丸を回って左端へ。下の先を通って、右端から右の丸を回ってくぼみへ戻る
let shape_points = arc(0.275, 0.30, 0.235, 90, -90, 10)
shape_points.push(Vector(0.5, 0.95))
for p in arc(0.725, 0.30, 0.235, 90, -90, 10) {
  shape_points.push(p)
}

## ハート。好きなもの、気に入りに
## @category しるし
## @type {List<List<Vector>>} 0..1 の箱に収めた輪郭の並び
export let HEART = [shape_points]
