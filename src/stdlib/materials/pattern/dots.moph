# dots.moph — 水玉

import math
import { HOUSE } from ..palette.house

## 水玉の塗り。pitch ごとに円が並ぶ
## @category 面
## @param back 地の色
## @param dot 円の色
## @param pitch 円の間隔 (箱の座標)
## @param radius 円の半径 (箱の座標)
## @param samples 1 ピクセルあたりの評価点
## @example
## v.place(Rect(position = Pos(0, 0, anchor = :topLeft), w = 16, h = 9,
##              fill = dots(#10131a, #4cc2ff, 0.6, 0.1)))
export func dots(back: Color, dot: Color, pitch: Number = 0.6, radius: Number = 0.12, samples: Number = 4) -> Shader {
  let half = pitch / 2
  let r2 = radius * radius
  Shader(
    color = func (x, y, t) {
      let u = x - math.floor(x / pitch) * pitch - half
      let v = y - math.floor(y / pitch) * pitch - half
      if u * u + v * v < r2 { dot } else { back }
    },
    samples = samples,
  )
}

## 既定の色の水玉
## @category 面
## @type {Shader} 塗り
export let DOTS = dots(HOUSE.back, HOUSE.track)
