# layout.moph — 並べる位置を出す。座標は箱の座標

## 格子の各マスの中心。左上 (x, y) から幅 w、高さ h を cols 列 rows 行に分け、左上から行ごとに
## @category 並べる
## @param x 左上の x
## @param y 左上の y
## @param w 全体の幅
## @param h 全体の高さ
## @param cols 列の数
## @param rows 行の数
## @returns cols * rows 個
## @example
## # 画面全体を 4 列 3 行に分け、各マスの中心に円を置く
## for p in grid(0, 0, 16, 9, 4, 3) {
##   v.place(Circle(position = Pos(p), radius = 0.4, fill = #4080e0))
## }
export func grid(x: Number, y: Number, w: Number, h: Number, cols: Number, rows: Number) -> List<Vector> {
  let cw = w / cols
  let ch = h / rows
  let cells = []
  for r in 0..rows {
    for c in 0..cols {
      cells.push(Vector(x + cw * (c + 0.5), y + ch * (r + 0.5)))
    }
  }
  cells
}

## 格子の 1 マスの大きさ
## @category 並べる
## @param w 全体の幅
## @param h 全体の高さ
## @param cols 列の数
## @param rows 行の数
## @returns 幅と高さ
## @example
## let size = cell(16, 9, 4, 3)   # Vector(4, 3)
export func cell(w: Number, h: Number, cols: Number, rows: Number) -> Vector { Vector(w / cols, h / rows) }

## from から to まで、両端を含めて n 個の点
## @category 並べる
## @param from 始点 (Vector)
## @param to 終点 (Vector)
## @param n 点の数 (2 以上)
## @example
## # 横一列に 5 個
## for p in along(Vector(2, 4.5), Vector(14, 4.5), 5) {
##   v.place(Circle(position = Pos(p), radius = 0.3, fill = #303030))
## }
export func along(from: Vector, to: Vector, n: Number) -> List<Vector> {
  (0..=1).steps(n - 1).map(func (k) { from + (to - from) * k })
}

## 幅 w、高さ h のものを、比率を保って box_w x box_h に収めたときの大きさ
## @category 収める
## @param w 元の幅
## @param h 元の高さ
## @param box_w 収める幅
## @param box_h 収める高さ
## @returns 幅と高さ
## @example
## let size = fit(1920, 1080, 16, 9)   # Vector(16, 9)
export func fit(w: Number, h: Number, box_w: Number, box_h: Number) -> Vector {
  let k = if box_w / w < box_h / h { box_w / w } else { box_h / h }
  Vector(w * k, h * k)
}
