# passerby.moph — 育つ木 (fractal.moph) の前を、歩く人 (walker.moph) が通り過ぎる
# 2 つのサンプルを import して置くだけで 1 つの絵になる。README の GIF はこれ。
# docs/readme.gif の作り方:
#   mophila render examples/gallery/passerby.moph -o r.mp4 --size 400x225 --fps 10 --codec libx264rgb --pix-fmt rgb24
#   ffmpeg -i r.mp4 -vf "palettegen=max_colors=64:stats_mode=diff" pal.png
#   ffmpeg -i r.mp4 -i pal.png -lavfi "paletteuse=dither=none:diff_mode=rectangle" docs/readme.gif

import { make, speed, floor } from .walker
import .fractal

let total = 8s
let comp = Composition(box = Vector(16, 9), duration = total)

# 木は fractal.moph の Composition をそのまま置く (背景も木のもの)。木は 14 秒あるので total で切る
comp.place("tree", fractal.output, in = 0s, out = total)

# 人は左から右へ。幅 5 で置くので、足が滑らない速さは speed * 5 / 6
let w = 5
func person(t) {
  make(#e8ecf7, #8b93a7, t).copy(
    anchor = Vector(0, 6),
    position = Vector(-w + speed * w / 6 * (t / 1s), 8.6 + (6 - floor) * w / 6),
    scale = w / 6)
}
comp.place("person", person, in = 0s, out = total)

output comp
