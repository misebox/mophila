# first.moph — 最初の 1 本。丸が右へ動き、四角が横に広がり、文字が現れて、最後に消える

import { fade_out } from animation

let v = View(box = Vector(16, 9))
v.place(Rect(position = Pos(0, 0, anchor = :topLeft), w = 16, h = 9, fill = #f4f1ea))

# 動かす 3 つは 1 つの箱にまとめる。まとめて薄くできる
let stage = View(box = Vector(16, 9), opacity = 1)
v.place(stage, at = Pos(0, 0, anchor = :topLeft), w = 16)

let ball = Circle(position = Pos(3, 2.5), radius = 1, fill = #e0604a)
let bar = Rect(position = Pos(2, 8, anchor = :bottomLeft), w = 0.5, h = 2, fill = #3a6fb0)
let label = TextArea(text = "mophila", position = Pos(8, 5), fontSize = 1.2, fill = #222222, opacity = 0)
stage.place(ball)
stage.place(bar)
stage.place(label)

# 丸は 3 秒かけて右へ。ease で加速して減速する
let move = context ball as b {
  motion (t) {
    0s: b.position.x = 3
    3s: b.position.x = 13 :ease
  }
}

# 四角は 2 秒で横に広がる
let widen = context bar as r {
  motion (t) {
    0s: r.w = 0.5
    2s: r.w = 12 :ease_out
  }
}

# 文字は 1 秒で現れる
let appear = context label as l {
  motion (t) {
    0s: l.opacity = 0
    1s: l.opacity = 1
  }
}

let track = Timeline()
track.place(move, at = 0s)
track.place(widen, at = 0.5s)
track.place(appear, at = 3s)
# 文字が出そろう 4s から 3 秒見せて、最後の 1 秒で箱ごと消える
track.place(fade_out(stage, 1s), at = 7s)
v.addTrack(track)
output v
