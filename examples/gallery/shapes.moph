# shapes.moph — 丸は動きながら大きさが変わり、四角は回り、五角形は頂点そのものが波打つ

import math
import { regular_polygon, polar } from shape

let total = 6s
let cx = 8
let swing = 3.2

# 丸。止まる、動く、止まる。行末の :ease で動き出しと止まり際がなめらかになる
let roll = progress [:x, :radius] {
  0:    cx - swing, 0.65
  0.15: cx - swing, 0.65
  0.5:  cx + swing :ease, 1.25 :ease
  0.65: cx + swing, 1.25
  1:    cx - swing :ease, 0.65 :ease
}

func ball(t) {
  let (x, radius) = roll(t / total)
  Circle(position = Vector(x, 2.5), radius = radius, fill = #e0604a)
}

# 四角。rotation は時計回りのラジアン。点を原点のまわりに作り、position で置くと、原点が回転の軸になる
func square(t) {
  Polygon(points = regular_polygon(0, 0, 0.95, 4), position = Vector(cx, 4.6), rotation = math.tau * (t / total), fill = #3a6fb0)
}

# 五角形。頂点ごとに中心からの距離を変えて、うねらせる
let py = 6.7

func penta(t) {
  let points = (0..5).to_list().map(func (i) {
    let r = 0.95 + 0.3 * math.sin(math.tau * (t / 1s) * 2 + i * 1.5)
    polar(cx, py, r, i * math.tau / 5)
  })
  Polygon(points = points, fill = #3f9b6d)
}

let comp = Composition(box = Vector(16, 9), duration = total)
comp.place("bg", Rect(position = Vector(0, 0), anchor = Vector(0, 0), w = 16, h = 9, fill = #f5f4f0), in = 0s, out = total)
comp.place("ball", ball, in = 0s, out = total)
comp.place("square", square, in = 0s, out = total)
comp.place("penta", penta, in = 0s, out = total)

output comp
