# main.moph — mophila の紹介。作れるもの / 組み合わせ / 時間の書き方 / LLM を使って書く / 使う
# 場面は 1 ファイルずつ。run(now) が場面を組み、次の開始時刻を返す。設定は theme、部品は slides。
# 場面が積んだ Layer を、全体の長さが決まってから 1 つの Composition に置く。
# 字幕は動画の字幕トラック。音楽は QuietSignal.m4a

import { W, H, bg, layers } from .theme
import { chapter } from .slides
import "QuietSignal.m4a" as bgm
import .title
import .works
import .boxes
import .parts
import .files
import .table
import .rows
import .placing
import .seek
import .llm
import .tools
import .review
import .commands
import .ending

let now = 0s
now = title.run(now)
now = works.run(now)

now = chapter("組み合わせ", now)
now = boxes.run(now)
now = parts.run(now)
now = files.run(now)

now = chapter("時間の書き方", now)
now = table.run(now)
now = rows.run(now)
now = placing.run(now)
now = seek.run(now)

now = chapter("LLM を使って書く", now)
now = llm.run(now)
now = tools.run(now)
now = review.run(now)

now = chapter("使う", now)
now = commands.run(now)
now = ending.run(now)
log("total:", now)

let comp = Composition(box = Vector(W, H), duration = now)
comp.place("bg", Rect(position = Vector(0, 0), anchor = Vector(0, 0), w = W, h = H, fill = bg), in = 0s, out = now)
for (i, l) in layers.enumerate() {
  let (node, at, end) = l
  comp.place("layer-{i}".format(i), node, in = at, out = end)
}
comp.place("bgm", bgm.copy(volume = 0.5, loop = true), in = 0s, out = now)
output comp
