# fractal.moph — 枝分かれする木。各枝は親の先端から生え、親が動けば子も動く
# 部品が互いに依存する形: 枝は親の先端の位置を受け取って描く。木は根から順に伸び、伸び切ったら風に揺れる

import math

# ---------- 形と時間の決まり ----------
let levels     = 8            # 枝分かれの回数 (枝は 2^(levels+1) - 1 本)
let total      = 14s          # 動画の長さ
let trunk_len  = 2.1
let shrink     = 0.72         # 1 段ごとの長さの比
let spread     = 0.46         # 枝の開き (rad)
let grow_time  = 0.9          # 1 段が伸びる秒数
let grow_gap   = 0.5          # 次の段が伸び始めるまでの秒数
let sway_amp   = 0.035        # 揺れの角度 (rad)。先端ほど大きい
let sway_period = 4.5         # 揺れの周期 (秒)
let colors = [#7a4f33, #8a5c3a, #97693f, #8c7a42, #7c8c45, #62984c, #4aa25a, #46ad78, #6cc496]

let comp = Composition(box = Vector(16, 9), duration = total)
comp.place("bg", Rect(position = Vector(0, 0), anchor = Vector(0, 0), w = 16, h = 9, fill = #0d1117), in = 0s, out = total)

func smooth_bands(k) { k * k * (3 - 2 * k) }

# level 段目の枝が seconds 秒の時点でどこまで伸びているか (0..1)
func growth(seconds, level) {
  let k = (seconds - level * grow_gap) / grow_time
  smooth_bands(math.min(1, math.max(0, k)))
}

# 揺れ。段が深いほど大きく、phase で枝ごとにずらす
func sway(seconds, level, phase) {
  sway_amp * level * math.sin(seconds / sway_period * math.tau + phase)
}

func direction(angle) { Vector(math.cos(angle), -math.sin(angle)) }

# 親の先端 from から角度 angle に伸びる枝を items に足し、その先にさらに 2 本足す
func branch(items, seconds, from, angle, len, level, phase) {
  let tip = from + direction(angle + sway(seconds, level, phase)) * (len * growth(seconds, level))
  items.push(Line(from = from, to = tip, stroke = colors[level], strokeWidth = 0.18 * shrink ^ level, opacity = 0.95))
  if level < levels {
    branch(items, seconds, tip, angle + spread, len * shrink, level + 1, phase + 0.4)
    branch(items, seconds, tip, angle - spread, len * shrink, level + 1, phase - 0.4)
  } else {
    # 先端の葉。枝が伸び切ってから出る
    items.push(Circle(position = tip, radius = 0.06, fill = #b9e88a, opacity = growth(seconds, level + 1) * 0.9))
  }
}

# 幹は地面から。先端は伸びるだけで揺れない
let root = Vector(8, 8.6)

func tree(t) {
  let seconds = t / 1s
  let tip = root + direction(math.pi / 2) * (trunk_len * growth(seconds, 0))
  let items = [Line(from = root, to = tip, stroke = colors[0], strokeWidth = 0.18, opacity = 0.95)]
  branch(items, seconds, tip, math.pi / 2 + spread, trunk_len * shrink, 1, 0.4)
  branch(items, seconds, tip, math.pi / 2 - spread, trunk_len * shrink, 1, -0.4)
  Group(...items)
}
comp.place("tree", tree, in = 0s, out = total)

output comp
