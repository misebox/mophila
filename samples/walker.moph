# walker.moph — 歩く人。関節ごとの図形が、親の先端を毎フレーム読んでつながる (腰 → 腿 → 脛 → 足、肩 → 上腕 → 前腕)。
# 歩行の周期は sin で作る。脚が前に振れるとき膝が曲がり、着いているときは伸びる。腕は同じ側の脚と逆に振る。
# make(near, far, long) が「その場で long の間歩く人」の View (箱 6 x 6、足元は y 5.6) を返す。import して並べられる。
# 進むのは置いた側の仕事で、箱の幅 6 のとき 1 秒に speed 進めると足が滑らない

import math

# ---------- 体の寸法と歩き方 ----------
export let period = 1.2    # 1 周期 (左右 1 歩ずつ) の秒数
export let speed  = 3.1    # 歩幅に合う進む速さ (箱の単位 / 秒)
export let floor  = 5.6    # 箱の中の足元の高さ
let thigh   = 1.4
let shin    = 1.3
let torso   = 1.6
let upper   = 1.1
let fore    = 1.0
let swing   = 0.35         # 腿の振れ幅 (rad)
let width   = 0.13

# 角度 0 が真下、正が前 (x が増える向き)
func direction(a) { vector!(math.sin(a), math.cos(a)) }
# 歩行の位相。side は 0 (手前) か 1 (奥) で半周期ずれる
func phase(t, side, long) { math.TAU * t * (long / 1s) / period + side * math.PI }
func hip_at(t, long) { vector!(3, floor - thigh - shin + 0.15 - 0.07 * math.cos(2 * phase(t, 0, long))) }
func thigh_angle(p) { swing * math.sin(p) }
# 前に振れている間 (cos > 0) だけ膝を曲げる
func shin_angle(p) { thigh_angle(p) - 0.1 - 0.9 * math.max(0, math.cos(p)) }
func upper_angle(p) { -0.6 * math.sin(p) }
func fore_angle(p) { upper_angle(p) + 0.55 }

func limb(box, color) {
  let l = new Line { from: (0, 0), to: (0, 0), stroke: color, strokeWidth: width }
  box.place(l)
  l
}
func joint(box, color, r) {
  let c = new Circle { position: apos!(:center, 0, 0), radius: r, fill: color }
  box.place(c)
  c
}

# 片側の脚と腕。親の先端を読む行でつなぐ。戻り値は Timeline
func side_of(box, side, color, long) {
  let th = limb(box, color)
  let sh = limb(box, color)
  let ft = limb(box, color)
  let ua = limb(box, color)
  let fa = limb(box, color)
  let knee = joint(box, color, width / 2)
  let ankle = joint(box, color, width / 2)
  let elbow = joint(box, color, width / 2)
  let hand = joint(box, color, width * 0.7)
  let tl = context th as a, sh as b, ft as c, ua as d, fa as e, knee as k, ankle as n, elbow as m, hand as h {
    motion (t) {
      0..1: a.from = hip_at(t, long)
      0..1: a.to = a.from + direction(thigh_angle(phase(t, side, long))) * thigh
      0..1: b.from = a.to
      0..1: b.to = b.from + direction(shin_angle(phase(t, side, long))) * shin
      0..1: c.from = b.to
      0..1: c.to = c.from + direction(shin_angle(phase(t, side, long)) + math.PI / 2) * 0.35
      0..1: k.position = apos!(:center, a.to)
      0..1: n.position = apos!(:center, b.to)
      0..1: d.from = hip_at(t, long) + vector!(0.12, -torso)
      0..1: d.to = d.from + direction(upper_angle(phase(t, side, long))) * upper
      0..1: e.from = d.to
      0..1: e.to = e.from + direction(fore_angle(phase(t, side, long))) * fore
      0..1: m.position = apos!(:center, d.to)
      0..1: h.position = apos!(:center, e.to)
    }
  }
  tl.duration = long
  tl
}

# その場で long の間歩く人。near は手前の手足と胴の色、far は奥の手足の色
export func make(near, far, long) {
  let box = new View { box: (6, 6) }
  let tl = new Timeline {}
  # 奥 → 胴 → 手前 の順に置き、同じ順に当てる (親の値を読む行は、親の行が先に当たっている必要がある)
  tl.place(side_of(box, 1, far, long), at: 0s)
  let body = limb(box, near)
  let hip = joint(box, near, width * 0.8)
  let neck = joint(box, near, width / 2)
  let head = joint(box, near, 0.36)
  let trunk = context body as b, hip as p, neck as n, head as h {
    motion (t) {
      0..1: b.from = hip_at(t, long)
      0..1: b.to = b.from + vector!(0.12, -torso)
      0..1: p.position = apos!(:center, b.from)
      0..1: n.position = apos!(:center, b.to)
      0..1: h.position = apos!(:center, b.to + vector!(0.08, -0.5))
    }
  }
  trunk.duration = long
  tl.place(trunk, at: 0s)
  tl.place(side_of(box, 0, near, long), at: 0s)
  box.addTrack(tl)
  box
}

# ---------- 単体で見るとき: 1 人が左から右へ横切る ----------
let v = new View { box: (16, 9) }
let track = new Timeline {}
v.place(new Rect { position: apos!(:topLeft, 0, 0), w: 16, h: 9, fill: #14161c })
let ground_y = 8
v.place(new Line { from: (0, ground_y), to: (16, ground_y), stroke: #3a4560, strokeWidth: 0.04 })
let total = 7s
let one = make(#e8ecf7, #8b93a7, total)
v.place(one, at: apos!(:bottomLeft, -5, ground_y + 6 - floor), w: 6)
let travel = context one as o {
  motion (t) {
    0s: o.position.x = -5
    7s: o.position.x = -5 + speed * 7
  }
}
track.place(one, at: 0s)
track.place(travel, at: 0s)
v.addTrack(track)
output v
