# rows.moph — 時間 2: 毎フレーム式を評価する行。親の値を読めば部品は追いかける

import math
import { W, H, v, track, ink, dim, accent, blue, review, dwell, longer } from .theme
import { place, show, text, heading, card, outline, loop_demo, demo, scene, add, say, close } from .slides
import { make, floor } from ..walker

func orbiter(life) {
  let b = View(box = Vector(4, 3))
  b.place(Rect(position = Pos(0, 0, anchor = :topLeft), w = 4, h = 3, fill = #1b2130))
  b.place(Circle(position = Pos(2, 1.5), radius = 1.1, stroke = dim, strokeWidth = 0.03))
  let c = Circle(position = Pos(3.1, 1.5), radius = 0.3, fill = blue)
  b.place(c)
  let orbit = context c as o {
    motion (t) {
      0..1: o.position = Pos(2 + 1.1 * math.cos(math.TAU * t * (life / 1s) / 3), 1.5 + 1.1 * math.sin(math.TAU * t * (life / 1s) / 3))
    }
  }
  orbit.duration = life
  let tl = Timeline()
  tl.place(orbit, at = 0s)
  b.addTrack(tl)
  b
}

export func run(now) {
  log("rows", now)
  let sc = scene()
  add(sc, [heading("毎フレーム、式で決める")], now)
  # A: 円軌道
  let ta = now + 0.5s
  let a_card = card([
    "motion (t) {",
    "  0..1: o.position = Pos(", "    2 + 1.1 * math.cos(math.TAU * t), ", "    1.5 + 1.1 * math.sin(math.TAU * t))",
    "}",
  ], 0.7, 1.8, 7.6, 0.28)
  let t = say(sc, "0 から 1 の範囲の行は、補間せず、毎フレーム式を評価します。", ta)
  t = say(sc, "円軌道は、cos と sin の 1 行です。", t)
  let tb = t + 0.5s
  for o in a_card { show([o], ta, tb) }
  add(sc, [outline(9.9, 1.9, 5.2, 3.9)], ta)
  demo(orbiter(tb - ta), 10.0, 2.0, 5.0, ta, tb)
  # B: 歩く人の関節
  let b_card = card([
    "# 脛は腿の先端を、足は脛の先端を読む",
    "motion (t) {",
    "  0..1: thigh.from = hip(t)",
    "  0..1: thigh.to = thigh.from + direction(a1(t)) * 1.4",
    "  0..1: shin.from = thigh.to",
    "  0..1: shin.to = shin.from + direction(a2(t)) * 1.3",
    "  0..1: foot.from = shin.to",
    "}",
  ], 0.7, 1.8, 7.6, 0.28)
  let end = tb + 14s
  for o in b_card { show([o], tb, end) }
  t = say(sc, "式の中で、ほかの図形の値も読めます。", tb)
  t = say(sc, "この人は、腰、腿、脛、足の順に、親の先端を読んでつながっています。", t)
  t = say(sc, "角度を sin で揺らすだけで、歩きになります。", t)
  let p = make(ink, #8b93a7, end - tb)
  loop_demo(p, 9.8, 6.9 - 6, 6, tb, end - tb, end)
  close(sc, longer(t, end))
}
