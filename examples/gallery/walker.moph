# walker.moph — 歩く人。関節ごとの図形が、親の先端から次の関節へつながる (腰 → 腿 → 脛 → 足、肩 → 上腕 → 前腕)。
# 歩行の周期は sin で作る。脚が前に振れるとき膝が曲がり、着いているときは伸びる。腕は同じ側の脚と逆に振る。
# make(near, far, t) が「その場で歩く人」の Group (箱 6 x 6、足元は y 5.6) を、時刻 t のぶんだけ返す。import して並べられる。
# 進むのは置いた側の仕事で、箱の幅 6 のとき 1 秒に speed 進めると足が滑らない

import math

# ---------- 体の寸法と歩き方 ----------
export let period = 1.2    # 1 周期 (左右 1 歩ずつ) の秒数
export let speed  = 3.1    # 歩幅に合う進む速さ (箱の単位 / 秒)
export let floor  = 5.6    # 箱の中の足元の高さ
let thigh   = 1.4
let shin    = 1.3
let torso   = 1.6
let upper   = 1.1
let fore    = 1.0
let swing   = 0.35         # 腿の振れ幅 (rad)
let width   = 0.13

# 角度 0 が真下、正が前 (x が増える向き)
func direction(a) { Vector(math.sin(a), math.cos(a)) }
# 歩行の位相。side は 0 (手前) か 1 (奥) で半周期ずれる
func phase(t, side) { math.tau * (t / 1s) / period + side * math.pi }
func hip_at(t) { Vector(3, floor - thigh - shin + 0.15 - 0.07 * math.cos(2 * phase(t, 0))) }
func thigh_angle(p) { swing * math.sin(p) }
# 前に振れている間 (cos > 0) だけ膝を曲げる
func shin_angle(p) { thigh_angle(p) - 0.1 - 0.9 * math.max(0, math.cos(p)) }
func upper_angle(p) { -0.6 * math.sin(p) }
func fore_angle(p) { upper_angle(p) + 0.55 }

func limb(from, to, color) { Line(from = from, to = to, stroke = color, strokeWidth = width) }
func joint(at, color, r) { Circle(position = at, radius = r, fill = color) }

# 片側の脚と腕。親の先端を次の起点にしてつなぐ。戻り値は図形の List
func side_of(side, color, t) {
  let p = phase(t, side)
  let hip = hip_at(t)
  let knee = hip + direction(thigh_angle(p)) * thigh
  let ankle = knee + direction(shin_angle(p)) * shin
  let toe = ankle + direction(shin_angle(p) + math.pi / 2) * 0.35
  let shoulder = hip + Vector(0.12, -torso)
  let elbow = shoulder + direction(upper_angle(p)) * upper
  let hand = elbow + direction(fore_angle(p)) * fore
  [
    limb(hip, knee, color), limb(knee, ankle, color), limb(ankle, toe, color),
    limb(shoulder, elbow, color), limb(elbow, hand, color),
    joint(knee, color, width / 2), joint(ankle, color, width / 2),
    joint(elbow, color, width / 2), joint(hand, color, width * 0.7),
  ]
}

# 胴と頭
func trunk_of(color, t) {
  let hip = hip_at(t)
  let neck = hip + Vector(0.12, -torso)
  [
    limb(hip, neck, color),
    joint(hip, color, width * 0.8), joint(neck, color, width / 2),
    joint(neck + Vector(0.08, -0.5), color, 0.36),
  ]
}

# その場で歩く人。near は手前の手足と胴の色、far は奥の手足の色、t は歩き始めからの時刻
export func make(near: Color, far: Color, t: Duration) -> Group {
  # 奥 → 胴 → 手前 の順に重ねる
  Group(...side_of(1, far, t), ...trunk_of(near, t), ...side_of(0, near, t))
}

# ---------- 単体で見るとき: 1 人が左から右へ横切る ----------
let total = 7s
let ground_y = 8

func one(t) {
  make(#e8ecf7, #8b93a7, t).copy(anchor = Vector(0, 6), position = Vector(-5 + speed * (t / 1s), ground_y + 6 - floor))
}

let comp = Composition(box = Vector(16, 9), duration = total)
comp.place("bg", Rect(position = Vector(0, 0), anchor = Vector(0, 0), w = 16, h = 9, fill = #14161c), in = 0s, out = total)
comp.place("ground", Line(from = Vector(0, ground_y), to = Vector(16, ground_y), stroke = #3a4560, strokeWidth = 0.04), in = 0s, out = total)
comp.place("person", one, in = 0s, out = total)

output comp
