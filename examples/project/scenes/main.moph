# mophila.yaml の entry。いる場所が examples/project なら、
#   mophila run          (スクリプトを書かずに実行できる)
#   mophila render --set seconds=6
import config
import { hsl } from color
import { make } from @parts.box   # aliases の parts から。名前を直接持ち込む
import @.scenes.title             # root からの相対。Module として読む

# config.seconds は Number。1s を掛けて Duration に
let len = config.seconds * 1s
let comp = Composition(box = Vector(config.width, config.height), duration = len)
comp.place("background", make(0, 0, config.width, config.height, #f4f1ea), in = 0s, out = len)
comp.place("title", title.make(config.title), in = 0s, out = len)

# 棒は、時刻に合わせて伸びる
let color = hsl(config.hue, 0.7, 0.55)
func bar(t) {
  make(1, 4, ease(t, 0s, len, 2, config.width - 2), 1, color)
}
comp.place("bar", bar, in = 0s, out = len)

if config.debug {
  log("title", config.title, "size", config.width, config.height)
}
output comp
