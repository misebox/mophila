# backdrop.moph — 背景と、上に重ねる幕
#
# どれも時間を知らない。動くものは progress (0..1) を受け取る。
# 時間の流れ方は呼ぶ側が決める。
# Shader を使うものは GPU で描くので run では出ず、render と preview で出る。
#
#   comp.place("paper", graph_paper(16, 9), in = 0s, out = comp.duration)

import math
import { alpha, gray } from color
import shape

# 格子の 1 本が光る明るさ。0 が光り始め、1 が光り終わり
let pulse = progress [:opacity] {
  0:   0.15
  0.4: 0.7
  1:   0.15
}

## 方眼紙。細い線と、太い線を step ごとに引く
## @category 静止
## @param w 幅
## @param h 高さ
## @param step 細い線の間隔 (既定 1)
## @param major 太い線を引く本数の間隔 (既定 5)
## @param back 紙の色 (既定 生成り)
## @param line 線の色 (既定 薄い青灰)
## @returns 左上を (0, 0) とした w x h の Group
## @example
## comp.place("paper", graph_paper(16, 9), in = 0s, out = comp.duration)
export func graph_paper(w: Number, h: Number, step: Number = 1, major: Number = 5, back: Color = #f6f4ee, line: Color = #c9d4e0) -> Group {
  let items = [Rect(position = Vector(0, 0), anchor = Vector(0, 0), w = w, h = h, fill = back)]
  let thin = step * 0.02
  for i in 0..=math.floor(w / step) {
    let x = i * step
    let heavy = i % major == 0
    items.push(Line(from = Vector(x, 0), to = Vector(x, h), stroke = alpha(line, if heavy { 0.9 } else { 0.45 }), strokeWidth = if heavy { thin * 2 } else { thin }))
  }
  for j in 0..=math.floor(h / step) {
    let y = j * step
    let heavy = j % major == 0
    items.push(Line(from = Vector(0, y), to = Vector(w, y), stroke = alpha(line, if heavy { 0.9 } else { 0.45 }), strokeWidth = if heavy { thin * 2 } else { thin }))
  }
  Group(...items)
}

## 周辺減光。真ん中は素通しで、縁だけ暗くする。一番上に重ねる
## @category 重ねる
## @param w 幅
## @param h 高さ
## @param amount 縁の暗さ 0..1 (既定 0.5)
## @param color 暗くする色 (既定 黒)
## @returns 左上を (0, 0) とした w x h の Group
## @example
## comp.place("vignette", vignette(16, 9, 0.6), in = 0s, out = comp.duration)
export func vignette(w: Number, h: Number, amount: Number = 0.5, color: Color = #000000) -> Group {
  let r = math.hypot(w, h) / 2
  Group(Rect(position = Vector(0, 0), anchor = Vector(0, 0), w = w, h = h, fill = Gradient(
    kind = :radial,
    from = Vector(w / 2, h / 2),
    radius = r,
    stops = [alpha(color, 0), alpha(color, amount * 0.25), alpha(color, amount)],
  )))
}

## 粒が下から上へ流れる。progress が 0 から 1 になる間に流れ切る
## @category 動く
## @param w 幅
## @param h 高さ
## @param progress 流れの進み 0..1
## @param count 粒の数 (既定 40)
## @param color 粒の色 (既定 白)
## @param size 粒の半径 (既定 高さの 1/120)
## @returns 左上を (0, 0) とした w x h の Group
## @example
## comp.place("dust", func (t) { particles(16, 9, t / 6s) }, in = 0s, out = 6s)
export func particles(w: Number, h: Number, progress: Number, count: Number = 40, color: Color = #ffffff, size: Number = 0) -> Group {
  let r = if size > 0 { size } else { h / 120 }
  let items = []
  for i in 0..count {
    # 数式で散らす。同じ引数なら毎回同じ並びになる
    let x = w * ((i * 0.6180339887) % 1)
    let phase = (i * 0.7548776662) % 1
    let speed = 0.6 + ((i * 0.3247179572) % 1) * 0.8
    let drift = (((i * 0.5698402909) % 1) - 0.5) * w * 0.06
    let radius = r * (0.6 + ((i * 0.4142135623) % 1))
    # 粒ごとに速さが違い、先に流れ切った粒は上で止まる
    let k = math.clamp(progress * speed, 0, 1)
    let y0 = h * (1 - phase) + r
    let y1 = h * (1 - phase) - h - r
    items.push(Circle(position = Vector(math.lerp(x, x + drift, k), math.lerp(y0, y1, k)), radius = radius, fill = alpha(color, 0.25 + ((i * 0.2360679774) % 1) * 0.5)))
  }
  Group(...items)
}

## 格子が順に明るくなる。progress が 0 から 1 になる間に端から端まで渡る
## @category 動く
## @param w 幅
## @param h 高さ
## @param progress 明るさの進み 0..1
## @param step 格子の間隔 (既定 1)
## @param color 線の色 (既定 青)
## @param back 背の色 (既定 ほぼ黒)
## @returns 左上を (0, 0) とした w x h の Group
## @example
## comp.place("grid", func (t) { grid_pulse(16, 9, t / 3s) }, in = 0s, out = 3s)
export func grid_pulse(w: Number, h: Number, progress: Number, step: Number = 1, color: Color = #4080e0, back: Color = #12151a) -> Group {
  let items = [Rect(position = Vector(0, 0), anchor = Vector(0, 0), w = w, h = h, fill = back)]
  let cols = math.floor(w / step)
  let rows = math.floor(h / step)
  let wide = step * 0.03
  for i in 0..=cols {
    let x = i * step
    let (lit) = pulse((progress - i / (cols + 1)) / 0.3)
    items.push(Line(from = Vector(x, 0), to = Vector(x, h), stroke = color, strokeWidth = wide, opacity = lit))
  }
  for j in 0..=rows {
    let y = j * step
    let (lit) = pulse((progress - j / (rows + 1)) / 0.3)
    items.push(Line(from = Vector(0, y), to = Vector(w, y), stroke = color, strokeWidth = wide, opacity = lit))
  }
  Group(...items)
}

## レーダーの掃引。progress が 0 から 1 になる間に 1 回転する
## @category 動く
## @param w 幅
## @param h 高さ
## @param progress 回転の進み 0..1
## @param rings 円の本数 (既定 3)
## @param color 線と扇の色 (既定 緑)
## @param back 背の色 (既定 ほぼ黒)
## @returns 左上を (0, 0) とした w x h の Group
## @example
## comp.place("radar", func (t) { radar_sweep(8, 8, t / 4s) }, in = 0s, out = 4s)
export func radar_sweep(w: Number, h: Number, progress: Number, rings: Number = 3, color: Color = #4aa863, back: Color = #0e1412) -> Group {
  let cx = w / 2
  let cy = h / 2
  let r = math.min(w, h) / 2
  let items = [Rect(position = Vector(0, 0), anchor = Vector(0, 0), w = w, h = h, fill = back)]
  for i in 1..=rings {
    items.push(Circle(position = Vector(cx, cy), radius = r * i / rings, stroke = alpha(color, 0.35), strokeWidth = r * 0.006))
  }
  items.push(Line(from = Vector(cx - r, cy), to = Vector(cx + r, cy), stroke = alpha(color, 0.35), strokeWidth = r * 0.006))
  items.push(Line(from = Vector(cx, cy - r), to = Vector(cx, cy + r), stroke = alpha(color, 0.35), strokeWidth = r * 0.006))
  # 扇の点は箱の座標のまま。円の中心を anchor にして、その場で回す
  items.push(Polygon(points = shape.ring_segment(cx, cy, 0, r, -math.tau * 50 / 360, 0, 24), fill = alpha(color, 0.35), position = Vector(cx, cy), anchor = Vector(cx, cy), rotation = progress * math.tau))
  Group(...items)
}

## にじんだ塊が漂う背景 (Shader)
## @category 動く
## @param w 幅
## @param h 高さ
## @param back 背の色
## @param a 塊の色 その 1
## @param b 塊の色 その 2
## @param speed 漂う速さ (既定 1)
## @returns 左上を (0, 0) とした w x h の Group
## @example
## comp.place("blobs", blobs(16, 9, #10131a, #4080e0, #b04ae0), in = 0s, out = comp.duration)
export func blobs(w: Number, h: Number, back: Color = #10131a, a: Color = #4080e0, b: Color = #b04ae0, speed: Number = 1) -> Group {
  let ar = a.r
  let ag = a.g
  let ab = a.b
  let br = b.r
  let bg = b.g
  let bb = b.b
  let kr = back.r
  let kg = back.g
  let kb = back.b
  Group(Rect(position = Vector(0, 0), anchor = Vector(0, 0), w = w, h = h, fill = Shader(color = func (x, y, t) {
    let u = x / w
    let v = y / h * (h / w)
    let s = t * speed * 0.6
    let p1 = Vector(0.32 + 0.16 * math.sin(s), 0.30 + 0.12 * math.cos(s * 0.83))
    let p2 = Vector(0.70 + 0.14 * math.sin(s * 0.71 + 2), 0.55 + 0.16 * math.cos(s * 0.61 + 1))
    let p3 = Vector(0.50 + 0.22 * math.sin(s * 0.47 + 4), 0.20 + 0.18 * math.cos(s * 0.53 + 3))
    let d1 = (u - p1.x) * (u - p1.x) + (v - p1.y) * (v - p1.y)
    let d2 = (u - p2.x) * (u - p2.x) + (v - p2.y) * (v - p2.y)
    let d3 = (u - p3.x) * (u - p3.x) + (v - p3.y) * (v - p3.y)
    let w1 = 1 / (1 + d1 * 26)
    let w2 = 1 / (1 + d2 * 26)
    let w3 = 1 / (1 + d3 * 36)
    let ka = math.min(w1 + w3 * 0.6, 1)
    let kb2 = math.min(w2 + w3 * 0.4, 1)
    Color(kr + (ar - kr) * ka + (br - kr) * kb2, kg + (ag - kg) * ka + (bg - kg) * kb2, kb + (ab - kb) * ka + (bb - kb) * kb2)
  })))
}

## フィルムのざらつき (Shader)。一番上に重ねる
## @category 重ねる
## @param w 幅
## @param h 高さ
## @param amount ざらつきの強さ 0..1 (既定 0.12)
## @param grain_size 粒の粗さ。大きいほど粗い (既定 1)
## @returns 左上を (0, 0) とした w x h の Group
## @example
## comp.place("grain", grain(16, 9, 0.15), in = 0s, out = comp.duration)
export func grain(w: Number, h: Number, amount: Number = 0.12, grain_size: Number = 1) -> Group {
  Group(Rect(position = Vector(0, 0), anchor = Vector(0, 0), w = w, h = h, fill = Shader(color = func (x, y, t) {
    let px = math.floor(x / (w / 640) / grain_size)
    let py = math.floor(y / (w / 640) / grain_size)
    let seed = px * 12.9898 + py * 78.233 + math.floor(t * 24) * 43.123
    let n = math.sin(seed) * 43758.5453
    let r = n - math.floor(n)
    Color(255 * r, 255 * r, 255 * r, amount)
  })))
}
