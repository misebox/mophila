# seek.moph — 時間 4: どの時刻の絵も、その時刻だけから決まる。途中へ飛んでも同じ絵

import math
import { W, H, ink, dim, accent, blue, line, review, dwell, longer } from .theme
import { show, text, heading, card, outline, loop_func, scene, add, say, close } from .slides

# 印は進んだり飛んだりする (0..1 は軸の左端から右端)。10 秒で 1 周
let jump = progress [:u] {
  0:    0
  0.4:  1
  0.45: 1
  0.46: 0.3
  0.66: 0.8
  0.71: 0.8
  0.72: 0.1
  1:    0.8
}

export func run(now) {
  log("seek", now)
  let sc = scene()
  add(sc, [heading("絵は、時刻の関数")], now)
  add(sc, card([
    "# 時刻 t の絵 = Layer の func に t を渡して返った Node",
    "#            (Layer の in を 0 とした時刻)",
    "# 前のフレームには依存しない",
    "#",
    "# だから途中の時刻へ飛んでも同じ絵になり、",
    "# preview で戻しても、render で 1 枚だけ出しても、同じ",
    "$ mophila render a.moph --at 2.5s -o frame.png",
  ], 0.7, 1.8, 7.6, 0.28), now + 0.4s)
  # 右: 時間軸の印と、その時刻の絵 (ボールの位置は印の位置だけから決まる)
  let x0 = 9.4
  let x1 = 15.0
  let ay = 6.3
  let axis = [Line(from = Vector(x0, ay), to = Vector(x1, ay), stroke = line, strokeWidth = 0.05)]
  for i in 0..=4 {
    let x = x0 + i * (x1 - x0) / 4
    axis.push(Line(from = Vector(x, ay - 0.12), to = Vector(x, ay + 0.12), stroke = line, strokeWidth = 0.04))
    axis.push(text("{s}s".format(i), x, ay + 0.4, 0.26, dim, :center))
  }
  let t1 = now + 0.5s
  add(sc, axis + [outline(x0, 1.8, x1 - x0, 3.9)], t1)
  # 印とボール。ボールは印の位置 u だけから位置を決める
  let marker = func (t) {
    let u = jump(t / 10s)[0]
    Group(
      Circle(position = Vector(x0 + (x1 - x0) * u, ay), radius = 0.13, fill = ink),
      Circle(position = Vector(x0 + 0.5 + (x1 - x0 - 1) * u, 3.75 - 1.4 * math.abs(math.sin(math.pi * u * 2))), radius = 0.35, fill = accent),
    )
  }
  let end = t1 + 20s
  loop_func(marker, t1, 10s, end)
  let t = say(sc, "どの時刻の絵も、その時刻だけから決まります。", t1)
  t = say(sc, "前のフレームには依存しないので、途中へ飛んでも同じ絵です。", t)
  t = say(sc, "preview で戻しても、1 枚だけ画像にしても、同じになります。", t)
  close(sc, longer(t, end))
}
