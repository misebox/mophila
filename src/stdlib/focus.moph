# focus.moph — 見せたい所だけ見せる幕と、切り替え
#
# どれも「今どうなっているか」を受け取る。時間は知らない。
# 動かすときは、func (t) の Layer の中で progress などを ease で作って渡す。
#
#   comp.place("spot", spotlight(4, 3, 1.5, 16, 9), in = 0s, out = comp.duration)
#   comp.place("wipe", func (t) { wipe(16, 9, ease(t, 0s, 0.5s, 0, 1), :left) }, in = 0s, out = 0.5s)

import math
import { alpha } from color

## 丸く開けた穴の外を暗くする。中身の上に重ねる
## @category 幕
## @param cx 穴の中心の x
## @param cy 穴の中心の y
## @param radius 穴の半径
## @param w 幅
## @param h 高さ
## @param dark 外の暗さ 0..1 (既定 0.7)
## @param color 暗くする色 (既定 黒)
## @returns 左上を (0, 0) とした w x h の Group
## @example
## comp.place("spot", spotlight(4, 3, 1.5, 16, 9), in = 0s, out = comp.duration)
export func spotlight(cx: Number, cy: Number, radius: Number, w: Number, h: Number, dark: Number = 0.7, color: Color = #000000) -> Group {
  # 太い線の輪で外側を塗りつぶす。輪の内側がちょうど穴になる。輪は箱よりずっと大きいので、はみ出す分は箱で切る
  let thick = math.hypot(w, h) * 2
  Group(
    Circle(position = Vector(cx, cy), radius = radius + thick / 2, stroke = alpha(color, dark), strokeWidth = thick),
    clip = Rect(position = Vector(0, 0), anchor = Vector(0, 0), w = w, h = h),
  )
}

## 円が開く / 閉じる切り替え
## @category 切り替え
## @param w 幅
## @param h 高さ
## @param progress 開いている割合 0..1。0 で覆い尽くし、1 で全部見える
## @param cx 円の中心の x (既定 真ん中)
## @param cy 円の中心の y (既定 真ん中)
## @param color 幕の色 (既定 黒)
## @returns 左上を (0, 0) とした w x h の Group
## @example
## comp.place("iris", func (t) { iris(16, 9, ease(t, 0s, 0.6s, 0, 1)) }, in = 0s, out = 0.6s)
export func iris(w: Number, h: Number, progress: Number, cx: Number = -1, cy: Number = -1, color: Color = #000000) -> Group {
  let x = if cx < 0 { w / 2 } else { cx }
  let y = if cy < 0 { h / 2 } else { cy }
  let k = math.clamp(progress, 0, 1)
  # 四隅まで届く半径。そこまで開けば幕は消える
  let full = math.max(math.hypot(x, y), math.max(math.hypot(w - x, y), math.max(math.hypot(x, h - y), math.hypot(w - x, h - y))))
  let r = full * k
  let thick = full * 2
  Group(
    Circle(position = Vector(x, y), radius = r + thick / 2, stroke = color, strokeWidth = thick),
    clip = Rect(position = Vector(0, 0), anchor = Vector(0, 0), w = w, h = h),
  )
}

## 端から幕が寄せる / 引く切り替え
## @category 切り替え
## @param w 幅
## @param h 高さ
## @param progress 覆っている割合 0..1
## @param direction 幕が伸びてくる向き (:left :right :top :bottom。既定 :left)
## @param color 幕の色 (既定 黒)
## @returns 左上を (0, 0) とした w x h の Group。覆っていなければ中身は空
## @example
## comp.place("wipe", func (t) { wipe(16, 9, ease(t, 0s, 0.5s, 0, 1), :left) }, in = 0s, out = 0.5s)
export func wipe(w: Number, h: Number, progress: Number, direction: Symbol = :left, color: Color = #000000) -> Group {
  let k = math.clamp(progress, 0, 1)
  if k <= 0 { return Group() }
  let curtain = if direction == :right {
    Rect(position = Vector(w, 0), anchor = Vector(w * k, 0), w = w * k, h = h, fill = color)
  } else if direction == :top {
    Rect(position = Vector(0, 0), anchor = Vector(0, 0), w = w, h = h * k, fill = color)
  } else if direction == :bottom {
    Rect(position = Vector(0, h), anchor = Vector(0, h * k), w = w, h = h * k, fill = color)
  } else {
    Rect(position = Vector(0, 0), anchor = Vector(0, 0), w = w * k, h = h, fill = color)
  }
  Group(curtain)
}

## 一部を拡大した窓。source の at のあたりを zoom 倍で見せる
## @category 拡大
## @param source 拡大して見せる図形か Group
## @param at source の座標で、窓の真ん中に来る点
## @param zoom 拡大率
## @param w 窓の幅
## @param h 窓の高さ
## @param border 縁の色 (既定 白)
## @returns 左上を (0, 0) とした w x h の Group
## @example
## comp.place("lens", magnifier(page, Vector(4, 2), 3, 4, 3).copy(position = Vector(10, 1)), in = 0s, out = comp.duration)
export func magnifier(source: Group, at: Vector, zoom: Number, w: Number, h: Number, border: Color = #ffffff) -> Group {
  Group(
    Group(source, camera = Camera(from = at, to = Vector(w / 2, h / 2), scale = zoom), clip = Rect(position = Vector(0, 0), anchor = Vector(0, 0), w = w, h = h)),
    Rect(position = Vector(0, 0), anchor = Vector(0, 0), w = w, h = h, stroke = border, strokeWidth = math.min(w, h) * 0.02),
  )
}

## before と after を境目で分けて見せる
## @category 比べる
## @param before 左に出す Group。w x h の座標で描いておく
## @param after 右に出す Group。同じく w x h の座標
## @param position 境目の位置 0..1
## @param w 幅
## @param h 高さ
## @param handle 境目の線の色 (既定 白)
## @returns 左上を (0, 0) とした w x h の Group
## @example
## comp.place("compare", split_compare(a, b, 0.5, 16, 9), in = 0s, out = comp.duration)
export func split_compare(before: Group, after: Group, position: Number, w: Number, h: Number, handle: Color = #ffffff) -> Group {
  let k = math.clamp(position, 0, 1)
  let items = [before]
  if k < 1 {
    # after は元の位置のまま、右側だけ残るように切る
    items.push(Group(after, clip = Rect(position = Vector(w * k, 0), anchor = Vector(0, 0), w = w * (1 - k), h = h)))
  }
  items.push(Line(from = Vector(w * k, 0), to = Vector(w * k, h), stroke = handle, strokeWidth = w * 0.004))
  items.push(Circle(position = Vector(w * k, h / 2), radius = h * 0.04, fill = handle))
  Group(...items)
}

## エンドロール。offset で下から上へ流す
## @category 流す
## @param lines 流す行
## @param offset 0 で 1 行目が下端、1 で最後の行が上端を抜ける
## @param w 幅
## @param h 高さ
## @param fontSize 文字の大きさ (既定 高さの 1/12)
## @param color 文字の色 (既定 白)
## @returns 左上を (0, 0) とした w x h の Group
## @example
## comp.place("credits", func (t) { credits_roll(names, ease(t, 0s, 8s, 0, 1), 6, 9) }, in = 0s, out = 8s)
export func credits_roll(lines: List<String>, offset: Number, w: Number, h: Number, fontSize: Number = 0, color: Color = #ffffff) -> Group {
  let size = if fontSize > 0 { fontSize } else { h / 12 }
  let step = size * 1.8
  let total = step * lines.len()
  let wrap = w * 0.9
  # 行をまとめた 1 枚を上へ動かす。各行は上辺の真ん中を基準にする
  let rows = []
  for (i, line) in lines.enumerate() {
    rows.push(TextArea(position = Vector(w / 2, step * i), anchor = Vector(wrap / 2, 0), text = line, fontSize = size, w = wrap, fill = color, align = :center))
  }
  let top = h - offset * (h + total)
  Group(
    Group(...rows, position = Vector(0, top)),
    clip = Rect(position = Vector(0, 0), anchor = Vector(0, 0), w = w, h = h),
  )
}
