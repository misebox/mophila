# statement.moph — 制御構文 (すべて仮)

let n = 5

# if / else
if n > 3 {
  log("big")
} else if n > 1 {
  log("mid")
} else {
  log("small")
}

# for: 範囲
for i in 0..5 {          # 0, 1, 2, 3, 4
  log(i)
}
for i in 0..=5 {         # 0 〜 5
  log(i)
}

# for: リスト
let colors = [#e04040, #40a040, #4040e0]
for col in colors {
  let c = Circle(fill = col)
}

# for: インデックス付き
for (i, col) in colors.enumerate() {
  log("{i}: {col}".format(i, col))
}

# ブロックは値を返す (最後の式)
let size = if n > 3 { 1/2 } else { 1/4 }
