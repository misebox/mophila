# rows.moph — 時間 2: 毎フレーム式を評価する func。親の先端を読めば、つながった形が追いかける

import math
import { W, H, ink, dim, accent, blue, review, dwell, longer } from .theme
import { show, text, heading, card, outline, loop_func, demo, scene, add, say, close } from .slides
import { make, floor } from ..walker

func orbiter(life) {
  let b = Composition(box = Vector(4, 3), duration = life)
  b.place("bg", Rect(position = Vector(0, 0), anchor = Vector(0, 0), w = 4, h = 3, fill = #1b2130), in = 0s, out = life)
  b.place("track", Circle(position = Vector(2, 1.5), radius = 1.1, stroke = dim, strokeWidth = 0.03), in = 0s, out = life)
  b.place("ball", func (t) {
    let a = math.tau * t / 3s
    Circle(position = Vector(2 + 1.1 * math.cos(a), 1.5 + 1.1 * math.sin(a)), radius = 0.3, fill = blue)
  }, in = 0s, out = life)
  b
}

# 右の歩く人。箱 6 x 6 の左上を (x, y) に置く
func walker_at(x, y) {
  func (t) {
    make(ink, #8b93a7, t).copy(position = Vector(x, y))
  }
}

export func run(now) {
  log("rows", now)
  let sc = scene()
  add(sc, [heading("毎フレーム、式で決める")], now)
  # A: 円軌道
  let ta = now + 0.5s
  let a_card = card([
    "func (t) {",
    "  let a = math.tau * t / 3s",
    "  Circle(position = Vector(",
    "    2 + 1.1 * math.cos(a),",
    "    1.5 + 1.1 * math.sin(a)))",
    "}",
  ], 0.7, 1.8, 7.6, 0.28)
  let t = say(sc, "時刻を受け取る関数は、毎フレーム式を評価して、図形を作り直します。", ta)
  t = say(sc, "円軌道は、cos と sin の 1 行です。", t)
  let tb = t + 0.5s
  show(a_card, ta, tb)
  add(sc, [outline(9.9, 1.9, 5.2, 3.9)], ta)
  demo(orbiter(tb - ta), 10.0, 2.0, 5.0, ta, tb)
  # B: 歩く人の関節
  let b_card = card([
    "# 脛は腿の先端を、足は脛の先端を読む",
    "func (t) {",
    "  let hip = hip_at(t)",
    "  let knee = hip + direction(a1(t)) * 1.4",
    "  let ankle = knee + direction(a2(t)) * 1.3",
    "  let toe = ankle + direction(a3(t)) * 0.5",
    "  Group(Line(from = hip, to = knee),",
    "        Line(from = knee, to = ankle), ...)",
    "}",
  ], 0.7, 1.8, 7.6, 0.28)
  # ナレーションの長さを先に出し、その終わりまで歩かせる
  t = say(sc, "式の中で、親の先端の値も読めます。", tb)
  t = say(sc, "この人は、腰、腿、脛、足の順に、親の先端を読んでつながっています。", t)
  t = say(sc, "角度を sin で揺らすだけで、歩きになります。", t)
  let end = longer(t, tb + 14s)
  show(b_card, tb, end)
  loop_func(walker_at(9.8, 6.9 - 6), tb, end - tb, end)
  close(sc, end)
}
