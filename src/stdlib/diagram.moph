# diagram.moph — ものの関係を絵にする。線で結ぶ、ラベルを引き出す、表を出す
#
# どれも「その時点の状態」を受け取って View を返す。伸びる線は progress で長さを決める。
#
#   v.place(arrow(Vector(1, 1), Vector(5, 3)))

import math
import shape
import { gray, contrast } from color

## 2 点を結ぶ線。progress で from から伸びる
## @category 線
## @param from 始点
## @param to 終点
## @param progress 伸びる割合 0..1 (既定 1)
## @param color 線の色 (既定 濃い灰)
## @param width 線の太さ (既定 0.04)
## @returns 箱が from と to を含む View ではなく、置く側の座標で描く図形を持つ View
## @example
## v.place(connector(Vector(1, 1), Vector(5, 3)), at = Pos(0, 0, anchor = :topLeft), w = 8)
export func connector(from: Vector, to: Vector, progress: Number = 1, color: Color = #4a4f5a, width: Number = 0.04) -> Line {
  let k = math.clamp(progress, 0, 1)
  Line(from = from, to = from + (to - from) * k, stroke = color, strokeWidth = width)
}

## 矢印。線の先に三角が付く。軸と矢じりを合わせた 1 つの Polygon
## @category 線
## @param from 始点
## @param to 終点
## @param progress 伸びる割合 0..1 (既定 1)
## @param color 色 (既定 濃い灰)
## @param width 軸の太さ (既定 0.04)
## @param head 矢じりの長さ (既定 軸の太さの 5 倍)
## @returns Polygon。長さ 0 のときは点が空の Polygon
## @example
## v.place(arrow(Vector(1, 1), Vector(5, 3), 0.6, #e04040))
export func arrow(from: Vector, to: Vector, progress: Number = 1, color: Color = #4a4f5a, width: Number = 0.04, head: Number = 0) -> Polygon {
  let k = math.clamp(progress, 0, 1)
  let tip = from + (to - from) * k
  let d = tip - from
  let len = math.hypot(d.x, d.y)
  if len <= 0 { return Polygon(points = [], fill = color) }
  let hl = math.min(if head > 0 { head } else { width * 5 }, len)
  Polygon(points = shape.arrow_points(from, tip, width, hl), fill = color)
}

## 直角に曲がる線。フローチャートの枝分かれに使う
## @category 線
## @param from 始点
## @param to 終点
## @param progress 伸びる割合 0..1 (既定 1)
## @param color 色 (既定 濃い灰)
## @param width 線の太さ (既定 0.04)
## @param vertical true なら先に縦へ動く (既定 false)
## @returns Path
## @example
## v.place(elbow(Vector(1, 1), Vector(5, 3)), at = Pos(0, 0, anchor = :topLeft), w = 8)
export func elbow(from: Vector, to: Vector, progress: Number = 1, color: Color = #4a4f5a, width: Number = 0.04, vertical: Bool = false) -> Path {
  let corner = if vertical { Vector(from.x, to.y) } else { Vector(to.x, from.y) }
  let p = Path(from = from, segments = [(:line, corner), (:line, to)], stroke = color, strokeWidth = width)
  let k = math.clamp(progress, 0, 1)
  if k < 1 {
    let total = p.length()
    p.dash = [total, total]
    p.dashOffset = total * (1 - k)
  }
  p
}

## 対象から引き出した線と、その先のラベル。座標は置く先の View と同じ
## @category ラベル
## @param target 指す点
## @param text ラベルの文字
## @param offset ラベルを置く向きと距離
## @param w 置く先の View の幅
## @param h 置く先の View の高さ
## @param size 文字の大きさ (既定 0.3)
## @param color 線と文字の色 (既定 濃い灰)
## @returns 箱が w x h の View
## @example
## v.place(leader_label(Vector(4, 2), "ここ", Vector(1.5, -1), 16, 9), at = Pos(0, 0, anchor = :topLeft), w = 16)
export func leader_label(target: Vector, text: String, offset: Vector, w: Number, h: Number, size: Number = 0.3, color: Color = #4a4f5a) -> View {
  let v = View(box = Vector(w, h))
  let at = target + offset
  v.place(Line(from = target, to = at, stroke = color, strokeWidth = size * 0.1))
  v.place(Circle(position = Pos(target), radius = size * 0.18, fill = color))
  let anchor = if offset.x < 0 { :right } else { :left }
  let pad = if offset.x < 0 { -size * 0.3 } else { size * 0.3 }
  v.place(TextArea(position = Pos(at.x + pad, at.y, anchor = anchor), text = text, fontSize = size, fill = color))
  v
}

## 吹き出し。尾が指す向きは tail で決める
## @category ラベル
## @param text 中の文字
## @param w 幅
## @param h 高さ
## @param tail 尾の向き (:bottom :top :left :right。既定 :bottom)
## @param fill 背の色 (既定 #ffffff)
## @param size 文字の大きさ (既定 高さの 0.3)
## @returns 箱が w x (h + 尾) の View
## @example
## v.place(speech_bubble("こんにちは", 3, 1), at = Pos(1, 1, anchor = :topLeft), w = 3)
export func speech_bubble(text: String, w: Number, h: Number, tail: Symbol = :bottom, fill: Color = #ffffff, size: Number = 0) -> View {
  let fs = if size > 0 { size } else { h * 0.3 }
  let t = h * 0.22
  let v = View(box = Vector(w, h + t))
  v.place(Rect(position = Pos(0, 0, anchor = :topLeft), w = w, h = h, radius = h * 0.18, fill = fill))
  let tip = if tail == :left {
    [Vector(0, h * 0.45), Vector(-t, h * 0.6), Vector(0, h * 0.75)]
  } else if tail == :right {
    [Vector(w, h * 0.45), Vector(w + t, h * 0.6), Vector(w, h * 0.75)]
  } else if tail == :top {
    [Vector(w * 0.3, 0), Vector(w * 0.38, -t), Vector(w * 0.46, 0)]
  } else {
    [Vector(w * 0.3, h), Vector(w * 0.38, h + t), Vector(w * 0.46, h)]
  }
  v.place(Polygon(points = tip, fill = fill))
  v.place(TextArea(position = Pos(w / 2, h / 2), text = text, fontSize = fs, w = w * 0.86, fill = contrast(fill), align = :center))
  v
}

## ネットワーク図。ノードは (名前, 位置) の Dict、エッジは (名前, 名前) の組
## @category 関係
## @param nodes 名前 → 位置 (Vector)
## @param edges (名前, 名前) の並び
## @param w 幅
## @param h 高さ
## @param revealed 出すノードの数 (既定 全部)。エッジは両端が出ていれば出る
## @param color ノードの色 (既定 #4080e0)
## @param start 動き出す時刻 (既定 0s)
## @param duration 0s より長ければ、その長さで 1 つずつ出てくる (既定 0s = revealed のまま止まる)
## @returns 箱が w x h の View。duration があれば Timeline を持つので、置けば動く
## @example
## v.place(node_graph({ "a": Vector(1, 1), "b": Vector(3, 2) }, [("a", "b")], 4, 3, duration = 1s), at = Pos(1, 1, anchor = :topLeft), w = 4)
export func node_graph(nodes: Dict, edges: List<Tuple>, w: Number, h: Number, revealed: Number = -1, color: Color = #4080e0, duration: Duration = 0s, start: Duration = 0s) -> View {
  let v = View(box = Vector(w, h))
  let names = nodes.keys()
  let n = if duration > 0s { names.len() } else if revealed < 0 { names.len() } else { math.clamp(revealed, 0, names.len()) }
  let shown = names[0..n]
  let r = math.min(w, h) * 0.06
  let slot = if names.len() > 0 { duration / names.len() } else { duration }
  # ノードが出そろう順で、辺は遅い方の端に合わせて出す
  for (a, b) in edges {
    if shown.contains(a) and shown.contains(b) {
      let edge = Line(from = nodes[a], to = nodes[b], stroke = gray(180), strokeWidth = r * 0.25)
      v.place(edge)
      if duration > 0s {
        let at = slot * math.max(shown.index_of(a), shown.index_of(b))
        edge.opacity = 0
        v.addTrack(motion {
          at: edge.opacity = 0
          at + slot: edge.opacity = 1
        }, at = start)
      }
    }
  }
  for (i, name) in shown.enumerate() {
    let dot = Circle(position = Pos(nodes[name]), radius = r, fill = color)
    let label = TextArea(position = Pos(nodes[name].x, nodes[name].y + r * 1.5, anchor = :top), text = name, fontSize = r * 1.2, fill = gray(60), align = :center)
    v.place(dot)
    v.place(label)
    if duration > 0s {
      dot.opacity = 0
      label.opacity = 0
      v.addTrack(motion {
        slot * i: dot.opacity = 0, dot.radius = 0, label.opacity = 0
        slot * (i + 1): dot.opacity = 1, dot.radius = r, label.opacity = 1 :ease_out
      }, at = start)
    }
  }
  v
}

## 比較表。行を順に出せる
## @category 表
## @param headers 見出しの並び
## @param rows 各行の値 (見出しと同じ数)
## @param w 幅
## @param h 高さ
## @param revealed 出す行の数 (既定 全部)
## @param accent 見出しの背の色 (既定 薄い灰)
## @param start 動き出す時刻 (既定 0s)
## @param duration 0s より長ければ、その長さで 1 行ずつ出てくる (既定 0s = revealed のまま止まる)
## @returns 箱が w x h の View。duration があれば Timeline を持つので、置けば動く
## @example
## v.place(table(["名前", "値"], [["A", "3"], ["B", "7"]], 5, 2, duration = 1s), at = Pos(1, 1, anchor = :topLeft), w = 5)
export func table(headers: List<String>, rows: List<List<String>>, w: Number, h: Number, revealed: Number = -1, accent: Color = #e6e2da, duration: Duration = 0s, start: Duration = 0s) -> View {
  let v = View(box = Vector(w, h))
  let cols = headers.len()
  if cols == 0 { return v }
  let n = if duration > 0s { rows.len() } else if revealed < 0 { rows.len() } else { math.clamp(revealed, 0, rows.len()) }
  let slot = if rows.len() > 0 { duration / rows.len() } else { duration }
  let row_h = h / (rows.len() + 1)
  let col_w = w / cols
  let size = row_h * 0.45
  v.place(Rect(position = Pos(0, 0, anchor = :topLeft), w = w, h = row_h, fill = accent))
  for (i, head) in headers.enumerate() {
    v.place(TextArea(position = Pos(col_w * (i + 0.5), row_h / 2), text = head, fontSize = size, fill = #1a1d23, align = :center))
  }
  for r in 0..n {
    let y = row_h * (r + 1)
    let rule = Line(from = Vector(0, y), to = Vector(w, y), stroke = gray(215), strokeWidth = size * 0.05)
    v.place(rule)
    if duration > 0s { rule.opacity = 0 }
    for (c, cell) in rows[r].enumerate() {
      let text = TextArea(position = Pos(col_w * (c + 0.5), y + row_h / 2), text = cell, fontSize = size, fill = gray(50), align = :center)
      v.place(text)
      if duration > 0s {
        text.opacity = 0
        v.addTrack(motion {
          slot * r: text.opacity = 0
          slot * (r + 1): text.opacity = 1
        }, at = start)
      }
    }
    if duration > 0s {
      v.addTrack(motion {
        slot * r: rule.opacity = 0
        slot * (r + 1): rule.opacity = 1
      }, at = start)
    }
  }
  v
}
