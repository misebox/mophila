# blocks.moph — 等角のカメラで積み木を並べ、中心から広がる波で上下させる。
# 面の向きと光で陰を付け、面を奥の順に並べて重なりを決める (space3d の例)

import space3d
import math
import color

let len = 10s
let comp = Composition(box = Vector(16, 9), duration = len)
comp.place("bg", Rect(position = Vector(0, 0), anchor = Vector(0, 0), w = 16, h = 9, fill = #0f1420), in = 0s, out = len)

# 等角投影は視点を持たない。unit が 3D の 1 単位ぶんの箱の長さ
let cam = space3d.IsometricCamera(unit = 0.82, box = (16, 9))
let light = (0.55, 1, 0.3)
let base = #6ea8ff

# 床の格子は動かないので 1 度だけ投影する
let floor_lines = space3d.grid((0, 0, 0), 10.5, 10.5, 1.5).edges(cam).map(func (e) {
  Line(from = e[0], to = e[1], stroke = #22304d, strokeWidth = 0.025)
})
comp.place("floor", Group(...floor_lines), in = 0s, out = len)

let side = 5

# 積み木 1 つの見える面 (多くて 3 枚) を (奥行き, 多角形) の組にして返す
func faces_of(x, z, h) {
  space3d.box((x, h / 2, z), (1.05, h, 1.05)).faces(cam).map(func (f) {
    # 高いほど明るい色にしてから、面の向きで陰を付ける
    (f.depth, Polygon(points = f.points, fill = space3d.shade(color.mix(base, #a9e0ff, h / 2.3), f.normal, light), stroke = #0f1420, strokeWidth = 0.02))
  })
}

# 中心から外へ広がる波。高さだけ変えて、毎コマ全部の面を集めて奥から並べる
func wave(t) {
  let drawn = []
  for i in 0..side {
    for j in 0..side {
      let x = (i - (side - 1) / 2) * 1.5
      let z = (j - (side - 1) / 2) * 1.5
      let r = math.sqrt(x * x + z * z)
      let h = 0.4 + 1.9 * (0.5 + 0.5 * math.sin(math.tau * (t / len * 2 - r / 7)))
      for f in faces_of(x, z, h) {
        drawn.push(f)
      }
    }
  }
  # 積み木どうしの重なりは、面の奥行きで決める (遠いほど後ろ)
  Group(...drawn.sort_by(func (f) { -f[0] }).map(func (f) { f[1] }))
}
comp.place("blocks", wave, in = 0s, out = len)

output comp
