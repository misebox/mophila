# globe.moph — 回る球の上の点を 2D の円で打つ。面は描かず、3D の座標計算だけを使う。
# 奥行きで大きさ・明るさ・重なりの順を決めると、円だけで立体に見える (space3d の例)

import space3d
import color
import math

let len = 12s
let comp = Composition(box = Vector(16, 9), duration = len)
comp.place("bg", Rect(position = Vector(0, 0), anchor = Vector(0, 0), w = 16, h = 9, fill = #0a0e18), in = 0s, out = len)

let cam = space3d.PerspectiveCamera(from = (0, 1.6, 13), to = (0, 0, 0), fov = 0.6, box = (16, 9))
# 点だけ使うので、面の細かさは要らない
let ball = space3d.sphere((0, 0, 0), 3, 11, 22)
# 衛星の軌道。xz 平面に円を作って、傾けた折れ線にする
let round = []
for i in 0..=36 {
  let a = math.tau * i / 36
  round.push((4.2 * math.cos(a), 0, 4.2 * math.sin(a)))
}
let tilt = space3d.Transform3().rotate_z(0.42)
let ring = space3d.path(round).transformed(tilt)

let near = #a8ecff
let far = #1d3b6b

# 球の点・軌道の線・衛星を (奥行き, 図形) の組にして集め、奥から並べて 1 つの Group にする。
# 奥から描けば手前が上に乗る
func spin(t) {
  let turn = space3d.Transform3().rotate_y(t / len * math.tau).rotate_x(0.31)
  let drawn = []

  let moved = turn.apply_all(ball.points)
  # 投影と奥行きはまとめて出す (ループは Rust の中で回る)
  let flat = cam.project_all(moved)
  let deep = cam.depth_all(moved)
  for i in 0..moved.len() {
    # 手前が 1、奥が 0。球の直径ぶんで割る
    let k = (16.1 - deep[i]) / 6
    drawn.push((deep[i], Circle(position = flat[i], radius = 0.03 + 0.05 * k, fill = color.mix(far, near, k))))
  }

  # 軌道の線も同じ奥行きで並べる。折れ線なので、i 番目の線は i と i + 1 の間
  let spun = ring.transformed(turn)
  let rail_deep = cam.depth_all(spun.points)
  for (i, e) in spun.edges(cam).enumerate() {
    drawn.push(((rail_deep[i] + rail_deep[i + 1]) / 2, Line(from = e[0], to = e[1], stroke = #35507a, strokeWidth = 0.03)))
  }

  # 衛星は軌道の上を 3 周する。遠いと小さく見えるので、大きさは scale_at から
  let a = math.tau * (t / len * 3 % 1)
  let here = turn.apply(tilt.apply((4.2 * math.cos(a), 0, 4.2 * math.sin(a))))
  drawn.push((cam.depth(here), Circle(position = cam.project(here), radius = 0.09 * cam.scale_at(here), fill = #ffd98a)))

  Group(...drawn.sort_by(func (d) { -d[0] }).map(func (d) { d[1] }))
}
comp.place("globe", spin, in = 0s, out = len)

output comp
