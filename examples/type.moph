# type.moph — 型の一覧 (すべて仮)。examples/ に登場する型をすべて載せる

# ---- 基本型 ----
# 型名を呼ぶ形が実体で、リテラルはその短い書き方。両方書ける型は == で等しい
# Number    1  1.5  1/3  25% (= 0.25)。整数と実数を区別しない
# Duration  83s  1m23s  500ms  01:23  01:23:45.678
# Bool      true  false
# String    "hello"
# Symbol    :center  :linear    名前そのものが値
# Color     #e04040  #e04040cc  #e44 (= #ee4444)  #e448  Color(224, 64, 64)  Color(224, 64, 64, 1)
#           r/g/b 0..255, a 0..1
# Tuple     (1, 1.5)            = Tuple(1, 1.5)      要素ごとに型が違ってよい
# List      [1, 2, 3]           = List(1, 2, 3)      要素は同じ型
# Dict      { "red": #e04040 }  = Dict(red = #e04040)  キーは String
# Range     0..5                = Range(0, 5)        0..=5 は Range(0, 6)
# Func      func (x) { x }      下記
log([1, 2, 3] == List(1, 2, 3), { "a": 1 } == Dict(a = 1), (0..5) == Range(0, 5))

# ---- Func ----
# 型の表記: Func<引数の型... -> 戻り値の型>
let double: Func<Number -> Number> = func (x) { x * 2 }
let add:    Func<Number, Number -> Number> = func (a, b) { a + b }
let mk:     Func<Pos -> Circle> = func (p) { Circle(position = p) }
let noret:  Func<String -> Nothing> = func (s) { log(s) }
# 組み込みの log と type_of は、どの型でも受け取るので型を書けない

# ---- Module ----
# import で束縛される。標準ライブラリは math のみ
import math
# math:       Module
# math.PI / math.TAU / math.E:  Number
# math.sin:   Func<Number -> Number>   (cos, floor, ceil, abs, sqrt も同じ)
# math.max:   Func<Number... -> Number> (min も)

# ---- record と struct (ユーザー定義) ----
# record は値。書き換えられず、中身が同じなら等しい
record Size {
  w: Number
  h: Number
  method area(self) -> Number { self.w * self.h }
}
let s1 = Size(1, 2)           # 位置で渡す
let s2 = Size(w = 3, h = 4)   # 名前で渡す
log(s1, s1.w, s1.area(), s1 == Size(1, 2))   # Size(1, 2) 1 2 true
log(s1.copy(h = 9))                          # Size(1, 9)

# struct は実体。属性を書き換えられる
struct Counter {
  n: Number = 0
  private step: Number = 1
  func new(start: Number) -> Counter { Counter(n = start) }
  method next(self) -> Number {
    self.n = self.n + self.step
    self.n
  }
}
let c = Counter(10)
log(c.next(), c.next(), type_of(c))          # 11 12 Counter

# ---- Union 型 ----
# Shape (図形すべて)、Placeable (Shape | View)、Paint (Color | Shader | Gradient) は言語が持っている。
# 自分で作るときは type 名 = A | B。組み込みの型名では宣言できない
type Fill = Color | Gradient

# ---- 決まった値しか取らない型 ----
# 値はすべて Symbol。呼んでは作れない
# Ease         :linear :ease_in :ease_out :ease      motion の行末。値の変わり方
# Effect       :fade                                 motion の行末。区間の間の見え方
# Align        :left :center :right                  TextArea.align
# Anchor       :center :topLeft :topRight :bottomLeft :bottomRight :top :bottom :left :right
# StrokeCap    :butt :round :square                  線の端の形
# StrokeJoin   :miter :round :bevel                  線の角の形
# Blend        :normal :multiply :screen :overlay :darken :lighten :difference :add
# GradientKind :linear :radial :sweep

# ---- 位置 ----
# Vector  Vector(1, 1.5)   .x .y で参照できる
# Pos     Pos(1, 1.5)      x, y, anchor (既定 :center)。Pos(Vector(1, 1.5)) も同じ
#
# (1, 1.5) は Tuple であって Vector でも Pos でもない。
# ただし型が Vector か Pos と決まっている場所に書くと、その型に変換される
#   Line(from = (0, 0), to = (4, 3))   # from / to は Vector
#   Circle(position = (1, 2))          # position は Pos
#   Size((1, 2))                       # record のフィールドの型に合う Tuple
# 合わなければ TypeError。変換は型の決まった場所だけで、(1, 2) そのものは Tuple のまま
let pos = Pos(1, 1.5)
pos.anchor                                 # :center
pos.vector                                 # Vector(1, 1.5)
# 基準点の違う Pos 同士の変換には図形のサイズが要るので、place された後にしかできない

# ---- 図形 (Shape) ----
# 共通属性: fill: Color, stroke = Color, strokeWidth = Number, opacity = Number
let c = Circle(position = Pos(1, 1.5),   # Pos
  radius = 0.5,          # Number
  fill =   #e04040)

let r = Rect(position = Pos(0, 0, anchor = :topLeft),
  w = 1,                 # Number
  h = 1/2,               # Number
  radius = 0.1,          # Number。角の丸み。省略なら 0
  fill = #40a040,
  stroke = #000000,
  strokeWidth = 0.02)

let l = Line(from = Vector(0, 0),     # Vector
  to =   Vector(4, 3),     # Vector
  stroke = #000000,
  strokeWidth = 0.05)

let p = Polygon(points = [Vector(0, 0), Vector(1, 0), Vector(0.5, 1)],   # List<Vector>
  fill = #4040e0)

let t = TextArea(text = "hello",        # String
  position = Pos(0, 0, anchor = :topLeft),
  w = 2,                 # Number。幅に合わせて折り返す
  font = "Noto Sans JP", # String。フォントの指定方法は未決
  fontSize = 0.3,        # Number。箱の座標単位
  fill = #000000,
  align = :left,         # Align
)

# ---- 箱 ----
let v = View(box = Vector(4, 3))  # box: Vector。座標系 0..4 × 0..3。ピクセルは持たない
# v.place(target = Placeable) -> Nothing   (位置は target の position。w / h の扱いは未決)
# v.addTrack(t = Timeline) -> Nothing

# ---- 時間 ----
let m  = motion { 0s: 0, 1s: 1 }             # Motion。値の時間変化。対象なし
#   m.duration: Duration
#   m.apply(target = Shape, f = Func<Shape, Duration, List -> Nothing>) -> Timeline
let tl = m.apply(c, func (c, t, [x]) { c.radius = x })   # Timeline。対象 + 割り当て
let tr = Timeline(duration = 10s)      # Timeline。入れ物にもなる
#   tr.duration: Duration
#   tr.place(t = Timeline, at = Duration, fadeIn = Duration, fadeOut = Duration) -> Nothing

# ---- その他 ----
# Nothing   値を返さなかった関数の戻り値。書き方は無い
# Type      型そのもの。型名を書くとこの値になり、呼ぶとその型の値を作る
# Module    import が束縛するもの
log(type_of(log(1)), type_of(Circle), type_of(math))

# ---- 型の確認 ----
type_of(c)        # "Circle"
type_of(1s)       # "Duration"
type_of(1/3)      # "Number"
type_of(double)   # "Func<Number -> Number>"

log(type_of(add), type_of(m), type_of(tl), type_of(tr), type_of(v), type_of(t))
