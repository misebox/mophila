# diagram.moph — ものの関係を絵にする。線で結ぶ、ラベルを引き出す、表を出す
#
# どれも「その時点の状態」を受け取って、静的な Node を返す。伸びる線や出てくる行は progress / revealed で決める。
# 時間の流れ方は呼ぶ側が ease などで決める。
#
#   comp.place("arrow", arrow(Vector(1, 1), Vector(5, 3)), in = 0s, out = comp.duration)

import math
import shape
import { gray, contrast } from color

## 文字を、基準点を割合で指定して置く。TextArea の anchorRatio を使う
## @category ラベル
## @param t 置く TextArea
## @param x 置く場所の x (親の座標)
## @param y 置く場所の y (親の座標)
## @param ax 文字の幅のどこを x に合わせるか 0..1 (既定 0.5 = 中央。0 なら左端、1 なら右端)
## @param ay 文字の高さのどこを y に合わせるか 0..1 (既定 0.5 = 中央。0 なら上端、1 なら下端)
## @returns position と anchorRatio を決めた TextArea
## @example
## # 左端を (1, 2) に合わせる
## text_at(TextArea(text = "名前", fontSize = 0.4), 1, 2, 0, 0.5)
export func text_at(t: TextArea, x: Number, y: Number, ax: Number = 0.5, ay: Number = 0.5) -> TextArea {
  t.copy(position = Vector(x, y), anchorRatio = Vector(ax, ay))
}

## 2 点を結ぶ線。progress で from から伸びる
## @category 線
## @param from 始点
## @param to 終点
## @param progress 伸びる割合 0..1 (既定 1)
## @param color 線の色 (既定 濃い灰)
## @param width 線の太さ (既定 0.04)
## @returns Line。from と to は置く先の座標のまま
## @example
## comp.place("link", connector(Vector(1, 1), Vector(5, 3)), in = 0s, out = comp.duration)
export func connector(from: Vector, to: Vector, progress: Number = 1, color: Color = #4a4f5a, width: Number = 0.04) -> Line {
  let k = math.clamp(progress, 0, 1)
  Line(from = from, to = from + (to - from) * k, stroke = color, strokeWidth = width)
}

## 矢印。線の先に三角が付く。軸と矢じりを合わせた 1 つの Polygon
## @category 線
## @param from 始点
## @param to 終点
## @param progress 伸びる割合 0..1 (既定 1)
## @param color 色 (既定 濃い灰)
## @param width 軸の太さ (既定 0.04)
## @param head 矢じりの長さ (既定 軸の太さの 5 倍)
## @returns Polygon。長さ 0 のときは点が空の Polygon
## @example
## comp.place("arrow", arrow(Vector(1, 1), Vector(5, 3), 0.6, #e04040), in = 0s, out = comp.duration)
export func arrow(from: Vector, to: Vector, progress: Number = 1, color: Color = #4a4f5a, width: Number = 0.04, head: Number = 0) -> Polygon {
  let k = math.clamp(progress, 0, 1)
  let tip = from + (to - from) * k
  let d = tip - from
  let len = math.hypot(d.x, d.y)
  if len <= 0 { return Polygon(points = [], fill = color) }
  let hl = math.min(if head > 0 { head } else { width * 5 }, len)
  Polygon(points = shape.arrow_points(from, tip, width, hl), fill = color)
}

## 直角に曲がる線。フローチャートの枝分かれに使う
## @category 線
## @param from 始点
## @param to 終点
## @param progress 伸びる割合 0..1 (既定 1)
## @param color 色 (既定 濃い灰)
## @param width 線の太さ (既定 0.04)
## @param vertical true なら先に縦へ動く (既定 false)
## @returns Path
## @example
## comp.place("branch", elbow(Vector(1, 1), Vector(5, 3)), in = 0s, out = comp.duration)
export func elbow(from: Vector, to: Vector, progress: Number = 1, color: Color = #4a4f5a, width: Number = 0.04, vertical: Bool = false) -> Path {
  let corner = if vertical { Vector(from.x, to.y) } else { Vector(to.x, from.y) }
  Path(from = from, segments = [(:line, corner), (:line, to)], stroke = color, strokeWidth = width, upto = math.clamp(progress, 0, 1))
}

## 対象から引き出した線と、その先のラベル。座標は置く先と同じ
## @category ラベル
## @param target 指す点
## @param text ラベルの文字
## @param offset ラベルを置く向きと距離
## @param size 文字の大きさ (既定 0.3)
## @param color 線と文字の色 (既定 濃い灰)
## @returns Group。中の座標は置く先の座標のまま
## @example
## comp.place("note", leader_label(Vector(4, 2), "ここ", Vector(1.5, -1)), in = 0s, out = comp.duration)
export func leader_label(target: Vector, text: String, offset: Vector, size: Number = 0.3, color: Color = #4a4f5a) -> Group {
  let at = target + offset
  let pad = if offset.x < 0 { -size * 0.3 } else { size * 0.3 }
  let ax = if offset.x < 0 { 1 } else { 0 }
  Group(
    Line(from = target, to = at, stroke = color, strokeWidth = size * 0.1),
    Circle(position = target, radius = size * 0.18, fill = color),
    text_at(TextArea(text = text, fontSize = size, fill = color), at.x + pad, at.y, ax, 0.5)
  )
}

## 吹き出し。尾が指す向きは tail で決める
## @category ラベル
## @param text 中の文字
## @param w 幅
## @param h 高さ
## @param tail 尾の向き (:bottom :top :left :right。既定 :bottom)
## @param fill 背の色 (既定 #ffffff)
## @param size 文字の大きさ (既定 高さの 0.3)
## @returns Group。本体の左上が (0, 0) で、尾は本体の外にはみ出す
## @example
## comp.place("bubble", speech_bubble("こんにちは", 3, 1).copy(position = Vector(1, 1)), in = 0s, out = comp.duration)
export func speech_bubble(text: String, w: Number, h: Number, tail: Symbol = :bottom, fill: Color = #ffffff, size: Number = 0) -> Group {
  let fs = if size > 0 { size } else { h * 0.3 }
  let t = h * 0.22
  let tip = if tail == :left {
    [Vector(0, h * 0.45), Vector(-t, h * 0.6), Vector(0, h * 0.75)]
  } else if tail == :right {
    [Vector(w, h * 0.45), Vector(w + t, h * 0.6), Vector(w, h * 0.75)]
  } else if tail == :top {
    [Vector(w * 0.3, 0), Vector(w * 0.38, -t), Vector(w * 0.46, 0)]
  } else {
    [Vector(w * 0.3, h), Vector(w * 0.38, h + t), Vector(w * 0.46, h)]
  }
  Group(
    Rect(anchor = Vector(0, 0), w = w, h = h, radius = h * 0.18, fill = fill),
    Polygon(points = tip, fill = fill),
    TextArea(position = Vector(w / 2, h / 2), text = text, fontSize = fs, w = w * 0.86, fill = contrast(fill), align = :center)
  )
}

## ネットワーク図。ノードは (名前, 位置) の Dict、エッジは (名前, 名前) の組
## @category 関係
## @param nodes 名前 → 位置 (Vector)
## @param edges (名前, 名前) の並び
## @param w 幅
## @param h 高さ
## @param revealed 出ているノードの数 (既定 全部)。小数なら最後のノードが途中まで出る。エッジは遅い方の端に合わせて出る
## @param color ノードの色 (既定 #4080e0)
## @returns Group。nodes の座標のまま。w と h は点の大きさの基準
## @example
## comp.place("graph", node_graph({ "a": Vector(1, 1), "b": Vector(3, 2) }, [("a", "b")], 4, 3, revealed = 1.5), in = 0s, out = comp.duration)
export func node_graph(nodes: Dict, edges: List<Tuple>, w: Number, h: Number, revealed: Number = -1, color: Color = #4080e0) -> Group {
  let names = nodes.keys()
  let shown = if revealed < 0 { names.len() } else { revealed }
  let r = math.min(w, h) * 0.06
  let items = []
  for (a, b) in edges {
    let k = math.clamp(shown - math.max(names.index_of(a), names.index_of(b)), 0, 1)
    if k > 0 {
      items.push(Line(from = nodes[a], to = nodes[b], stroke = gray(180), strokeWidth = r * 0.25, opacity = k))
    }
  }
  for (i, name) in names.enumerate() {
    let k = math.clamp(shown - i, 0, 1)
    if k > 0 {
      items.push(Circle(position = nodes[name], radius = r * k, fill = color, opacity = k))
      items.push(text_at(TextArea(text = name, fontSize = r * 1.2, fill = gray(60), align = :center, opacity = k), nodes[name].x, nodes[name].y + r * 1.5, 0.5, 0))
    }
  }
  Group(...items)
}

## 比較表。行を順に出せる
## @category 表
## @param headers 見出しの並び
## @param rows 各行の値 (見出しと同じ数)
## @param w 幅
## @param h 高さ
## @param revealed 出ている行の数 (既定 全部)。小数なら最後の行が途中まで出る
## @param accent 見出しの背の色 (既定 薄い灰)
## @returns Group。左上が (0, 0) で w x h
## @example
## comp.place("table", table(["名前", "値"], [["A", "3"], ["B", "7"]], 5, 2, revealed = 1.5).copy(position = Vector(1, 1)), in = 0s, out = comp.duration)
export func table(headers: List<String>, rows: List<List<String>>, w: Number, h: Number, revealed: Number = -1, accent: Color = #e6e2da) -> Group {
  let cols = headers.len()
  if cols == 0 { return Group() }
  let shown = if revealed < 0 { rows.len() } else { revealed }
  let row_h = h / (rows.len() + 1)
  let col_w = w / cols
  let size = row_h * 0.45
  let items = [Rect(anchor = Vector(0, 0), w = w, h = row_h, fill = accent)]
  for (i, head) in headers.enumerate() {
    items.push(TextArea(position = Vector(col_w * (i + 0.5), row_h / 2), text = head, fontSize = size, fill = #1a1d23, align = :center))
  }
  for (r, row) in rows.enumerate() {
    let k = math.clamp(shown - r, 0, 1)
    if k > 0 {
      let y = row_h * (r + 1)
      items.push(Line(from = Vector(0, y), to = Vector(w, y), stroke = gray(215), strokeWidth = size * 0.05, opacity = k))
      for (c, cell) in row.enumerate() {
        items.push(TextArea(position = Vector(col_w * (c + 0.5), y + row_h / 2), text = cell, fontSize = size, fill = gray(50), align = :center, opacity = k))
      }
    }
  }
  Group(...items)
}
