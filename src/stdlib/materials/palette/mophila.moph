# mophila.moph — mophila 自身の色

import { Palette } from .palette

## mophila のロゴの色。i の点の橙が accent、ロゴの青は series の 2 色目。本文はクリーム色に合う暖かい黒
## @category 明るい
## @type {Palette} 1 つの配色
export let MOPHILA = Palette(
  back = #f8f4ed,
  ink = #26221e,
  sub = #8a8177,
  line = #d8d2c6,
  accent = #f0883a,
  track = #ebe5d9,
  # ロゴの橙と青だけで 5 色。橙は暗くすると土色になるので明るい側へ、暗い側は青で作る
  series = [#f0883a, #2f6fb5, #1a4a80, #7ea6d5, #f5b07f],
)
