# slides.moph — intro の場面を組む部品。基本形は「左にコード、右にそれが動く箱、下にナレーションの字幕」

import math
import { W, H, layers, ink, dim, panel, line, accent, mono, fade_time, stagger, chapter_time, review, pause, dwell, longer } from .theme

# Layer を積む。Composition に置くのは main
export func put(node, at, end) {
  layers.push((node, at, end))
}

func still(o) {
  func (t) { o }
}

# f(t) を、at から end の間だけ見せる。s はこの Layer の始まり。端でフェードする
func fading(f, s, at, end) {
  func (t) {
    let g = s + t
    f(t).copy(opacity = ease(g, at, at + fade_time, 0, 1) * ease(g, end - fade_time, end, 1, 0))
  }
}

# 時刻 t から図形を返す func を、at から end まで見せる
export func show_func(f, at, end) {
  put(fading(f, at, at, end), at, end)
}

# at から end まで見せる。end の時点で消え終わる
export func show(objs, at, end) {
  for (i, o) in objs.enumerate() {
    let start = at + i * stagger
    put(fading(still(o), start, start, end), start, end)
  }
}

# side は :center :left :right。x, y に文字のどこを置くか
export func text(s, x, y, size, color, side) {
  let t = TextArea(text = s, position = Vector(x, y), fontSize = size, fill = color, align = :center)
  let box = t.size()
  if side == :left {
    return t.copy(anchor = Vector(0, box.y / 2))
  }
  if side == :right {
    return t.copy(anchor = Vector(box.x, box.y / 2))
  }
  t
}

export func heading(s) { text(s, W / 2, 0.95, 0.66, accent, :center) }

# コードのカード。高さは行数から。戻り値は図形の List
export func card(lines, x, y, w, size) {
  let lh = size * 1.6
  let h = lines.len() * lh + size * 1.2
  let objs = [Rect(position = Vector(x, y), anchor = Vector(0, 0), w = w, h = h, radius = 0.15, fill = panel, stroke = line, strokeWidth = 0.04)]
  for (i, s) in lines.enumerate() {
    objs.push(TextArea(text = s, position = Vector(x + size * 0.8, y + size * 0.6 + i * lh), anchor = Vector(0, 0), fontSize = size, fill = mono, align = :left))
  }
  objs
}

# 線だけの枠
export func outline(x, y, w, h) {
  Rect(position = Vector(x, y), anchor = Vector(0, 0), w = w, h = h, radius = 0.15, stroke = line, strokeWidth = 0.04)
}

# 別の Composition を、左上 (x, y)、幅 w の箱として置く
export func scaled(sub, x, y, w) {
  sub.copy(position = Vector(x, y), anchor = Vector(0, 0), scale = w / sub.box.x)
}

# f(t) を at から every ごとに t = 0 から置き直して end まで繰り返す。全体で 1 度だけフェードする
export func loop_func(f, at, every, end) {
  let n = math.ceil((end - at) / every)
  for i in 0..n {
    let s = at + i * every
    let stop = if s + every < end { s + every } else { end }
    put(fading(f, s, at, end), s, stop)
  }
}

# 別の Composition を箱として置き、at から end まで動かす。every ごとに最初から
export func loop_demo(sub, x, y, w, at, every, end) {
  loop_func(still(scaled(sub, x, y, w)), at, every, end)
}

# 別の Composition を箱として置き、at から end まで 1 度だけ動かす
export func demo(sub, x, y, w, at, end) {
  loop_demo(sub, x, y, w, at, end - at, end)
}

# 場面: 出したものと字幕を覚えておき、終わりが決まったら一斉に置く。字幕は同時に 1 つ
export func scene() { { "items": [], "captions": [] } }
export func add(sc, objs, at) { sc["items"].push((objs, at)) }
# ナレーション 1 行。読む時間と間を空けた、次の行を出せる時刻を返す
export func say(sc, s, at) {
  sc["captions"].push((s, at))
  at + dwell(s) + 0.6s
}
export func close(sc, end) {
  for (objs, at) in sc["items"] { show(objs, at, end) }
  let caps = sc["captions"]
  for (i, c) in caps.enumerate() {
    let (s, at) = c
    let stop = end
    if i + 1 < caps.len() {
      let (next_s, next_at) = caps[i + 1]
      stop = next_at
    }
    put(Narration(text = s), at, stop)
  }
  end + pause
}

export func chapter(title, at) {
  let t = text(title, W / 2, 4.2, 0.95, ink, :center)
  let bar = Rect(position = Vector(W / 2, 5.25), w = 3.2, h = 0.06, fill = accent)
  show([t, bar], at, at + chapter_time)
  at + chapter_time + pause
}
