# group.moph — 図形をまとめる。中の座標は Group の position からの相対

let v = View(box = Vector(16, 9))

# 属性でない引数が中身。書いた順に描く。名前を付けた中身は、その名前で読める
let badge = Group(
  ring   = Circle(position = Pos(0, 0), radius = 1.4, fill = #2f6fd0),
  square = Rect(position = Pos(0, 0), w = 1.2, h = 1.2, fill = #ffb583),
  position = Pos(2, 4.5),
)
v.place(badge)
badge.ring.fill = #1d4f9c
log(badge.square.w)

# Group の中に Group。原点は外側から順に足される
let pair = Group(
  Group(Circle(position = Pos(0, 0), radius = 0.5, fill = #d9552c), position = Pos(-1, 0)),
  Group(Circle(position = Pos(0, 0), radius = 0.5, fill = #2f6fd0), position = Pos(1, 0)),
  position = Pos(8, 1.5),
  opacity = 0.5,          # 中身をまとめて 1 枚として薄くする
)
v.place(pair)

# 後から足す
let row = Group(position = Pos(4, 7.5))
for i in 0..5 {
  row.place(Circle(position = Pos(i * 2, 0), radius = 0.4, fill = #7d90ad))
}
v.place(row)

# Group を動かせば中身ごと動く。中の図形は別々に動かせる
let move = motion (t) {
  0s:  badge.position = Pos(2, 4.5), pair.rotation = 0, badge.square.rotation = 0
  4s:  badge.position = Pos(14, 4.5), pair.rotation = 180, badge.square.rotation = 90
}
let track = Timeline()
track.place(move)
v.addTrack(track)
output v
