# media.moph — 音声と画像 (すべて仮)。音声は Timeline に置き、render が動画のトラックにする

let v = View(box = Vector(4, 3))
let track = Timeline()

# ---- 音声。.moph 以外のファイルを import すると Audio か Image になる (拡張子で決まる) ----
import "../gallery/mophila_intro/QuietSignal.m4a" as bgm
import "sample.png" as pic              # 画像 (png jpg gif webp bmp tiff)
log(type_of(bgm), bgm.duration, bgm.file)         # Audio 152.52s ../gallery/mophila_intro/QuietSignal.m4a

track.place(bgm, at = 0s, fadeIn = 1s, duration=5s, fadeOut = 2s)   # 動画の終わりまで繰り返す (動画は延びない)
track.place(bgm, at = 0.5s, duration = 5s, volume = 0.6)                                        # 3 秒から 5 秒分だけ (重ねて鳴る)

# ---- 読み上げ。音声と字幕になる。書き方は voice.moph ----
track.place(Narration(text = "最初の行", duration = 3s), at = 1s)

# ---- 画像。図形の fill に入れると、その形に切り抜いて敷かれる ----
log(pic.file, pic.width, pic.height)      # import に書いたパスと、元のピクセル数
v.place(Rect(position = Pos(0.2, 0.2, anchor = :topLeft), w = 1.6, h = 1, fill = pic))
v.place(Circle(position = Pos(3, 2), radius = 0.8, fill = pic))   # 丸く切り抜く

# 動画の長さは置いたものの終わりで決まる (loop でない曲が長ければ曲の終わりまで)
v.addTrack(track)
output v

# render は音声を混ぜて (adelay / amix / afade) 動画に付ける。preview でも鳴り、字幕は画面の下に重ねて出る
# bundle は import した音声も埋め込む
