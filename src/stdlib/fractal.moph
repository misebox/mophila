# fractal.moph — エスケープタイム系フラクタルの部品。反復式・精度・色付けを関数で差し替える。
# escape_time(...) が Shader を返すので、図形の fill に入れて使う。
#   formula:   反復式 (mandelbrot / burning_ship / multibrot(n) / julia(c))
#   precision: :plain (32 bit のまま反復) か :perturbation (基準軌道をここで 64 bit で計算し、GPU は差分だけ反復)
#   coloring:  func (mu, z) -> Color。mu は滑らかな脱出回数 (集合の中は -1)、z は脱出時の値
#   center / span: 複素平面の中心と、最初に見える横幅。zoom: func (t) -> 倍率。max_iter: func (zoom) -> 反復の上限
#   at / box:  塗る図形が占める箱の座標 (既定は (0, 0) から 16 x 9)。flip: true で虚軸を下向きにする (Burning Ship の慣習)

import math

# julia の定数。1 つの Vector か、時刻から Vector を返す関数
type JuliaConstant = Vector | (Number) -> Vector

## エスケープタイム系フラクタルの Shader を作る。図形の fill に入れる
## @category 描く
## @param formula 反復式 (mandelbrot / julia(c) / burning_ship / multibrot(n))
## @param coloring 色付け。func (mu, z) -> Color (smooth など)
## @param center 複素平面の中心 (Vector)
## @param span 最初に見える横幅 (複素平面の単位)
## @param precision plain か perturbation
## @param zoom 倍率の時間変化。func (t) -> Number
## @param max_iter 反復の上限。func (zoom) -> Number
## @param samples 1 ピクセルあたりの評価点の数 (4 で 2x2 のアンチエイリアス)
## @param at 塗る図形の左上 (箱の座標)
## @param box 塗る図形の大きさ (箱の座標)
## @param flip true で虚軸を下向きにする
## @param bailout 脱出とみなす |z|² の閾値
## @param ref_iter 基準軌道の長さの上限
## @returns 図形の fill に入れる
## @example
## import { escape_time, mandelbrot, smooth } from fractal
##
## let set = escape_time(
##   formula = mandelbrot,
##   coloring = smooth([#061a3f, #5c9be6, #ffffff, #061a3f], 48),
##   center = Vector(-0.743, 0.126),
##   span = 0.02,
## )
## v.place(Rect(position = Pos(0, 0, anchor = :topLeft), w = 16, h = 9, fill = set))
export func escape_time(formula: Dict, coloring: (Number, Vector) -> Color, center: Vector, span: Number, precision: Symbol = :perturbation, zoom: (Number) -> Number = func (t) { 1 }, max_iter: (Number) -> Number = func (zoom) { 200 }, samples: Number = 1, at: Vector = Vector(0, 0), box: Vector = Vector(16, 9), flip: Bool = false, bailout: Number = 256, ref_iter: Number = 8000) -> Shader {
  let seed = formula["seed"]
  let step = formula["step"]
  let start = formula["start"]
  let ln_degree = math.ln(formula["degree"])
  let param = if formula.has("param") { formula["param"] } else { func (t) { Vector(0, 0) } }
  let limit_of = max_iter
  let zoom_of = zoom
  # ピクセルの箱の座標 → 中心からの複素座標の差
  let up = if flip { 1 } else { -1 }
  func offset(x: Number, y: Number, zm: Number) -> Vector {
    let scale = span / zm / box.x
    Vector((x - at.x - box.x / 2) * scale, (y - at.y - box.y / 2) * scale * up)
  }
  # 滑らかな脱出回数
  func escaped(n: Number, r2: Number) -> Number { n + 1 - math.ln(math.ln(r2) / 2) / ln_degree }

  if precision == :plain {
    return Shader(samples = samples,
      color = func (x, y, t) {
        let zm = zoom_of(t)
        let k = param(t)
        let p = center + offset(x, y, zm)
        let z = seed(p, k)
        let limit = limit_of(zm)
        for n in 0..limit {
          let r2 = cabs2(z)
          if r2 > bailout { return coloring(escaped(n, r2), z) }
          z = step(z, p, k)
        }
        coloring(-1, z)
      })
  }
  if precision != :perturbation {
    log("escape_time: precision must be :plain or :perturbation")
  }
  if not formula.has("delta") {
    log("escape_time: this formula has no delta; use precision: :plain")
  }
  let delta = formula["delta"]
  # 基準軌道 (中心の点の軌道) を 64 bit で。[re, im, re, im, ...]。脱出したらそこまで
  let k0 = param(0)
  func reference() -> List<Number> {
    let orbit = []
    let Z = seed(center, k0)
    for n in 0..ref_iter {
      orbit.push(Z.x)
      orbit.push(Z.y)
      if cabs2(Z) > bailout { return orbit }
      Z = step(Z, center, k0)
    }
    orbit
  }
  let orbit = reference()
  let ref_len = orbit.len() / 2
  Shader(samples = samples,
    args = orbit,
    color = func (x, y, t, ref) {
      let zm = zoom_of(t)
      let k = param(t)
      let dp = offset(x, y, zm)
      let limit = limit_of(zm)
      let d = start(dp)
      let m = 0
      for n in 0..limit {
        let Z = Vector(ref[2 * m], ref[2 * m + 1])
        let z = Z + d
        let r2 = cabs2(z)
        if r2 > bailout { return coloring(escaped(n, r2), z) }
        # z が差分より小さくなったら、基準を先頭に戻して差分 = z から数え直す (基準が尽きたときも)
        if r2 < cabs2(d) or m + 1 >= ref_len {
          d = z
          m = 0
          Z = Vector(ref[0], ref[1])
        }
        d = delta(Z, d, dp, k)
        m = m + 1
      }
      coloring(-1, Vector(0, 0))
    })
}

# Dict で表す。p はピクセルの複素座標、k は param(t) (Julia の c など)、Z は基準軌道、d は差分、dp は中心からの差
#   seed(p, k): 最初の z / step(z, p, k): 次の z / start(dp): 差分の初期値 / delta(Z, d, dp, k): 差分の次の値 / degree: 次数
## Mandelbrot 集合の反復式 z' = z² + p。z は 0 から始まり、p がピクセルの複素座標。
## escape_time の formula に渡す。摂動法にも対応している
## @category 反復式
## @type {Dict} 反復式
## @example
## escape_time(formula = mandelbrot, coloring = coloring, center = Vector(-0.5, 0), span = 3)
export let mandelbrot = {
  "seed": func (p, k) { Vector(0, 0) },
  "step": func (z, p, k) { cmul(z, z) + p },
  "start": func (dp) { Vector(0, 0) },
  "delta": func (Z, d, dp, k) { cmul(Z, d) * 2 + cmul(d, d) + dp },
  "degree": 2,
}

## Julia 集合の反復式 z' = z² + c を作る。z はピクセルの複素座標から始まり、c は全ピクセルで共通。
## escape_time の formula に渡す
## @category 反復式
## @param c 定数。Vector か、時刻から Vector を返す func (t)。摂動法は c が一定のときだけ正しい
## @returns 反復式
## @example
## # c を固定する
## escape_time(formula = julia(Vector(-0.8, 0.156)), coloring = coloring, center = Vector(0, 0), span = 3.6)
##
## # c を時刻で動かすと、形が移り変わる
## julia(func (t) { Vector(0.7885 * math.cos(t), 0.7885 * math.sin(t)) })
export func julia(c: JuliaConstant) -> Dict {
  let param = if type_of(c) == "Func" { c } else { func (t) { c } }
  {
    "seed": func (p, k) { p },
    "step": func (z, p, k) { cmul(z, z) + k },
    "start": func (dp) { dp },
    "delta": func (Z, d, dp, k) { cmul(Z, d) * 2 + cmul(d, d) },
    "degree": 2,
    "param": param,
  }
}

## Burning Ship の反復式 z' = (|Re z| + i|Im z|)² + p。実部と虚部の絶対値を取ってから 2 乗する。
## escape_time の formula に渡す。escape_time に flip: true を付けると、慣習どおり船が上を向く
## @category 反復式
## @type {Dict} 反復式
## @example
## escape_time(formula = burning_ship, coloring = coloring, center = Vector(-1.75, -0.03), span = 0.2, flip = true)
export let burning_ship = {
  "seed": func (p, k) { Vector(0, 0) },
  "step": func (z, p, k) {
    let a = Vector(math.abs(z.x), math.abs(z.y))
    cmul(a, a) + p
  },
  "start": func (dp) { Vector(0, 0) },
  "delta": func (Z, d, dp, k) {
    let a = Vector(math.abs(Z.x), math.abs(Z.y))
    let e = Vector(diffabs(Z.x, d.x), diffabs(Z.y, d.y))
    cmul(a, e) * 2 + cmul(e, e) + dp
  },
  "degree": 2,
}

## Multibrot の反復式 z' = z^n + p を作る。n が 2 なら Mandelbrot と同じで、大きいほど腕の数が増える。
## escape_time の formula に渡す
## @category 反復式
## @param n 次数。2 以上の整数
## @returns 反復式
## @example
## # 腕が 3 本
## escape_time(formula = multibrot(3), coloring = coloring, center = Vector(0, 0), span = 3)
export func multibrot(n: Number) -> Dict {
  {
    "seed": func (p, k) { Vector(0, 0) },
    "step": func (z, p, k) { cpow(z, n) + p },
    "start": func (dp) { Vector(0, 0) },
    "delta": func (Z, d, dp, k) {
      # (Z + d)^n - Z^n = Σ C(n, j) Z^(n-j) d^j  (j = 1..n)
      let sum = Vector(0, 0)
      for j in 1..=n { sum = sum + cmul(cpow(Z, n - j), cpow(d, j)) * binom(n, j) }
      sum + dp
    },
    "degree": n,
  }
}

## GPU の 32 bit のまま反復する。escape_time の precision に渡す。
## 数万倍あたりまでなら、これで足りる
## @category 精度
## @type {Symbol} 精度の選び方
## @example
## escape_time(formula = mandelbrot, coloring = coloring, center = Vector(0, 0), span = 3, precision = plain)
export let plain = :plain
## 中心の点の軌道をスクリプト側の 64 bit で計算し、GPU はそこからの差分だけ反復する (摂動法)。
## escape_time の precision に渡す。10 兆倍あたりまで寄れる
## @category 精度
## @type {Symbol} 精度の選び方
## @example
## # 既定はこちら。深く寄るときに要る
## escape_time(formula = mandelbrot, coloring = coloring, center = deep, span = 1e-9, precision = perturbation)
export let perturbation = :perturbation

## 脱出の速さから色を決める関数を作る。stops を period 回の反復ごとに 1 周する。
## escape_time の coloring に渡す
## @category 色付け
## @param stops Color の List。最初と最後を同じ色にすると継ぎ目が出ない
## @param period 何回の反復で 1 周するか
## @param inside 集合の中の色 (既定は黒)
## @returns 色付け
## @example
## # 48 回の反復で 1 周する色。最初と最後が同じ色なので継ぎ目が出ない
## let coloring = smooth([#061a3f, #5c9be6, #ffffff, #061a3f], 48, inside = #061a3f)
export func smooth(stops: List<Color>, period: Number, inside: Color = #000000) -> (Number, Vector) -> Color {
  let last = stops.len() - 1
  func (mu, z) {
    if mu < 0 { return inside }
    let p = (mu / period) % 1 * last
    let i = math.floor(p)
    let u = p - i
    stops[i] * (1 - u) + stops[i + 1] * u
  }
}

## 複素数の積。複素数は Vector (x が実部、y が虚部)
## @category 複素数
## @param a 複素数 (x が実部、y が虚部)
## @param b 複素数
## @returns 積
## @example
## cmul(Vector(0, 1), Vector(0, 1))   # Vector(-1, 0) — i × i = -1
export func cmul(a: Vector, b: Vector) -> Vector { Vector(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x) }
## 複素数の絶対値の 2 乗
## @category 複素数
## @param z 複素数
## @returns |z|²
## @example
## cabs2(Vector(3, 4))   # 25
export func cabs2(z: Vector) -> Number { z.x * z.x + z.y * z.y }
func cpow(z: Vector, n: Number) -> Vector {
  let r = Vector(1, 0)
  for i in 0..n { r = cmul(r, z) }
  r
}
# 二項係数 C(n, j)
func binom(n: Number, j: Number) -> Number {
  let r = 1
  for i in 0..j { r = r * (n - i) / (i + 1) }
  r
}
# |c + d| - |c| を桁落ちなしで
func diffabs(c: Number, d: Number) -> Number {
  if c >= 0 {
    if c + d >= 0 { return d }
    return -(2 * c + d)
  }
  if c + d <= 0 { return -d }
  2 * c + d
}
