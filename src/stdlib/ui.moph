# ui.moph — 画面の絵。スマホ、ブラウザ、ターミナル、通知などの枠
#
# 中身を入れる枠は Group を受け取り、枠の中の左上に置いて、画面の外にはみ出した分を切る。
# 中身は画面の左上を (0, 0) とした座標で作る。画面の大きさは各関数の説明に書いてある。
# 行や吹き出しを順に出す部品は revealed で「今いくつ出ているか」を受け取る。時間の流れ方は呼ぶ側が ease などで決める。
#
#   let page = Group(Rect(anchor = Vector(0, 0), w = 10, h = 5.2, fill = #cfe0f5))
#   comp.place("browser", browser(page, "example.com", 10, 6).copy(position = Vector(3, 1)), in = 0s, out = comp.duration)

import math
import { gray, alpha, contrast } from color
import { ring_segment } from shape
import { text_at } from diagram

## スマホの枠。content を画面の中に置く
## @category 枠
## @param content 画面に映すもの。画面の左上が (0, 0)。画面は幅 w * 0.91、高さ h - w * 0.09。大きさが合わなければ Group(page, scale = k) で包んで合わせる
## @param w 枠の幅
## @param h 枠の高さ
## @param body 枠の色 (既定 ほぼ黒)
## @param screen 中身の後ろの色 (既定 白)
## @returns Group。左上が (0, 0) で w x h
## @example
## comp.place("phone", phone(page, 3, 6).copy(position = Vector(1, 1)), in = 0s, out = comp.duration)
export func phone(content: Group, w: Number, h: Number, body: Color = #1a1d23, screen: Color = #ffffff) -> Group {
  let edge = w * 0.045
  Group(
    Rect(anchor = Vector(0, 0), w = w, h = h, radius = w * 0.13, fill = body),
    Rect(position = Vector(edge, edge), anchor = Vector(0, 0), w = w - edge * 2, h = h - edge * 2, radius = w * 0.09, fill = screen),
    Rect(position = Vector(w / 2, edge * 1.6), anchor = Vector(w * 0.17, 0), w = w * 0.34, h = edge * 1.4, radius = edge * 0.7, fill = body),
    Group(content, position = Vector(edge, edge), clip = Rect(anchor = Vector(0, 0), w = w - edge * 2, h = h - edge * 2))
  )
}

## ブラウザのウィンドウ。上に url の帯が付く
## @category 枠
## @param content ウィンドウに映すもの。ページの左上が (0, 0)。ページは幅 w、高さ h - min(h * 0.12, w * 0.07)。大きさが合わなければ Group(page, scale = k) で包んで合わせる
## @param url 帯に出す文字
## @param w ウィンドウの幅
## @param h ウィンドウの高さ
## @param chrome 帯の色 (既定 薄い灰)
## @param page 中身の後ろの色 (既定 白)
## @returns Group。左上が (0, 0) で w x h
## @example
## comp.place("browser", browser(page, "example.com", 10, 6).copy(position = Vector(3, 1)), in = 0s, out = comp.duration)
export func browser(content: Group, url: String, w: Number, h: Number, chrome: Color = #e6e2da, page: Color = #ffffff) -> Group {
  let bar = math.min(h * 0.12, w * 0.07)
  let r = bar * 0.16
  let left = bar * 0.5 + r * 8
  let items = [
    Rect(anchor = Vector(0, 0), w = w, h = h, radius = bar * 0.3, fill = chrome),
    Rect(position = Vector(0, bar), anchor = Vector(0, 0), w = w, h = h - bar, fill = page),
  ]
  for (i, c) in [#e05c4a, #e0b23a, #4aa863].enumerate() {
    items.push(Circle(position = Vector(bar * 0.5 + i * r * 3, bar / 2), radius = r, fill = c))
  }
  items.push(Rect(position = Vector(left, bar * 0.2), anchor = Vector(0, 0), w = w - left - bar * 0.5, h = bar * 0.6, radius = bar * 0.3, fill = #ffffff))
  items.push(text_at(TextArea(text = url, fontSize = bar * 0.36, fill = gray(90)), left + bar * 0.35, bar / 2, 0, 0.5))
  items.push(Group(content, position = Vector(0, bar), clip = Rect(anchor = Vector(0, 0), w = w, h = h - bar)))
  Group(...items)
}

## ターミナル。行を上から順に出し、最後の行は 1 文字ずつ出る
## @category 枠
## @param lines 出す行
## @param revealed 出ている行数。小数なら最後の行がその割合だけ出る
## @param w 幅
## @param h 高さ
## @param rows 画面に入る行数 (既定 lines の数)
## @param back 背の色 (既定 ほぼ黒)
## @param ink 文字の色 (既定 薄い緑)
## @param font 文字の書体 (既定 そのときの既定の書体)
## @returns Group。左上が (0, 0) で w x h
## @example
## comp.place("terminal", terminal(["$ mophila render a.moph", "done"], 1.5, 8, 3).copy(position = Vector(1, 1)), in = 0s, out = comp.duration)
export func terminal(lines: List<String>, revealed: Number, w: Number, h: Number, rows: Number = 0, back: Color = #14161a, ink: Color = #9fe0a0, font: String = "") -> Group {
  let n = if rows > 0 { rows } else { math.max(lines.len(), 1) }
  let pad = h * 0.06
  let line_h = (h - pad * 2) / n
  let size = line_h * 0.62
  let full = math.floor(revealed)
  let items = [Rect(anchor = Vector(0, 0), w = w, h = h, radius = h * 0.04, fill = back)]
  for (i, line) in lines.enumerate() {
    if i >= n { break }
    let k = if i < full { 1 } else if i == full { math.clamp(revealed - full, 0, 1) } else { 0 }
    if k > 0 {
      # 1 行ずつ、その幅の k の割合だけ見せる
      let t = TextArea(text = line, fontSize = size, fill = ink)
      let styled = if font != "" { t.copy(font = font) } else { t }
      let tw = math.max(styled.size().x, 0.0001)
      items.push(Group(text_at(styled, 0, line_h / 2, 0, 0.5), position = Vector(pad, pad + line_h * i), clip = Rect(anchor = Vector(0, 0), w = tw * k, h = line_h)))
    }
  }
  Group(...items)
}

## 吹き出しの会話。古い方から順に出る
## @category 枠
## @param messages (:left か :right, 文) の並び
## @param revealed 出ている数
## @param w 幅
## @param h 高さ
## @param left 左の吹き出しの色 (既定 白)
## @param right 右の吹き出しの色 (既定 青)
## @returns Group。左上が (0, 0) で w x h
## @example
## comp.place("chat", chat([(:left, "やあ"), (:right, "どうも")], 2, 6, 4).copy(position = Vector(1, 1)), in = 0s, out = comp.duration)
export func chat(messages: List<Tuple>, revealed: Number, w: Number, h: Number, left: Color = #ffffff, right: Color = #4080e0) -> Group {
  let n = math.clamp(math.floor(revealed), 0, messages.len())
  if n == 0 { return Group() }
  let gap = h * 0.04
  let row = (h - gap) / messages.len()
  let size = row * 0.3
  let max_w = w * 0.68
  # 下に揃えて、古いものが上に残る
  let top = h - row * n
  let items = []
  for i in 0..n {
    let (side, body) = messages[i]
    let fill = if side == :right { right } else { left }
    let ts = TextArea(text = body, fontSize = size, w = max_w - size * 1.2).size()
    let bw = math.min(ts.x + size * 1.2, max_w)
    let bh = ts.y + size * 0.8
    let x = if side == :right { w - bw } else { 0 }
    let y = top + row * i + (row - bh) / 2
    items.push(Rect(position = Vector(x, y), anchor = Vector(0, 0), w = bw, h = bh, radius = bh * 0.3, fill = fill))
    items.push(TextArea(position = Vector(x + bw / 2, y + bh / 2), text = body, fontSize = size, w = bw - size * 1.2, fill = contrast(fill), align = :center))
  }
  Group(...items)
}

## 通知のバブル。progress が 0 のときは上に隠れている
## @category 部品
## @param message 出す文
## @param w 幅
## @param h 高さ
## @param progress 出ている割合 0..1 (既定 1)。0 に近いほど上にあって薄い
## @param fill 背の色 (既定 ほぼ黒)
## @param accent 左の丸の色 (既定 緑)
## @returns Group。progress が 1 のとき、左上が (0, 0) で w x h。0 以下なら空の Group
## @example
## comp.place("toast", toast("保存しました", 5, 1, progress = 0.5).copy(position = Vector(1, 1)), in = 0s, out = comp.duration)
export func toast(message: String, w: Number, h: Number, progress: Number = 1, fill: Color = #1a1d23, accent: Color = #4aa863) -> Group {
  let k = math.clamp(progress, 0, 1)
  if k <= 0 { return Group() }
  # 中身をまとめて 1 枚にして、上から降ろしながら濃くする
  Group(
    Rect(anchor = Vector(0, 0), w = w, h = h, radius = h * 0.28, fill = fill),
    Circle(position = Vector(h * 0.5, h / 2), radius = h * 0.16, fill = accent),
    text_at(TextArea(text = message, fontSize = h * 0.34, fill = contrast(fill)), h * 0.85, h / 2, 0, 0.5),
    position = Vector(0, -h * (1 - k)),
    opacity = k
  )
}

## 疑似マウスカーソル。at が先端
## @category 部品
## @param at 先端の位置
## @param size 縦の長さ (既定 0.5)
## @param fill 中の色 (既定 白)
## @param edge 縁の色 (既定 ほぼ黒)
## @returns Polygon
## @example
## comp.place("cursor", cursor(Vector(4, 2)), in = 0s, out = comp.duration)
export func cursor(at: Vector, size: Number = 0.5, fill: Color = #ffffff, edge: Color = #1a1d23) -> Polygon {
  let s = size
  Polygon(points = [
    at,
    at + Vector(0, s),
    at + Vector(s * 0.22, s * 0.78),
    at + Vector(s * 0.38, s * 1.1),
    at + Vector(s * 0.5, s * 1.04),
    at + Vector(s * 0.34, s * 0.73),
    at + Vector(s * 0.6, s * 0.7),
  ], fill = fill, stroke = edge, strokeWidth = s * 0.06)
}

## キーの絵。押されているキーだけ色を変える
## @category 部品
## @param keys キーに書く文字の並び
## @param w 幅
## @param h 高さ
## @param pressed 押されているキーの番号 (-1 でどれも押さない。既定 -1)
## @param fill キーの色 (既定 白)
## @param accent 押されたキーの色 (既定 赤)
## @returns Group。左上が (0, 0) で w x h
## @example
## comp.place("keys", key_press(["⌘", "S"], 3, 1, 1).copy(position = Vector(1, 1)), in = 0s, out = comp.duration)
export func key_press(keys: List<String>, w: Number, h: Number, pressed: Number = -1, fill: Color = #ffffff, accent: Color = #e04040) -> Group {
  let n = math.max(keys.len(), 1)
  let gap = h * 0.12
  let kw = (w - gap * (n - 1)) / n
  let items = []
  for (i, key) in keys.enumerate() {
    let down = i == pressed
    let x = (kw + gap) * i
    let drop = if down { h * 0.04 } else { 0 }
    let face = if down { accent } else { fill }
    items.push(Rect(position = Vector(x, h * 0.08), anchor = Vector(0, 0), w = kw, h = h * 0.92, radius = h * 0.16, fill = gray(160)))
    items.push(Rect(position = Vector(x, drop), anchor = Vector(0, 0), w = kw, h = h * 0.86, radius = h * 0.16, fill = face))
    items.push(TextArea(position = Vector(x + kw / 2, drop + h * 0.43), text = key, fontSize = h * 0.4, fill = contrast(face), align = :center))
  }
  Group(...items)
}

## SNS の投稿
## @category 枠
## @param author 名前
## @param body 本文
## @param likes いいねの数
## @param w 幅
## @param h 高さ
## @param fill 背の色 (既定 白)
## @param avatar 丸い顔の色 (既定 青)
## @returns Group。左上が (0, 0) で w x h
## @example
## comp.place("post", social_post("だれか", "書いた", 12, 6, 3).copy(position = Vector(1, 1)), in = 0s, out = comp.duration)
export func social_post(author: String, body: String, likes: Number, w: Number, h: Number, fill: Color = #ffffff, avatar: Color = #4080e0) -> Group {
  let pad = h * 0.1
  let r = h * 0.11
  let ink = contrast(fill)
  Group(
    Rect(anchor = Vector(0, 0), w = w, h = h, radius = h * 0.06, fill = fill),
    Circle(position = Vector(pad + r, pad + r), radius = r, fill = avatar),
    text_at(TextArea(text = author, fontSize = r * 0.9, fill = ink), pad + r * 2.6, pad + r, 0, 0.5),
    text_at(TextArea(text = body, fontSize = r * 0.85, w = w - pad * 2, fill = ink), pad, pad + r * 2.6, 0, 0),
    Circle(position = Vector(pad + r * 0.5, h - pad - r * 0.5), radius = r * 0.5, fill = #e0506a),
    text_at(TextArea(text = "{}".format(math.floor(likes)), fontSize = r * 0.75, fill = alpha(ink, 0.6)), pad + r * 1.4, h - pad - r * 0.5, 0, 0.5)
  )
}

## ローディングの輪。angle で回す
## @category 部品
## @param angle 今の角度 (ラジアン。真上から時計回り)
## @param w 幅
## @param h 高さ
## @param sweep 輪のうち色が付く角度 (ラジアン。既定 1.5 * math.pi)
## @param color 輪の色 (既定 青)
## @param track 残りの色 (既定 薄い灰)
## @returns Group。左上が (0, 0) で w x h
## @example
## comp.place("spinner", spinner(t / 1s * math.tau, 1, 1).copy(position = Vector(1, 1)), in = 0s, out = comp.duration)
export func spinner(angle: Number, w: Number, h: Number, sweep: Number = 1.5 * math.pi, color: Color = #4080e0, track: Color = #e6e2da) -> Group {
  let cx = w / 2
  let cy = h / 2
  let r_out = math.min(w, h) / 2
  let r_in = r_out * 0.74
  Group(
    Polygon(points = ring_segment(cx, cy, r_in, r_out, 0, math.tau, 48), fill = track),
    Polygon(points = ring_segment(cx, cy, r_in, r_out, angle, angle + sweep, 48), fill = color)
  )
}
