# shape.moph — Polygon の points と、円周上の点を作る。角度は度で、0 が真上、時計回り

import math

# 10 桁で丸める (0 のところに 0.00000000000000006 が出ないように)
let scale = 10000000000
func tidy(x: Number) -> Number { math.floor(x * scale + 0.5) / scale }

## 中心から距離 r、角度 degrees の点。0 が真上で、時計回り
## @category 位置
## @param cx 中心の x
## @param cy 中心の y
## @param r 中心からの距離
## @param degrees 角度 (度)
## @example
## # 中心 (8, 4.5) から半径 3、真上から時計回りに 30 度の点
## let p = polar(8, 4.5, 3, 30)
export func polar(cx: Number, cy: Number, r: Number, degrees: Number) -> Vector {
  let a = (degrees - 90) * math.PI / 180
  Vector(tidy(cx + r * math.cos(a)), tidy(cy + r * math.sin(a)))
}

## 正多角形の頂点
## @category 多角形
## @param cx 中心の x
## @param cy 中心の y
## @param r 中心から頂点までの距離
## @param n 頂点の数 (3 以上)
## @param rotation 時計回りの回転 (度。既定 0 で最初の頂点が真上)
## @returns Polygon(points = ...) に入れる
## @example
## # 正六角形
## Polygon(points = regular_polygon(8, 4.5, 2, 6), fill = #3f9b6d)
export func regular_polygon(cx: Number, cy: Number, r: Number, n: Number, rotation: Number = 0) -> List<Vector> {
  (0..n).to_list().map(func (i) { polar(cx, cy, r, rotation + i * 360 / n) })
}

## 星の頂点。外側と内側の半径を交互に
## @category 多角形
## @param cx 中心の x
## @param cy 中心の y
## @param outer 外側の半径 (とがった先)
## @param inner 内側の半径 (くぼみ)
## @param n とがった先の数 (既定 5)
## @param rotation 時計回りの回転 (度。既定 0 で最初の先が真上)
## @example
## # 5 つの先を持つ星
## Polygon(points = star(8, 4.5, 2, 0.9), fill = #e0a53a)
export func star(cx: Number, cy: Number, outer: Number, inner: Number, n: Number = 5, rotation: Number = 0) -> List<Vector> {
  (0..(n * 2)).to_list().map(func (i) {
    let r = if i % 2 == 0 { outer } else { inner }
    polar(cx, cy, r, rotation + i * 180 / n)
  })
}

## 矢印の輪郭 (7 点)。from から to へ向く
## @category 矢印
## @param from 始点 (Vector)
## @param to 終点 (Vector。矢じりの先)
## @param width 軸の太さ
## @param head 矢じりの長さ
## @param head_width 矢じりの幅 (既定は width の 3 倍)
## @example
## Polygon(points = arrow(Vector(2, 4.5), Vector(10, 4.5), 0.2, 0.6), fill = #303030)
export func arrow(from: Vector, to: Vector, width: Number, head: Number, head_width: Number = 0) -> List<Vector> {
  let hw = if head_width == 0 { width * 3 } else { head_width }
  let d = to - from
  let len = math.sqrt(d.x * d.x + d.y * d.y)
  let u = d / len
  let n = Vector(-u.y, u.x)
  let neck = to - u * head
  [
    from + n * (width / 2),
    neck + n * (width / 2),
    neck + n * (hw / 2),
    to,
    neck - n * (hw / 2),
    neck - n * (width / 2),
    from - n * (width / 2),
  ]
}

## 円弧の上の点。Path の segments か Polygon の points に入れる
## @category 円
## @param cx 中心の x
## @param cy 中心の y
## @param r 半径
## @param from 始まりの角度 (度。0 が真上、時計回り)
## @param to 終わりの角度
## @param steps 分割数 (既定 32)
## @example
## Path(from = arc(4, 2, 1.5, 0, 90)[0], segments = arc(4, 2, 1.5, 0, 90).map(func (p) { (:line, p) }))
export func arc(cx: Number, cy: Number, r: Number, from: Number, to: Number, steps: Number = 32) -> List<Vector> {
  (0..=1).steps(steps).map(func (k) { polar(cx, cy, r, from + (to - from) * k) })
}

## ドーナツの一片。円グラフの 1 切れになる
## @category 円
## @param cx 中心の x
## @param cy 中心の y
## @param r_in 内側の半径 (0 なら扇形)
## @param r_out 外側の半径
## @param from 始まりの角度 (度。0 が真上、時計回り)
## @param to 終わりの角度
## @param steps 分割数 (既定 32)
## @returns Polygon(points = ...) に入れる
## @example
## Polygon(points = ring_segment(4, 2, 0.8, 1.5, 0, 120), fill = #e04040)
export func ring_segment(cx: Number, cy: Number, r_in: Number, r_out: Number, from: Number, to: Number, steps: Number = 32) -> List<Vector> {
  let outer = arc(cx, cy, r_out, from, to, steps)
  let inner = arc(cx, cy, r_in, to, from, steps)
  if r_in <= 0 { return outer + [Vector(cx, cy)] }
  outer + inner
}

## 波線の点
## @category 線
## @param from 始点
## @param to 終点
## @param amplitude 振れ幅 (線に直角な方向)
## @param cycles 山の数
## @param steps 分割数 (既定 64)
## @example
## Path(from = Vector(0, 2), segments = wave(Vector(0, 2), Vector(8, 2), 0.5, 3).map(func (p) { (:line, p) }))
export func wave(from: Vector, to: Vector, amplitude: Number, cycles: Number, steps: Number = 64) -> List<Vector> {
  let d = to - from
  let len = math.hypot(d.x, d.y)
  if len == 0 { return [from] }
  let nx = -d.y / len
  let ny = d.x / len
  (0..=1).steps(steps).map(func (k) {
    let s = math.sin(k * cycles * math.TAU) * amplitude
    from + d * k + Vector(nx * s, ny * s)
  })
}

## 方眼の線。Path を 1 本ずつ引くための、始点と終点の組
## @category 線
## @param x 左上の x
## @param y 左上の y
## @param w 幅
## @param h 高さ
## @param step 目の間隔
## @returns (始点, 終点) の List
## @example
## for (a, b) in grid_lines(0, 0, 16, 9, 1) {
##   v.place(Line(from = a, to = b, stroke = #e0e0e0, strokeWidth = 0.02))
## }
export func grid_lines(x: Number, y: Number, w: Number, h: Number, step: Number) -> List<Tuple> {
  let lines = []
  let at = x
  for i in 0..=math.floor(w / step) {
    let gx = x + i * step
    lines.push((Vector(gx, y), Vector(gx, y + h)))
  }
  for i in 0..=math.floor(h / step) {
    let gy = y + i * step
    lines.push((Vector(x, gy), Vector(x + w, gy)))
  }
  lines
}

## 点の並びを Path の segments にする
## @category 線
## @param points 2 点以上
## @returns (:line, 点) の List。先頭は from に使う
## @example
## let pts = wave(Vector(0, 2), Vector(8, 2), 0.5, 3)
## Path(from = pts[0], segments = to_segments(pts))
export func to_segments(points: List<Vector>) -> List<Tuple> {
  points[1..points.len()].map(func (p) { (:line, p) })
}

## 等角投影。3 次元の点を平面に落とす。x は右下、y は左下、z は上へ伸びる
## @category 立体
## @param x 奥行き方向 1 (右下へ)
## @param y 奥行き方向 2 (左下へ)
## @param z 高さ (上へ)
## @param unit 1 単位の長さ (既定 1)
## @returns 平面の点。置く View の座標に足して使う
## @example
## let p = Vector(8, 6) + iso(1, 0, 2, 0.6)
export func iso(x: Number, y: Number, z: Number, unit: Number = 1) -> Vector {
  Vector((x - y) * 0.86602540378 * unit, ((x + y) * 0.5 - z) * unit)
}

## 等角投影での手前らしさ。大きいほど手前。zIndex に入れれば重なり順が決まる
## @category 立体
## @param x 奥行き方向 1
## @param y 奥行き方向 2
## @param z 高さ
## @returns Number
## @example
## v.place(Polygon(points = pts, fill = #4080e0, zIndex = iso_depth(x, y, z)))
export func iso_depth(x: Number, y: Number, z: Number) -> Number { x + y + z }

## 直方体の、見える 3 面。奥から手前の順に並ぶ
## @category 立体
## @param at 平面での原点 (x = y = z = 0 の点)
## @param x 角の x
## @param y 角の y
## @param z 角の z
## @param w x 方向の大きさ
## @param d y 方向の大きさ
## @param h 高さ
## @param unit 1 単位の長さ (既定 1)
## @returns (面の名前, 点の並び) の List。名前は :left :right :top
## @example
## for (face, pts) in iso_faces(Vector(8, 6), 0, 0, 0, 1, 1, 1, 0.8) {
##   v.place(Polygon(points = pts, fill = if face == :top { #8fb8e8 } else { #4080e0 }))
## }
export func iso_faces(at: Vector, x: Number, y: Number, z: Number, w: Number, d: Number, h: Number, unit: Number = 1) -> List<Tuple> {
  let p = func (px: Number, py: Number, pz: Number) -> Vector { at + iso(px, py, pz, unit) }
  let x1 = x + w
  let y1 = y + d
  let z1 = z + h
  [
    (:left, [p(x, y1, z), p(x1, y1, z), p(x1, y1, z1), p(x, y1, z1)]),
    (:right, [p(x1, y, z), p(x1, y1, z), p(x1, y1, z1), p(x1, y, z1)]),
    (:top, [p(x, y, z1), p(x1, y, z1), p(x1, y1, z1), p(x, y1, z1)]),
  ]
}

## 点の並びを、長さが等間隔になるように取り直す。
## 角の点しか返さない star や regular_polygon の輪郭を、フーリエ変換のように
## 等間隔の点として扱いたいときに使う
## @category 多角形
## @param points 元の点の並び (2 点以上)
## @param n 取り直したあとの点の数 (1 以上)
## @param closed true なら最後の点から最初の点へ戻る辺も含める
## @returns 長さが等間隔に並んだ点の List (n 個)
## @example
## # 星の輪郭を 256 個の等間隔の点にする
## let pts = resample(star(8, 4.5, 3, 1.2), 256, closed = true)
export func resample(points: List<Vector>, n: Number, closed: Bool = false) -> List<Vector> {
  if points.len() < 2 or n < 1 { return points }
  # 辺の長さと、そこまでの累計
  let ends = if closed { points + [points[0]] } else { points }
  let steps = ends.len() - 1
  let acc = [0]
  for i in 0..steps {
    let d = ends[i + 1] - ends[i]
    acc.push(acc[i] + math.hypot(d.x, d.y))
  }
  let total = acc[steps]
  if total <= 0 { return points }
  # 閉じているときは最後の点が最初の点と同じになるので、1 つ手前で止める
  let span = if closed { total * (n - 1) / n } else { total }
  let out = []
  let at = 0
  for k in 0..n {
    let want = if n == 1 { 0 } else { span * k / (n - 1) }
    # 目標の長さを含む辺まで進む (want は増えていくので、前の続きから探す)
    for j in 0..steps { if at + 1 < steps and acc[at + 1] < want { at = at + 1 } }
    let seg = acc[at + 1] - acc[at]
    let u = if seg > 0 { (want - acc[at]) / seg } else { 0 }
    out.push(ends[at] + (ends[at + 1] - ends[at]) * u)
  }
  out
}
