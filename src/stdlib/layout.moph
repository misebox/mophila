# layout.moph — 並べる位置を計算する。座標は箱の座標

## 格子の各マスの中心。左上 (x, y) から幅 w、高さ h を cols 列 rows 行に分け、左上から行ごとに
## @category 並べる
## @param x 左上の x
## @param y 左上の y
## @param w 全体の幅
## @param h 全体の高さ
## @param cols 列の数
## @param rows 行の数
## @returns cols * rows 個
## @example
## # 画面全体を 4 列 3 行に分け、各マスの中心に円を置く
## for p in grid_centers(0, 0, 16, 9, 4, 3) {
##   v.place(Circle(position = Pos(p), radius = 0.4, fill = #4080e0))
## }
export func grid_centers(x: Number, y: Number, w: Number, h: Number, cols: Number, rows: Number) -> List<Vector> {
  let cw = w / cols
  let ch = h / rows
  let cells = []
  for r in 0..rows {
    for c in 0..cols {
      cells.push(Vector(x + cw * (c + 0.5), y + ch * (r + 0.5)))
    }
  }
  cells
}

## 格子の 1 マスの大きさ
## @category 並べる
## @param w 全体の幅
## @param h 全体の高さ
## @param cols 列の数
## @param rows 行の数
## @returns 幅と高さ
## @example
## let size = cell(16, 9, 4, 3)   # Vector(4, 3)
export func cell(w: Number, h: Number, cols: Number, rows: Number) -> Vector { Vector(w / cols, h / rows) }

## from から to まで、両端を含めて n 個の点
## @category 並べる
## @param from 始点 (Vector)
## @param to 終点 (Vector)
## @param n 点の数 (2 以上)
## @example
## # 横一列に 5 個
## for p in along(Vector(2, 4.5), Vector(14, 4.5), 5) {
##   v.place(Circle(position = Pos(p), radius = 0.3, fill = #303030))
## }
export func along(from: Vector, to: Vector, n: Number) -> List<Vector> {
  (0..=1).steps(n - 1).map(func (k) { from + (to - from) * k })
}

## 幅 w、高さ h のものを、比率を保って box_w x box_h に収めたときの大きさ
## @category 収める
## @param w 元の幅
## @param h 元の高さ
## @param box_w 収める幅
## @param box_h 収める高さ
## @returns 幅と高さ
## @example
## let size = fit(1920, 1080, 16, 9)   # Vector(16, 9)
export func fit(w: Number, h: Number, box_w: Number, box_h: Number) -> Vector {
  let k = if box_w / w < box_h / h { box_w / w } else { box_h / h }
  Vector(w * k, h * k)
}

## 内側に余白を取った箱。(左上, 幅, 高さ) を返す
## @category 収める
## @param x 左上の x
## @param y 左上の y
## @param w 幅
## @param h 高さ
## @param pad 余白
## @returns (Vector, 幅, 高さ)
## @example
## let (at, w, h) = inset(0, 0, 16, 9, 0.8)
export func inset(x: Number, y: Number, w: Number, h: Number, pad: Number) -> Tuple {
  (Vector(x + pad, y + pad), w - pad * 2, h - pad * 2)
}

## 横一列に n 個並べたときの、各マスの左上と幅
## @category 並べる
## @param x 左上の x
## @param y 左上の y
## @param w 全体の幅
## @param n 個数
## @param gap 間の空き (既定 0)
## @returns (Vector, 幅) の List
## @example
## for (at, cw) in row(0, 0, 16, 4, 0.2) { ... }
export func row(x: Number, y: Number, w: Number, n: Number, gap: Number = 0) -> List<Tuple> {
  let cw = (w - gap * (n - 1)) / n
  (0..n).to_list().map(func (i) { (Vector(x + i * (cw + gap), y), cw) })
}

## 縦一列に n 個並べたときの、各マスの左上と高さ
## @category 並べる
## @param x 左上の x
## @param y 左上の y
## @param h 全体の高さ
## @param n 個数
## @param gap 間の空き (既定 0)
## @returns (Vector, 高さ) の List
## @example
## for (at, ch) in column(0, 0, 9, 3, 0.2) { ... }
export func column(x: Number, y: Number, h: Number, n: Number, gap: Number = 0) -> List<Tuple> {
  let ch = (h - gap * (n - 1)) / n
  (0..n).to_list().map(func (i) { (Vector(x, y + i * (ch + gap)), ch) })
}

## 大きさの違うものを縦に積んだときの、各要素の左上
## @category 並べる
## @param x 左上の x
## @param y 左上の y
## @param heights それぞれの高さ
## @param gap 間の空き (既定 0)
## @example
## let tops = stack(1, 1, [0.8, 1.6, 0.8], 0.2)
export func stack(x: Number, y: Number, heights: List<Number>, gap: Number = 0) -> List<Vector> {
  let tops = []
  let at = y
  for h in heights {
    tops.push(Vector(x, at))
    at = at + h + gap
  }
  tops
}
