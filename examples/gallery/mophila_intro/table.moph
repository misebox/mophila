# table.moph — 時間 1: 時刻と値の表。間は補間され、渡す progress の速さで全体が伸び縮みする

import { W, H, ink, dim, accent, blue, review, dwell, longer } from .theme
import { text, heading, card, outline, loop_demo, scene, add, say, close } from .slides

# progress の表。どれだけの時間で往復するかは、呼ぶ側が決める
let go = progress [:x] {
  0:   0.6
  0.5: 3.4 :ease
  1:   0.6 :ease
}

# 同じ表を、違う長さで
func bouncer(color, life) {
  let b = Composition(box = Vector(4, 3), duration = life)
  b.place("bg", Rect(position = Vector(0, 0), anchor = Vector(0, 0), w = 4, h = 3, fill = #1b2130), in = 0s, out = life)
  b.place("ball", func (t) {
    Circle(position = Vector(go(t / life)[0], 1.5), radius = 0.35, fill = color)
  }, in = 0s, out = life)
  b
}

export func run(now) {
  log("table", now)
  let sc = scene()
  add(sc, [heading("時刻と値を、表に書く")], now)
  add(sc, card([
    "let go = progress [:x] {",
    "  0:   0.6",
    "  0.5: 3.4 :ease",
    "  1:   0.6 :ease",
    "}",
    "",
    "go(t / 2s)[0]      # 右上",
    "go(t / 4s)[0]      # 右下",
  ], 0.7, 1.8, 7.6, 0.28), now + 0.4s)
  let t1 = now + 0.5s
  let x0 = 9.4
  add(sc, [outline(x0 - 0.1, 1.5, 3.4, 2.6), outline(x0 - 0.1, 4.3, 3.4, 2.6), text("t / 2s", x0 + 3.6, 2.8, 0.3, dim, :left), text("t / 4s", x0 + 3.6, 5.6, 0.3, dim, :left)], t1)
  # ナレーションの長さを先に出し、その終わりまで往復させる
  let t = say(sc, "変化は、時刻と値の表で書きます。間は補間されます。", t1)
  t = say(sc, ":ease を付けた区間は、ゆっくり始まり、ゆっくり止まります。", t)
  t = say(sc, "時刻は 0 から 1 で書き、何秒で割るかを変えると、同じ表が伸び縮みします。", t)
  t = say(sc, "上は 2 秒、下は 4 秒で往復しています。", t)
  let end = longer(t, t1 + 22s)
  loop_demo(bouncer(accent, 2s), x0, 1.6, 3.2, t1, 2s, end)
  loop_demo(bouncer(blue, 4s), x0, 4.4, 3.2, t1, 4s, end)
  close(sc, end)
}
