# fractal.moph — エスケープタイム系フラクタルの部品。反復式・精度・色付けを関数で差し替える。
# escape_time(...) が Shader を返すので、図形の fill に入れて使う。
#   formula:   反復式 (MANDELBROT / BURNING_SHIP / multibrot(n) / julia(c))
#   coloring:  func (mu, z) -> Color。mu は滑らかな脱出回数 (集合の中は -1)、z は脱出時の値
#   center / span: 複素平面の中心と、最初に見える横幅。zoom: func (t) -> 倍率。max_steps: func (zoom) -> 反復の上限
#   duration: 書くと対数極座標の帯を使う。camera: 倍率をカメラから読む
#   top_left / size:  塗る図形が占める箱の座標 (既定は (0, 0) から 16 x 9)。y_up: true で虚軸を下向きにする (Burning Ship の慣習)

import math

# julia の定数。1 つの Vector か、時刻から Vector を返す関数
type JuliaConstant = Vector | (Number) -> Vector

# camera を受け取る口。Camera か、書かなかったときの :none
type MaybeCamera = Camera | Symbol

## エスケープタイム系フラクタルの Shader を作る。図形の fill に入れる。
##
## 倍率の決め方は 3 通り。`zoom` を書く / `zoom` と `duration` を書く / `camera` を渡す。
## `duration` を書くと、動画ぜんぶを対数極座標の帯 1 本にして使い回す (中心が動かず、
## 倍率が増えるだけのときに使える。1 フレームあたりの計算が桁違いに減る)。
## `camera` を渡すと倍率はカメラから毎フレーム読む (寄る先も動かせる代わりに帯は使えない)。
## 精度は深さで決まるので選ばない。中の点の軌道をここで 64 bit で計算し、GPU は差分を反復する
## @category 描く
## @param formula 反復式 (MANDELBROT / julia(c) / BURNING_SHIP / multibrot(n))
## @param coloring 色付け。func (mu, z) -> Color (smooth_bands など)
## @param center 複素平面の中心 (Vector)
## @param span 最初に見える横幅 (複素平面の単位)
## @param zoom 倍率の時間変化。func (t) -> Number
## @param duration 動画の長さ。書くと帯を使う (倍率は増えるだけであること)
## @param camera 倍率と寄る先をここから読む。zoom と duration は書かない
## @param max_steps 反復の上限。func (zoom) -> Number
## @param samples 1 ピクセルあたりの評価点の数 (4 で 2x2 のアンチエイリアス)
## @param top_left 塗る図形の左上 (箱の座標)
## @param size 塗る図形の大きさ (箱の座標)
## @param y_up true で虚軸を下向きにする
## @param escape_at 脱出とみなす |z|² の閾値
## @param reference_steps 基準軌道の長さの上限
## @returns 図形の fill に入れる
## @example
## import { escape_time, MANDELBROT, smooth_bands } from fractal
##
## let set = escape_time(
##   formula = MANDELBROT,
##   coloring = smooth_bands([#061a3f, #5c9be6, #ffffff, #061a3f], 48),
##   center = Vector(-0.743, 0.126),
##   span = 0.02,
## )
## v.place(Rect(position = Pos(0, 0, anchor = :topLeft), w = 16, h = 9, fill = set))
export func escape_time(formula: Dict, coloring: (Number, Vector) -> Color, center: Vector, span: Number, zoom: (Number) -> Number = func (t) { 1 }, duration: Duration = 0s, camera: MaybeCamera = :none, max_steps: (Number) -> Number = func (zoom) { 200 }, samples: Number = 1, top_left: Vector = Vector(0, 0), size: Vector = Vector(16, 9), y_up: Bool = false, escape_at: Number = 256, reference_steps: Number = 8000) -> Shader {
  let seed = formula["seed"]
  let step = formula["step"]
  let start = formula["start"]
  let ln_degree = math.ln(formula["degree"])
  let param = if formula.has("param") { formula["param"] } else { func (t) { Vector(0, 0) } }
  let limit_of = max_steps
  let zoom_of = zoom
  let up = if y_up { 1 } else { -1 }
  let has_camera = type_of(camera) == "Camera"
  if has_camera and duration > 0s {
    log("escape_time: camera と duration は一緒に書けない (カメラは帯を使えない)")
  }
  if not formula.has("delta") {
    log("escape_time: this formula has no delta; it cannot be drawn")
  }
  let delta = formula["delta"]

  # 箱の座標 1 あたりの複素平面の長さ (倍率 1 のとき)
  let unit = span / size.x
  # 基準軌道を作る点。カメラがあれば、その寄る先の下にある複素点
  let focus = if has_camera { camera.from } else { Vector(top_left.x + size.x / 2, top_left.y + size.y / 2) }
  let origin = center + Vector((focus.x - top_left.x - size.x / 2) * unit, (focus.y - top_left.y - size.y / 2) * unit * up)
  # 滑らかな脱出回数
  func escaped(n: Number, r2: Number) -> Number { n + 1 - math.ln(math.ln(r2) / 2) / ln_degree }

  # 基準軌道 (origin の点の軌道) を 64 bit で。[re, im, re, im, ...]。脱出したらそこまで
  let k0 = param(0)
  func reference() -> List<Number> {
    let orbit = []
    let Z = seed(origin, k0)
    for n in 0..reference_steps {
      orbit.push(Z.x)
      orbit.push(Z.y)
      if abs_squared(Z) > escape_at { return orbit }
      Z = step(Z, origin, k0)
    }
    orbit
  }
  let orbit = reference()
  let ref_len = orbit.len() / 2

  # 帯を使う版。x は中心からの距離の対数、y は画面の上での角度
  if duration > 0s {
    let corner = math.sqrt(size.x * size.x + size.y * size.y) / 2
    func zoom_at(u: Number) -> Number { corner * unit / math.exp(u) }
    return Shader(samples = samples,
      args = orbit,
      zoom = ZoomPath(center = focus, zoom = zoom_of, duration = duration, unit = unit),
      color = func (u, th, t, ref) {
        let r = math.exp(u)
        let dp = Vector(r * math.cos(th), r * math.sin(th) * up)
        let limit = limit_of(zoom_at(u))
        let k = param(0)
        let d = start(dp)
        let m = 0
        for n in 0..limit {
          let Z = Vector(ref[2 * m], ref[2 * m + 1])
          let z = Z + d
          let r2 = abs_squared(z)
          if r2 > escape_at { return coloring(escaped(n, r2), z) }
          if r2 < abs_squared(d) or m + 1 >= ref_len {
            d = z
            m = 0
            Z = Vector(ref[0], ref[1])
          }
          d = delta(Z, d, dp, k)
          m = m + 1
        }
        coloring(-1, Vector(0, 0))
      })
  }

  # カメラを使う版。x y は既にカメラの寄る先からの差になっている
  if has_camera {
    return Shader(samples = samples,
      args = orbit,
      camera = camera,
      color = func (x, y, t, cam, ref) {
        let dp = Vector(x * unit, y * unit * up)
        let limit = limit_of(cam)
        let k = param(t)
        let d = start(dp)
        let m = 0
        for n in 0..limit {
          let Z = Vector(ref[2 * m], ref[2 * m + 1])
          let z = Z + d
          let r2 = abs_squared(z)
          if r2 > escape_at { return coloring(escaped(n, r2), z) }
          if r2 < abs_squared(d) or m + 1 >= ref_len {
            d = z
            m = 0
            Z = Vector(ref[0], ref[1])
          }
          d = delta(Z, d, dp, k)
          m = m + 1
        }
        coloring(-1, Vector(0, 0))
      })
  }

  # 毎フレーム全画素を計算する版
  Shader(samples = samples,
    args = orbit,
    color = func (x, y, t, ref) {
      let zm = zoom_of(t)
      let dp = Vector((x - top_left.x - size.x / 2) * unit / zm, (y - top_left.y - size.y / 2) * unit / zm * up)
      let limit = limit_of(zm)
      let k = param(t)
      let d = start(dp)
      let m = 0
      for n in 0..limit {
        let Z = Vector(ref[2 * m], ref[2 * m + 1])
        let z = Z + d
        let r2 = abs_squared(z)
        if r2 > escape_at { return coloring(escaped(n, r2), z) }
        # z が差分より小さくなったら、基準を先頭に戻して差分 = z から数え直す (基準が尽きたときも)
        if r2 < abs_squared(d) or m + 1 >= ref_len {
          d = z
          m = 0
          Z = Vector(ref[0], ref[1])
        }
        d = delta(Z, d, dp, k)
        m = m + 1
      }
      coloring(-1, Vector(0, 0))
    })
}
# Dict で表す。p はピクセルの複素座標、k は param(t) (Julia の c など)、Z は基準軌道、d は差分、dp は中心からの差
#   seed(p, k): 最初の z / step(z, p, k): 次の z / start(dp): 差分の初期値 / delta(Z, d, dp, k): 差分の次の値 / degree: 次数
## Mandelbrot 集合の反復式 z' = z² + p。z は 0 から始まり、p がピクセルの複素座標。
## escape_time の formula に渡す。摂動法にも対応している
## @category 反復式
## @type {Dict} 反復式
## @example
## escape_time(formula = MANDELBROT, coloring = coloring, center = Vector(-0.5, 0), span = 3)
export let MANDELBROT = {
  "seed": func (p, k) { Vector(0, 0) },
  "step": func (z, p, k) { complex_mul(z, z) + p },
  "start": func (dp) { Vector(0, 0) },
  "delta": func (Z, d, dp, k) { complex_mul(Z, d) * 2 + complex_mul(d, d) + dp },
  "degree": 2,
}

## Julia 集合の反復式 z' = z² + c を作る。z はピクセルの複素座標から始まり、c は全ピクセルで共通。
## escape_time の formula に渡す
## @category 反復式
## @param c 定数。Vector か、時刻から Vector を返す func (t)。摂動法は c が一定のときだけ正しい
## @returns 反復式
## @example
## # c を固定する
## escape_time(formula = julia(Vector(-0.8, 0.156)), coloring = coloring, center = Vector(0, 0), span = 3.6)
##
## # c を時刻で動かすと、形が移り変わる
## julia(func (t) { Vector(0.7885 * math.cos(t), 0.7885 * math.sin(t)) })
export func julia(c: JuliaConstant) -> Dict {
  let param = if type_of(c) == "Func" { c } else { func (t) { c } }
  {
    "seed": func (p, k) { p },
    "step": func (z, p, k) { complex_mul(z, z) + k },
    "start": func (dp) { dp },
    "delta": func (Z, d, dp, k) { complex_mul(Z, d) * 2 + complex_mul(d, d) },
    "degree": 2,
    "param": param,
  }
}

## Burning Ship の反復式 z' = (|Re z| + i|Im z|)² + p。実部と虚部の絶対値を取ってから 2 乗する。
## escape_time の formula に渡す。escape_time に y_up: true を付けると、慣習どおり船が上を向く
## @category 反復式
## @type {Dict} 反復式
## @example
## escape_time(formula = BURNING_SHIP, coloring = coloring, center = Vector(-1.75, -0.03), span = 0.2, y_up = true)
export let BURNING_SHIP = {
  "seed": func (p, k) { Vector(0, 0) },
  "step": func (z, p, k) {
    let a = Vector(math.abs(z.x), math.abs(z.y))
    complex_mul(a, a) + p
  },
  "start": func (dp) { Vector(0, 0) },
  "delta": func (Z, d, dp, k) {
    let a = Vector(math.abs(Z.x), math.abs(Z.y))
    let e = Vector(diffabs(Z.x, d.x), diffabs(Z.y, d.y))
    complex_mul(a, e) * 2 + complex_mul(e, e) + dp
  },
  "degree": 2,
}

## Multibrot の反復式 z' = z^n + p を作る。n が 2 なら Mandelbrot と同じで、大きいほど腕の数が増える。
## escape_time の formula に渡す
## @category 反復式
## @param n 次数。2 以上の整数
## @returns 反復式
## @example
## # 腕が 3 本
## escape_time(formula = multibrot(3), coloring = coloring, center = Vector(0, 0), span = 3)
export func multibrot(n: Number) -> Dict {
  {
    "seed": func (p, k) { Vector(0, 0) },
    "step": func (z, p, k) { cpow(z, n) + p },
    "start": func (dp) { Vector(0, 0) },
    "delta": func (Z, d, dp, k) {
      # (Z + d)^n - Z^n = Σ C(n, j) Z^(n-j) d^j  (j = 1..n)
      let sum = Vector(0, 0)
      for j in 1..=n { sum = sum + complex_mul(cpow(Z, n - j), cpow(d, j)) * binom(n, j) }
      sum + dp
    },
    "degree": n,
  }
}

## 脱出の速さから色を決める関数を作る。stops を period 回の反復ごとに 1 周する。
## escape_time の coloring に渡す
## @category 色付け
## @param stops Color の List。最初と最後を同じ色にすると継ぎ目が出ない
## @param period 何回の反復で 1 周するか
## @param inside 集合の中の色 (既定は黒)
## @returns 色付け
## @example
## # 48 回の反復で 1 周する色。最初と最後が同じ色なので継ぎ目が出ない
## let coloring = smooth_bands([#061a3f, #5c9be6, #ffffff, #061a3f], 48, inside = #061a3f)
export func smooth_bands(stops: List<Color>, period: Number, inside: Color = #000000) -> (Number, Vector) -> Color {
  let last = stops.len() - 1
  func (mu, z) {
    if mu < 0 { return inside }
    let p = (mu / period) % 1 * last
    let i = math.floor(p)
    let u = p - i
    stops[i] * (1 - u) + stops[i + 1] * u
  }
}

## 複素数の積。複素数は Vector (x が実部、y が虚部)
## @category 複素数
## @param a 複素数 (x が実部、y が虚部)
## @param b 複素数
## @returns 積
## @example
## complex_mul(Vector(0, 1), Vector(0, 1))   # Vector(-1, 0) — i × i = -1
export func complex_mul(a: Vector, b: Vector) -> Vector { Vector(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x) }
## 複素数の絶対値の 2 乗
## @category 複素数
## @param z 複素数
## @returns |z|²
## @example
## abs_squared(Vector(3, 4))   # 25
export func abs_squared(z: Vector) -> Number { z.x * z.x + z.y * z.y }
func cpow(z: Vector, n: Number) -> Vector {
  let r = Vector(1, 0)
  for i in 0..n { r = complex_mul(r, z) }
  r
}
# 二項係数 C(n, j)
func binom(n: Number, j: Number) -> Number {
  let r = 1
  for i in 0..j { r = r * (n - i) / (i + 1) }
  r
}
# |c + d| - |c| を桁落ちなしで
func diffabs(c: Number, d: Number) -> Number {
  if c >= 0 {
    if c + d >= 0 { return d }
    return -(2 * c + d)
  }
  if c + d <= 0 { return -d }
  2 * c + d
}
