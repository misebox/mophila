# materials.moph — 素材の見本。配色、模様、記号を 1 段ずつ並べる

import { HOUSE, PAPER, EARTH, MONO, NIGHT, NEON } from palette
import { stripes, hatch, checker, dots, grid, noise } from pattern
import { mark, CHECK, CROSS, PLUS, MINUS, ARROW, CHEVRON, PLAY, PAUSE, STOP, HEART, HOME, BOLT, PIN, SEARCH } from icon
import { stagger, fade_in, slide_in } from animation

# 画面そのものの色も配色から取る
let base = HOUSE
let v = View(box = Vector(16, 9))
v.place(Rect(position = Pos(0, 0, anchor = :topLeft), w = 16, h = 9, fill = base.back))

let track = Timeline(duration = 5s)
v.addTrack(track)

# 段の見出し
func heading(text: String, y: Number) -> TextArea {
  TextArea(position = Pos(0.6, y, anchor = :left), text = text, fontSize = 0.34, fill = base.sub, opacity = 0)
}
let heads = [heading("palette — 配色", 0.65), heading("pattern — 模様", 3.5), heading("icon — 記号", 6.3)]
for (i, head) in heads.enumerate() {
  v.place(head)
  track.place(fade_in(head, 0.4s), at = 0.1s + 1.2s * i)
}

# ---- palette。1 枚が 1 つの配色。上から 名前 (ink)、accent、series の 5 色 ----
let sets = [(HOUSE, "HOUSE"), (PAPER, "PAPER"), (EARTH, "EARTH"), (MONO, "MONO"), (NIGHT, "NIGHT"), (NEON, "NEON")]
let cards = []
for (i, set) in sets.enumerate() {
  let (p, name) = set
  let card = View(box = Vector(2.3, 2.1), opacity = 0)
  card.place(Rect(position = Pos(0, 0, anchor = :topLeft), w = 2.3, h = 2.1, fill = p.back))
  card.place(TextArea(position = Pos(1.15, 0.45), text = name, fontSize = 0.3, fill = p.ink))
  card.place(Rect(position = Pos(0.2, 0.78, anchor = :topLeft), w = 1.9, h = 0.34, fill = p.accent))
  for (j, c) in p.series.enumerate() {
    card.place(Rect(position = Pos(0.2 + j * 0.39, 1.3, anchor = :topLeft), w = 0.33, h = 0.55, fill = c))
  }
  card.place(Rect(position = Pos(0, 0, anchor = :topLeft), w = 2.3, h = 2.1, stroke = p.line, strokeWidth = 0.03))
  v.place(card, at = Pos(0.6 + i * 2.5, 1.0, anchor = :topLeft), w = 2.3)
  cards.push(card)
}
stagger(track, cards, func (c) { slide_in(c, 0, 0.4, 0.45s) }, at = 0.25s, stagger = 0.12s)

# ---- pattern。色はどれも同じにして、模様だけを変える ----
let fills = [
  (stripes(base.back, base.sub, 0.3, 60), "stripes"),
  (hatch(base.back, base.sub, 0.3, 0.035), "hatch"),
  (checker(base.back, base.sub, 0.28), "checker"),
  (dots(base.back, base.sub, 0.36, 0.09), "dots"),
  (grid(base.back, base.sub, 0.3, 0.025), "grid"),
  (noise(base.back, base.sub, 70), "noise"),
]
let tiles = []
for (i, item) in fills.enumerate() {
  let (fill, name) = item
  let tile = View(box = Vector(2.3, 2.05), opacity = 0)
  tile.place(Rect(position = Pos(0, 0, anchor = :topLeft), w = 2.3, h = 1.7, fill = fill))
  tile.place(Rect(position = Pos(0, 0, anchor = :topLeft), w = 2.3, h = 1.7, stroke = base.line, strokeWidth = 0.03))
  tile.place(TextArea(position = Pos(1.15, 1.9), text = name, fontSize = 0.26, fill = base.sub))
  v.place(tile, at = Pos(0.6 + i * 2.5, 3.85, anchor = :topLeft), w = 2.3)
  tiles.push(tile)
}
stagger(track, tiles, func (c) { slide_in(c, 0, 0.4, 0.45s) }, at = 1.45s, stagger = 0.12s)

# ---- icon。色も大きさも同じにして、形だけを変える ----
let signs = [
  (CHECK, "CHECK"), (CROSS, "CROSS"), (PLUS, "PLUS"), (MINUS, "MINUS"), (ARROW, "ARROW"),
  (CHEVRON, "CHEVRON"), (PLAY, "PLAY"), (PAUSE, "PAUSE"), (STOP, "STOP"), (HEART, "HEART"),
  (HOME, "HOME"), (BOLT, "BOLT"), (PIN, "PIN"), (SEARCH, "SEARCH"),
]
let step = 14.8 / signs.len()
let marks = []
for (i, item) in signs.enumerate() {
  let (sign, name) = item
  let cell = View(box = Vector(step, 1.5), opacity = 0)
  cell.place(mark(sign, Vector(step / 2, 0.55), 0.8, base.ink))
  cell.place(TextArea(position = Pos(step / 2, 1.24), text = name, fontSize = 0.19, fill = base.sub))
  v.place(cell, at = Pos(0.6 + i * step, 6.6, anchor = :topLeft), w = step)
  marks.push(cell)
}
stagger(track, marks, func (c) { fade_in(c, 0.35s) }, at = 2.65s, stagger = 0.07s)

output v
