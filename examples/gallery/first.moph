# first.moph — 丸が右へ動き、四角が横に広がり、文字が現れて、最後に消える

let len = 6.5s
let comp = Composition(box = Vector(16, 9), duration = len)
comp.place("bg", Rect(position = Vector(0, 0), anchor = Vector(0, 0), w = 16, h = 9, fill = #f4f1ea), in = 0s, out = len)

# 動かす 3 つは 1 つの Group にまとめる。まとめて薄くできる。
# 丸は 3 秒かけて右へ (加速して減速)、四角は 0.5 秒から 2 秒で横に広がり、文字は 3 秒から 1 秒で現れる。
# 文字が出そろう 4 秒から 1.5 秒見せて、最後の 1 秒で全体が消える
func stage(t) {
  Group(
    Circle(position = Vector(ease(t, 0s, 3s, 3, 13), 2.5), radius = 1, fill = #e0604a),
    Rect(position = Vector(2, 8), anchor = Vector(0, 2), w = ease_out(t, 0.5s, 2.5s, 0.5, 12), h = 2, fill = #3a6fb0),
    TextArea(text = "mophila", position = Vector(8, 5), fontSize = 1.2, fill = #222222, opacity = ease(t, 3s, 4s, 0, 1)),
    opacity = ease(t, 5.5s, 6.5s, 1, 0),
  )
}
comp.place("stage", stage, in = 0s, out = len)

output comp
